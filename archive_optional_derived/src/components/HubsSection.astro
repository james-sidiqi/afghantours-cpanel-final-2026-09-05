---
const hubs = [
  { slug: "kabul-city", name: "Kabul", province: "Kabul", region: "Central", access: "KBL International - Fully Active", purpose: "Primary Entry, Command Base, East/Central Transit", image: "/assets/images/heroes/hero-hubs.webp" },
  { slug: "bamyan-city", name: "Bamyan", province: "Bamyan", region: "Central", access: "Domestic Airfield / Ghorband Highway Route", purpose: "High-Altitude Trekking, Skiing, Archaeological Expeditions", image: "/assets/images/heroes/hero-home.webp" },
  { slug: "herat-city", name: "Herat", province: "Herat", region: "West", access: "HRT Domestic Airport / Highway 1 Route Aware", purpose: "Timurid Architecture Surveys, Silk Road Cultural Circuits", image: "/assets/images/heroes/hero-afghanistan.webp" },
  { slug: "kandahar-city", name: "Kandahar", province: "Kandahar", region: "South", access: "KDH Airport / South Highway Transit Vectors", purpose: "Durrani Empire Studies, Agrarian Outpost Access", image: "/assets/images/heroes/hero-hubs.webp" },
  { slug: "mazar-e-sharif", name: "Mazar-e-Sharif", province: "Balkh", region: "North", access: "MZR Airport / Active Uzbekistan Frontier Border Crossings", purpose: "Balkh Antiquities Exploration, Northern Plains Logistics", image: "/assets/images/heroes/hero-destinations.webp" },
  { slug: "faizabad", name: "Faizabad", province: "Badakhshan", region: "North", access: "Remote Domestic Airfield / Tactical Mountain Vectors", purpose: "Wakhan Corridor Launching, Hindu Kush Logistics, Noshaq Staging", image: "/assets/images/heroes/hero-tours.webp" },
  { slug: "jalalabad", name: "Jalalabad", province: "Nangarhar", region: "East", access: "Highway 1 Mountain Pass Routing Vectors", purpose: "Khyber Pass Border Access, Lowland Cultural Encounters", image: "/assets/images/heroes/hero-home.webp" }
];
---

<section id="hubs-travel-engine" class="relative bg-stone-900 py-24 overflow-hidden text-white transition-all duration-700 ease-in-out">
  
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-stone-950/80 backdrop-blur-sm z-10"></div>
    {hubs.map((hub, index) => (
      <img
        id={`hub-bg-${index}`}
        src={hub.image}
        alt=""
        class={`absolute inset-0 h-full w-full object-cover object-center transition-opacity duration-1000 ${index === 0 ? 'opacity-100' : 'opacity-0'}`}
      />
    ))}
  </div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-8 z-20">
    <div class="max-w-2xl mb-12">
      <p class="text-xs font-black uppercase tracking-[0.25em] text-amber-500">Infrastructure Anchors</p>
      <h2 class="mt-2 text-3xl font-black tracking-tight sm:text-5xl">Travel Hubs</h2>
      <p class="mt-4 text-stone-400 text-base">Start with the places that anchor real movement across Afghanistan.</p>
    </div>

    <div class="bg-zinc-950/90 border border-zinc-800 rounded-3xl p-8 mb-12 shadow-2xl">
      {hubs.map((hub, index) => (
        <div id={`hub-panel-${index}`} class={`grid gap-8 md:grid-cols-2 ${index === 0 ? 'block' : 'hidden'}`}>
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <span class="px-2.5 py-1 text-xs font-bold uppercase tracking-wider bg-amber-500/10 border border-amber-500/20 text-amber-500 rounded">
                {hub.region} Region
              </span>
              <span class="text-sm text-stone-400 font-semibold">{hub.province} Province</span>
            </div>
            <h3 class="text-4xl font-black text-white">{hub.name} Hub</h3>
            <p class="text-stone-300 text-sm leading-relaxed max-w-xl">{hub.purpose}</p>
          </div>
          
          <div class="flex flex-col justify-between border-t border-zinc-800 md:border-t-0 md:border-l md:pl-8 pt-6 md:pt-0 space-y-6">
            <div class="space-y-2">
              <h4 class="text-xs uppercase font-bold tracking-widest text-stone-400">Logistics & Access Realities</h4>
              <p class="text-sm text-emerald-400 font-medium flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
                {hub.access}
              </p>
            </div>
            <div class="flex flex-wrap gap-4">
              <a href={`/hubs/${hub.slug}`} class="inline-flex items-center justify-center px-5 py-2.5 text-xs font-black rounded-lg text-zinc-950 bg-white hover:bg-stone-200 transition-colors">
                Explore Hub
              </a>
              <a href={`/contact?hub=${hub.slug}`} class="inline-flex items-center justify-center px-5 py-2.5 text-xs font-black border border-zinc-700 text-white rounded-lg bg-zinc-900 hover:bg-zinc-800 transition-colors">
                Plan Route From This Hub
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="flex gap-4 overflow-x-auto pb-4 scrollbar-thin scrollbar-thumb-zinc-700 scrollbar-track-transparent snap-x">
      {hubs.map((hub, index) => (
        <button
          data-hub-index={index}
          class={`flex-none w-64 snap-start text-left p-5 rounded-2xl border transition-all duration-300 ${index === 0 ? 'bg-amber-500 border-amber-500 text-zinc-950 font-black' : 'bg-zinc-900/60 backdrop-blur border-zinc-800 hover:border-zinc-700 text-white'}`}
        >
          <p class={`text-[10px] uppercase tracking-widest font-bold ${index === 0 ? 'text-zinc-900/80' : 'text-stone-400'}`}>{hub.province}</p>
          <h4 class="text-lg font-black mt-1">{hub.name}</h4>
        </button>
      ))}
    </div>

  </div>
</section>

<script>
  const buttons = document.querySelectorAll('[data-hub-index]');
  
  buttons.forEach(button => {
    button.addEventListener('click', () => {
      const targetIndex = button.getAttribute('data-hub-index');
      if (!targetIndex) return;

      buttons.forEach(btn => {
        btn.classList.remove('bg-amber-500', 'border-amber-500', 'text-zinc-950', 'font-black');
        btn.classList.add('bg-zinc-900/60', 'backdrop-blur', 'border-zinc-800', 'text-white');
        const metaTag = btn.querySelector('p');
        if (metaTag) metaTag.className = 'text-[10px] uppercase tracking-widest font-bold text-stone-400';
      });

      button.classList.remove('bg-zinc-900/60', 'backdrop-blur', 'border-zinc-800', 'text-white');
      button.classList.add('bg-amber-500', 'border-amber-500', 'text-zinc-950', 'font-black');
      const activeMeta = button.querySelector('p');
      if (activeMeta) activeMeta.className = 'text-[10px] uppercase tracking-widest font-bold text-zinc-900/80';

      const totalHubs = buttons.length;
      for (let i = 0; i < totalHubs; i++) {
        const bg = document.getElementById(`hub-bg-${i}`);
        const panel = document.getElementById(`hub-panel-${i}`);
        
        if (i === parseInt(targetIndex)) {
          if (bg) bg.classList.replace('opacity-0', 'opacity-100');
          if (panel) panel.classList.replace('hidden', 'grid');
        } else {
          if (bg) bg.classList.replace('opacity-100', 'opacity-0');
          if (panel) panel.classList.replace('grid', 'hidden');
        }
      }
    });
  });
</script>
