---
interface Tour {
  slug: string;
  title: string;
  description?: string;
  duration_days?: number | string;
  style?: string;
  group_size?: string;
  activity_level?: string;
  season?: string;
  price?: string | number;
}

interface Props {
  tours: Tour[];
}

const { tours = [] } = Astro.props;
const tourHero = (tour: any) => tour.image || tour.hero_image || tour.hero_image_path || `/assets/images/tours/${tour.slug}/hero.webp`;
const tourOverview = (tour: any) => tour.overview_image || tour.overview_image_path || `/assets/images/tours/${tour.slug}/overview.webp`;
---

<section class="bg-zinc-950 py-28 text-white border-b border-zinc-900 relative">
  
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-black/55 z-10"></div>
    {tours.map((tour, index) => (
      <img
        id={`section-bg-${index}`}
        src={tourHero(tour)}
        alt=""
        class={`absolute inset-0 h-full w-full object-cover object-center transition-opacity duration-1000 ${index === 0 ? 'opacity-40' : 'opacity-0'}`}
      />
    ))}
  </div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8 relative z-10">
    
    <div class="max-w-3xl mb-16">
      <p class="text-xs font-bold uppercase tracking-[0.25em] text-[#D4A437]">
        Featured Tours
      </p>
      <h2 class="font-serif mt-4 text-4xl font-bold tracking-tight sm:text-6xl text-white">
        Curated Afghan Journeys
      </h2>
      <p class="mt-6 text-zinc-300 text-base leading-relaxed max-w-2xl font-light">
        Private journeys across one of the world’s most misunderstood destinations — designed with deep local knowledge, operational planning, and an emphasis on authentic cultural experience.
      </p>
    </div>

    <div class="w-full">
      {tours.map((tour, index) => (
        <div 
          id={`tour-panel-${index}`} 
          class={`bg-white border border-stone-200 rounded-3xl p-8 mb-12 shadow-2xl text-stone-950 ${index === 0 ? 'block' : 'hidden'}`}
        >
          <div class="grid gap-8 lg:grid-cols-12 items-start">
            
            <div class="lg:col-span-7 flex flex-col justify-start">
              
              <div id={`tour-title-group-${index}`}>
                <h3 class="font-serif text-4xl font-bold text-[#D4A437] tracking-wide sm:text-5xl leading-tight">
                  {tour.title}
                </h3>
                
                <p class="mt-4 text-stone-600 text-sm leading-relaxed max-w-xl font-normal line-clamp-2">
                  {tour.description || "Custom planned itineraries built around real route access, active season windows, and tactical security coordination variables on the ground."}
                </p>
              </div>
            </div>

            <div id={`tour-img-wrapper-${index}`} class="lg:col-span-5 image-align-target transition-all duration-300">
              <div class="relative h-72 rounded-2xl overflow-hidden shadow-lg border border-stone-100">
                <img 
                  src={tourHero(tour)} 
                  alt={tour.title} 
                  class="absolute inset-0 w-full h-full object-cover object-center"
                />
              </div>
            </div>

          </div>

          <div class="mt-8 pt-8 border-t border-stone-200 grid gap-8 lg:grid-cols-12 items-end">
            
            <div class="lg:col-span-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
              
              <div class="bg-stone-50 border border-stone-200/60 p-3 rounded-xl">
                <p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Duration</p>
                <p class="text-xs font-black text-stone-900 mt-1">{tour.duration_days || "7"} days</p>
              </div>

              <div class="bg-stone-50 border border-stone-200/60 p-3 rounded-xl">
                <p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Tour Style</p>
                <p class="text-xs font-black text-stone-900 mt-1 truncate">{tour.style || "Private Journey"}</p>
              </div>

              <div class="bg-stone-50 border border-stone-200/60 p-3 rounded-xl">
                <p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Group Size</p>
                <p class="text-xs font-black text-stone-900 mt-1 truncate">{tour.group_size || "Bespoke"}</p>
              </div>

              <div class="bg-stone-50 border border-stone-200/60 p-3 rounded-xl">
                <p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Activity</p>
                <p class="text-xs font-black text-stone-900 mt-1 truncate">{tour.activity_level || "Moderate"}</p>
              </div>

              <div class="bg-stone-50 border border-stone-200/60 p-3 rounded-xl">
                <p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Season</p>
                <p class="text-xs font-black text-stone-900 mt-1 truncate">{tour.season || "Year-Round"}</p>
              </div>

              <div class="bg-stone-50 border border-stone-200/60 p-3 rounded-xl">
                <p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Starting From</p>
                <p class="text-xs font-black text-stone-900 mt-1 truncate">
                  {tour.price ? (String(tour.price).startsWith('$') ? tour.price : `$${tour.price}`) : "$1250"}
                </p>
              </div>

            </div>

            <div class="lg:col-span-4 flex flex-wrap gap-3 justify-start lg:justify-end">
              <button 
                data-preview-slug={tour.slug}
                class="inline-flex items-center justify-center px-5 py-3 text-xs font-black uppercase tracking-wider rounded-xl text-stone-900 bg-stone-100 border border-stone-300 hover:bg-stone-200 transition-colors shadow-sm"
              >
                Preview Tour
              </button>
              <a 
                href={`/tours/${tour.slug}`} 
                class="inline-flex items-center justify-center px-5 py-3 text-xs font-black uppercase tracking-wider rounded-xl text-white bg-zinc-950 hover:bg-zinc-800 transition-colors shadow-sm"
              >
                Open Tour
              </a>
            </div>

          </div>

        </div>
      ))}
    </div>

    <div class="relative w-full overflow-hidden mt-16">
      <div class="flex gap-6 overflow-x-auto pb-4 scrollbar-thin scrollbar-thumb-zinc-800 scrollbar-track-transparent snap-x">
        {tours.map((item, index) => (
          
          <button
            data-tour-index={index}
            class={`flex-none w-80 h-52 snap-start rounded-2xl relative overflow-hidden text-left p-4 border transition-all duration-300 flex flex-col justify-between group ${index === 0 ? 'border-[#D4A437] ring-2 ring-[#D4A437]/20' : 'border-zinc-800 hover:border-zinc-700'}`}
          >
            <img 
              src={tourHero(item)} 
              alt="" 
              class="absolute inset-0 h-full w-full object-cover object-center z-0 transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-black/60 z-10"></div>
            
            <div class="relative z-20 flex justify-between items-center w-full">
              <span class="text-[10px] font-bold uppercase tracking-wider bg-zinc-950/80 px-2.5 py-1 rounded-md text-zinc-100 border border-zinc-800">
                {item.duration_days || "7"} Days
              </span>
              <span class="text-[10px] font-bold uppercase tracking-wider bg-[#D4A437]/10 px-2.5 py-1 rounded-md text-[#D4A437] border border-[#D4A437]/20">
                {item.season || "Year-Round"}
              </span>
            </div>

            <div class="relative z-20 w-full mt-auto space-y-1">
              <h4 class="font-serif text-base font-bold text-white line-clamp-1 tracking-wide leading-tight drop-shadow-md">
                {item.title}
              </h4>
              <div class="flex justify-between items-center text-[10px] uppercase tracking-wider text-zinc-400 font-medium">
                <span>{item.season || "Year-Round"}</span>
                <span class="text-[#D4A437] font-bold">
                  From {item.price ? (String(item.price).startsWith('$') ? item.price : `$${item.price}`) : "$1250"}
                </span>
              </div>
            </div>
          </button>
        ))}
      </div>
    </div>

  </div>
</section>

<script>
  // Dynamic Real-time Top Image Offset Alignment Function
  function alignHorizontalImages() {
    const panels = document.querySelectorAll('[id^="tour-panel-"]');
    panels.forEach((panel) => {
      if (panel.classList.contains('hidden')) return;
      
      const titleGroup = panel.querySelector('[id^="tour-title-group-"]');
      const imgWrapper = panel.querySelector('.image-align-target');
      
      if (titleGroup && imgWrapper && window.innerWidth >= 1024) {
        const titleBottom = titleGroup.getBoundingClientRect().bottom;
        const panelTop = panel.getBoundingClientRect().top;
        // Sets top of the image in line with bottom of the card title block text area container safely
        const targetOffset = (titleBottom - panelTop) - 32; 
        (imgWrapper as HTMLElement).style.paddingTop = `${targetOffset}px`;
      } else if (imgWrapper) {
        (imgWrapper as HTMLElement).style.paddingTop = '0px';
      }
    });
  }

  // Active Main Card Swapping Interface Control Logic
  const carouselButtons = document.querySelectorAll('[data-tour-index]');
  carouselButtons.forEach(button => {
    button.addEventListener('click', () => {
      const targetIndex = button.getAttribute('data-tour-index');
      if (!targetIndex) return;

      carouselButtons.forEach(btn => {
        btn.classList.remove('border-[#D4A437]', 'ring-2', 'ring-[#D4A437]/20');
        btn.classList.add('border-zinc-800');
      });

      button.classList.remove('border-zinc-800');
      button.classList.add('border-[#D4A437]', 'ring-2', 'ring-[#D4A437]/20');

      const totalPanels = carouselButtons.length;
      for (let i = 0; i < totalPanels; i++) {
        const panel = document.getElementById(`tour-panel-${i}`);
        const bg = document.getElementById(`section-bg-${i}`);
        
        if (i === parseInt(targetIndex)) {
          if (panel) panel.classList.replace('hidden', 'block');
          if (bg) bg.classList.replace('opacity-0', 'opacity-40');
        } else {
          if (panel) panel.classList.replace('block', 'hidden');
          if (bg) bg.classList.replace('opacity-40', 'opacity-0');
        }
      }
      alignHorizontalImages();
    });
  });

  // Preview Drawer Integration Trigger Interface
  const previewButtons = document.querySelectorAll('[data-preview-slug]');
  previewButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const slug = btn.getAttribute('data-preview-slug');
      if (!slug) return;
      
      // Dispatch custom tracking message straight to global index layout framework
      window.dispatchEvent(new CustomEvent('open-tour-preview', { detail: { slug } }));
    });
  });

  // Active responsive state listener hook updates
  window.addEventListener('resize', alignHorizontalImages);
  document.addEventListener('DOMContentLoaded', alignHorizontalImages);
  setTimeout(alignHorizontalImages, 150);
</script>
