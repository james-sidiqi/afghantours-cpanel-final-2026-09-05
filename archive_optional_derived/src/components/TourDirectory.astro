---
const { tours = [] } = Astro.props;
const img = (tour) => tour.hero_image || tour.hero_image_path || tour.thumbnail_image_path || '/assets/images/placeholders/default-tour.webp';
const seasons = [...new Set(tours.map((t) => t.season).filter(Boolean))];
const styles = [...new Set(tours.map((t) => t.travel_style).filter(Boolean))];
---
<section class="bg-[#fbf8f2] py-20 text-stone-950">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-9 flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.28em] text-amber-700">All Tours</p>
        <h2 class="editorial-title mt-3 text-4xl font-black md:text-6xl">Browse every route</h2>
      </div>
      <div class="flex flex-wrap gap-3 text-sm font-bold">
        <select data-tour-filter="season" class="rounded-full border border-stone-300 bg-white px-5 py-3"><option value="">All seasons</option>{seasons.map((s) => <option value={s}>{s}</option>)}</select>
        <select data-tour-filter="style" class="rounded-full border border-stone-300 bg-white px-5 py-3"><option value="">All types</option>{styles.map((s) => <option value={s}>{s}</option>)}</select>
      </div>
    </div>

    <div id="tour-directory-grid" class="grid gap-7 md:grid-cols-2 lg:grid-cols-3">
      {tours.map((tour) => (
        <a href={`/tours/${tour.slug}/`} data-season={tour.season || ''} data-style={tour.travel_style || ''} class="tour-directory-card group overflow-hidden rounded-[2rem] bg-white shadow-sm ring-1 ring-stone-200 transition hover:-translate-y-1 hover:shadow-xl">
          <img src={img(tour)} alt={tour.title || tour.name} class="h-64 w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" />
          <div class="p-6">
            <p class="text-xs font-black uppercase tracking-[0.2em] text-amber-700">{tour.season || tour.travel_style || 'Tour'}</p>
            <h3 class="editorial-title mt-2 text-2xl font-black text-stone-950">{tour.title || tour.name}</h3>
            <p class="mt-3 line-clamp-3 text-sm leading-6 text-stone-600">{tour.summary || tour.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
<script>
  const selects = document.querySelectorAll('[data-tour-filter]');
  const cards = document.querySelectorAll('.tour-directory-card');
  function applyTourFilters() {
    const season = document.querySelector('[data-tour-filter="season"]')?.value || '';
    const style = document.querySelector('[data-tour-filter="style"]')?.value || '';
    cards.forEach((card) => {
      const okSeason = !season || card.dataset.season === season;
      const okStyle = !style || card.dataset.style === style;
      card.style.display = okSeason && okStyle ? '' : 'none';
    });
  }
  selects.forEach((select) => select.addEventListener('change', applyTourFilters));
</script>
