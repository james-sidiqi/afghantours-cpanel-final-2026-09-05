---
import '../styles/global.css';
import '../styles/editorial.css';
import Header from './Header.astro';
import Footer from './Footer.astro';

const {
  title = 'Afghan Tours',
  description = 'Custom Afghanistan tours, logistics, cultural travel, and expedition planning by a licensed local operator.',
  image = '/assets/images/heroes/hero-home.webp',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://afghantours.com').toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <a class="floating-whatsapp" href="https://wa.me/93780123456" aria-label="Contact AfghanTours on WhatsApp">☘ <span>WhatsApp</span></a>
    <Footer />
  </body>
</html>
