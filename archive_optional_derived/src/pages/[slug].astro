---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { getPages, getPageContent } from '../lib/buildRelations';

export function getStaticPaths() {
  const reserved = new Set(['home', 'tours', 'attractions', 'destinations', 'food-culture', 'hotels']);
  return getPages().filter((page) => page?.slug && !reserved.has(String(page.slug))).map((page) => ({ params: { slug: page.slug } }));
}

const page = Astro.params.slug ? getPageContent(Astro.params.slug) : undefined;
if (!page) return Astro.redirect('/');
---
<BaseLayout title={`${page.title} | AfghanTours`} description={page.excerpt || page.description || ''}>
  <PageHero eyebrow="AfghanTours" title={page.title} text={page.summary || page.description || ''} image={page.hero_image || '/assets/images/heroes/hero-home.webp'} height="min-h-[54vh]" />
  <section class="bg-white py-16 text-stone-950">
    <div class="editorial-prose mx-auto max-w-4xl px-6" set:html={page.content_html || ''} />
  </section>
</BaseLayout>
