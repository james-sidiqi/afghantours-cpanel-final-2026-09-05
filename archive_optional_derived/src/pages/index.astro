---
// Import interactive components if needed, or define locally for bulletproof testing
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedTours from '../components/FeaturedTours.astro';

// Structural mock data matching your exact frontend configuration
const tours = [
  {
    slug: 'photography-tour',
    title: 'Photography Tour',
    description: 'A flexible visual journey for travelers who want to capture Afghanistan’s landscapes, architecture, markets, and people with practical field support.',
    duration_days: 12,
    style: 'Custom',
    group_size: 'Private / Small Group',
    activity_level: 'Leisurely',
    season: 'Year-round',
    price: '2850',
    highlights: ['Kabul street life', 'Bamyan landscapes', 'Historic architecture', 'Golden-hour field stops']
  },
  {
    slug: 'bamyan-skiing-tour',
    title: 'Bamyan Backcountry Skiing Tour',
    description: 'A winter expedition into Bamyan’s snow-covered central highlands with local ski support, flexible routing, and realistic mountain logistics.',
    duration_days: 5,
    style: 'Winter Adventure',
    group_size: 'Private / Small Group',
    activity_level: 'Active',
    season: 'Jan-Mar',
    price: '1890',
    highlights: ['Koh-e-Baba Range', 'Bamyan Valley', 'Backcountry skiing', 'Winter highlands']
  },
  {
    slug: 'buzkashi-expedition',
    title: 'Buzkashi Expedition',
    description: 'A cultural field journey built around Afghanistan’s most iconic traditional sport, northern horse culture, and regional heritage.',
    duration_days: 10,
    style: 'Cultural / Scenic',
    group_size: 'Private / Small Group',
    activity_level: 'Moderate',
    season: 'Dec-Mar',
    price: '2450',
    highlights: ['Buzkashi matches', 'Mazar-e-Sharif', 'Horse culture', 'Northern bazaars']
  },
  {
    slug: 'the-timurid-grandeur-of-herat',
    title: 'The Timurid Grandeur of Herat',
    description: 'A focused cultural route through Herat’s citadel, Friday Mosque, minarets, bazaars, and Timurid architectural heritage.',
    duration_days: 7,
    style: 'Cultural / Scenic',
    group_size: 'Private / Small Group',
    activity_level: 'Moderate',
    season: 'Year-round',
    price: '1950',
    highlights: ['Herat Citadel', 'Friday Mosque', 'Herat Minarets', 'Old City bazaars']
  }
];

const credibilityCards = [
  { title: 'Real Afghan Hospitality', desc: 'Hosted by people who live here and are proud to share Afghanistan beyond the headlines.' },
  { title: 'Kabul-Based Operations', desc: 'Journeys coordinated directly from Kabul through established local networks and real-time operational awareness.' },
  { title: 'Safety-Aware Planning', desc: 'Routes, timing, and accommodations selected around actual conditions and realistic movement planning.' },
  { title: 'Transparent Local Pricing', desc: 'Clear costs and realistic expectations before arrival — without inflated foreign operator markups.' },
  { title: 'Flexible Route Design', desc: 'Private itineraries built around your interests, comfort level, season, and available access.' },
  { title: 'Visa & Entry Guidance', desc: 'Assistance with invitation letters, entry coordination, and current travel procedures where appropriate.' },
  { title: 'Support for Serious Projects', desc: 'Fixers, media logistics, research coordination, interpreters, permits, and expedition support.' },
  { title: 'Comfort, Explained Honestly', desc: 'From guesthouses to higher-end hotels, we explain accommodations realistically and transparently.' },
  { title: 'Designed Beyond First Visits', desc: 'Many guests return for deeper regional experiences, seasonal travel, or specialized expeditions.' }
];
---

<BaseLayout
  title="AfghanTours | Serious Ground Access & Curated Journeys"
  description="Private journeys, cultural expeditions, filming support, and operationally realistic travel across Afghanistan."
  image="/assets/images/heroes/hero-home.webp"
>
  <style is:global>
    .font-serif { font-family: Georgia, 'Times New Roman', serif; }
    .font-sans { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
    .max-text-ch { max-width: 65ch; }
  </style>

  <div class="bg-[#050505] text-[#F5F5F5] font-sans antialiased overflow-x-hidden">
    <section class="relative min-h-[92vh] flex flex-col justify-between py-16 px-6 lg:px-8 border-b border-zinc-900 overflow-hidden">
          <div class="absolute inset-0 z-0">
            <div class="absolute inset-0 bg-black/60 z-10"></div>
            <img 
              src="/assets/images/heroes/hero-home.webp" 
              alt="Afghanistan Landscape" 
              class="w-full h-full object-cover object-center"
            />
          </div>

          <div class="relative z-20 w-full max-w-7xl mx-auto flex justify-between items-center">
            <span class="font-serif text-2xl font-bold tracking-widest text-[#D4A437]">AFGHAN TOURS</span>
            <span class="text-[10px] font-mono tracking-widest text-zinc-400 bg-black/50 px-3 py-1 rounded-full border border-white/5">KABUL HQ // FIELD OP ENGINE</span>
          </div>

          <div class="relative z-20 w-full max-w-7xl mx-auto my-auto pt-16">
            <h1 class="font-serif text-5xl sm:text-7xl lg:text-8xl font-bold tracking-tight text-white max-w-4xl leading-[1.05]">
              Afghanistan Through <br/>Local Knowledge & <span class="text-[#D4A437]">Real Access</span>
            </h1>
            <p class="mt-6 text-lg sm:text-xl text-[#D1D5DB] max-w-xl font-light leading-relaxed">
              Private journeys, cultural expeditions, filming support, and operationally realistic travel across Afghanistan.
            </p>
            <div class="mt-10 flex flex-wrap gap-4">
              <a href="#featured-section" class="px-6 py-3.5 text-xs font-black uppercase tracking-wider bg-[#D4A437] text-zinc-950 rounded-xl hover:bg-[#bfa030] transition-all">
                Explore Featured Tours
              </a>
              <a href="/custom-tours" class="px-6 py-3.5 text-xs font-black uppercase tracking-wider bg-zinc-900/80 text-white rounded-xl border border-zinc-800 hover:bg-zinc-800 transition-all">
                Custom Expeditions
              </a>
            </div>
          </div>

          <div class="relative z-20 w-full max-w-7xl mx-auto mt-auto pt-12">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              <div class="bg-slate-900/65 backdrop-blur-[14px] border border-white/5 p-6 rounded-[20px]">
                <h3 class="text-xs font-bold uppercase tracking-wider text-[#D4A437]">Western-led / Kabul-based</h3>
                <p class="mt-2 text-sm text-[#9CA3AF] font-normal">Operational support managed directly from Afghanistan.</p>
              </div>
              <div class="bg-slate-900/65 backdrop-blur-[14px] border border-white/5 p-6 rounded-[20px]">
                <h3 class="text-xs font-bold uppercase tracking-wider text-[#D4A437]">15+ years on the ground</h3>
                <p class="mt-2 text-sm text-[#9CA3AF] font-normal">Long-term operational experience across Afghanistan.</p>
              </div>
              <div class="bg-slate-900/65 backdrop-blur-[14px] border border-white/5 p-6 rounded-[20px]">
                <h3 class="text-xs font-bold uppercase tracking-wider text-[#D4A437]">Security-aware routing</h3>
                <p class="mt-2 text-sm text-[#9CA3AF] font-normal">Routes planned around real-world seasonal and operational conditions.</p>
              </div>
            </div>
          </div>
        </section>

        <section class="py-28 px-6 lg:px-8 bg-gradient-to-b from-[#0B0F14] to-[#050505] border-b border-zinc-900">
          <div class="max-w-7xl mx-auto">
            <div class="max-w-3xl mb-16">
              <span class="text-xs font-bold uppercase tracking-[0.25em] text-[#D4A437]">Licensed Kabul Operator & Ground Specialist</span>
              <h2 class="font-serif text-3xl sm:text-5xl font-bold tracking-tight text-white mt-4">
                Afghanistan travel built on real access and 15 years of ground operations
              </h2>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">
              <div class="space-y-6 text-[#D1D5DB] text-sm leading-relaxed max-text-ch font-light">
                <h4 class="text-white font-serif text-xl font-bold tracking-wide">Licensed Afghan Tour Operator</h4>
                <p>
                  <strong class="font-semibold text-white">AfghanTours.com</strong> is owned and operated by James Tourist & Travel Agency, a licensed Afghan tour operator permanently based in Kabul.
                </p>
                <p>
                  We combine traditional Afghan hospitality with route-aware, operationally realistic logistics to design private journeys supported directly from the ground up.
                </p>
                <p>
                  Our approach is built around current local conditions, practical movement planning, trusted regional relationships, and firsthand operational experience developed across Afghanistan over more than a decade.
                </p>
              </div>

              <div class="space-y-6 text-[#D1D5DB] text-sm leading-relaxed max-text-ch font-light">
                <h4 class="text-white font-serif text-xl font-bold tracking-wide">American-Led, Kabul-Based Operations</h4>
                <p>
                  Unlike agencies coordinating Afghanistan travel remotely from abroad, AfghanTours is led by an American citizen with more than 15 years of continuous experience living and working inside Afghanistan.
                </p>
                <p>
                  Our team supports private journeys, field expeditions, media logistics, filming projects, business visits, and specialized travel requiring detailed coordination and local access.
                </p>
                <p>
                  Through long-established local networks, we assist with transportation planning, permits, accommodations, checkpoint coordination, interpreters, and project-specific operational support tailored to each itinerary.
                </p>
                <div class="pt-4">
                  <a href="/about" class="inline-flex items-center text-xs font-black uppercase tracking-wider text-[#D4A437] hover:text-white transition-colors">
                    Learn More About Us <span class="ml-2">&rarr;</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="py-28 px-6 lg:px-8 bg-[#111827]/20 border-b border-zinc-900">
          <div class="max-w-7xl mx-auto">
            <div class="max-w-3xl mb-16">
              <span class="text-xs font-bold uppercase tracking-[0.25em] text-[#D4A437]">Verification Framework</span>
              <h2 class="font-serif text-3xl sm:text-5xl font-bold tracking-tight text-white mt-4">Operational Credibility</h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {credibilityCards.map((card) => (
                <div class="bg-gradient-to-br from-[#111827]/95 to-[#0B0F14]/95 border border-[#D4A437]/10 rounded-[22px] p-8 min-h-[180px] hover:-translate-y-1 transition-all duration-300 group">
                  <h3 class="font-serif text-xl font-bold text-white tracking-wide group-hover:text-[#D4A437] transition-colors">{card.title}</h3>
                  <p class="mt-3 text-sm text-[#9CA3AF] font-light leading-relaxed">{card.desc}</p>
                </div>
              ))}
            </div>
          </div>
        </section>

        <div id="featured-section">
          <FeaturedTours tours={tours} />
        </div>

        <div id="preview-drawer" class="fixed inset-y-0 right-0 z-50 w-full max-w-[540px] bg-white text-zinc-900 shadow-2xl transform translate-x-full transition-transform duration-500 ease-out flex flex-col">
          <div class="relative h-64 bg-zinc-900 flex-shrink-0">
            <button id="close-drawer" class="absolute top-4 right-4 z-20 bg-black/60 text-white rounded-full p-2 hover:bg-black/80 transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
            <img id="drawer-hero" src="" alt="Tour Focus" class="w-full h-full object-cover object-center" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6">
              <h3 id="drawer-title" class="font-serif text-3xl font-bold text-white tracking-wide"></h3>
            </div>
          </div>
      
          <div class="flex-1 overflow-y-auto p-8 space-y-8">
            <div>
              <h4 class="text-xs font-bold uppercase tracking-widest text-zinc-400 mb-2">Tour Overview</h4>
              <p id="drawer-desc" class="text-zinc-600 text-sm leading-relaxed font-normal"></p>
            </div>
            <div>
              <h4 class="text-xs font-bold uppercase tracking-widest text-zinc-400 mb-3">Highlights</h4>
              <div id="drawer-pills" class="flex flex-wrap gap-2"></div>
            </div>
            <div class="border-t border-zinc-100 pt-6">
              <h4 class="text-xs font-bold uppercase tracking-widest text-zinc-400 mb-4">Metadata Matrix</h4>
              <div class="grid grid-cols-2 gap-4 text-xs">
                <div class="bg-zinc-50 border border-zinc-200/60 p-3 rounded-lg"><p class="text-zinc-400 uppercase tracking-wider font-bold">Duration</p><p id="meta-duration" class="font-black text-zinc-800 mt-0.5"></p></div>
                <div class="bg-zinc-50 border border-zinc-200/60 p-3 rounded-lg"><p class="text-zinc-400 uppercase tracking-wider font-bold">Activity</p><p id="meta-activity" class="font-black text-zinc-800 mt-0.5"></p></div>
                <div class="bg-zinc-50 border border-zinc-200/60 p-3 rounded-lg"><p class="text-zinc-400 uppercase tracking-wider font-bold">Group Size</p><p id="meta-group" class="font-black text-zinc-800 mt-0.5"></p></div>
                <div class="bg-zinc-50 border border-zinc-200/60 p-3 rounded-lg"><p class="text-zinc-400 uppercase tracking-wider font-bold">Season</p><p id="meta-season" class="font-black text-zinc-800 mt-0.5"></p></div>
              </div>
            </div>
          </div>

          <div class="p-6 bg-zinc-50 border-t border-zinc-200/80 flex gap-4 flex-shrink-0">
            <a id="drawer-open-link" href="" class="flex-1 text-center py-3 text-xs font-black uppercase tracking-wider text-white bg-zinc-950 rounded-xl hover:bg-zinc-800 transition-colors shadow-sm">Open Tour</a>
            <a id="drawer-ask-link" href="" class="flex-1 text-center py-3 text-xs font-black uppercase tracking-wider text-zinc-800 bg-white border border-zinc-300 rounded-xl hover:bg-zinc-50 transition-colors">Ask a Question</a>
          </div>
        </div>

        <section class="py-28 px-6 lg:px-8 bg-[#161616] border-b border-zinc-900">
          <div class="max-w-7xl mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
              <div class="space-y-6">
                <span class="text-xs font-bold uppercase tracking-[0.25em] text-[#D4A437]">Bespoke Coordination</span>
                <h2 class="font-serif text-3xl sm:text-5xl font-bold tracking-tight text-white leading-tight">
                  Custom Tours, Expeditions & Specialized Travel
                </h2>
                <p class="text-[#D1D5DB] text-sm leading-relaxed max-text-ch font-light">
                  Custom tours and expeditions are available for travelers seeking personalized, purpose-driven journeys across Afghanistan, including media support, diaspora return visits, business travel, research, NGO coordination, and mountaineering logistics.
                </p>
                <ul class="space-y-3 pt-2 text-sm text-[#F5F5F5] font-medium">
                  {['Journalists', 'Documentary filmmakers', 'Content creators', 'Photographers', 'Researchers', 'Academic teams', 'Mountaineering expeditions'].map((item) => (
                    <li class="flex items-center gap-3">
                      <span class="w-1.5 h-1.5 bg-[#D4A437] rounded-full"></span> {item}
                    </li>
                  ))}
                </ul>
                <div class="pt-6">
                  <a href="/custom-tours" class="px-6 py-3.5 text-xs font-black uppercase tracking-wider bg-[#D4A437] text-zinc-950 rounded-xl hover:bg-[#bfa030] transition-all inline-block">
                    View Custom Tours
                  </a>
                </div>
              </div>

              <div class="space-y-8 lg:pt-14">
                <div class="space-y-4">
                  <h4 class="font-serif text-2xl font-bold text-white tracking-wide">Truly Bespoke Options</h4>
                  <p class="text-[#9CA3AF] text-sm leading-relaxed font-light max-text-ch">
                    Some journeys do not fit into a standard itinerary. Whether you are reconnecting with family roots, documenting a story, revisiting places tied to previous work, scouting locations, conducting research, or organizing a specialized expedition, our team can help assess what is operationally realistic and what level of support may be appropriate.
                  </p>
                </div>
                <div class="bg-[#0B0F14] border border-zinc-800 p-6 rounded-2xl shadow-inner">
                  <h5 class="text-xs font-bold uppercase tracking-wider text-[#D4A437]">15+ Years on the Ground</h5>
                  <p class="mt-2 text-sm text-[#D1D5DB] font-light leading-relaxed">
                    Long-term operational experience in Afghanistan — not short-term fixer work.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="py-32 px-6 lg:px-8 bg-[#050505] text-center relative overflow-hidden">
          <div class="max-w-3xl mx-auto relative z-10 space-y-6">
            <h2 class="font-serif text-4xl sm:text-6xl font-bold tracking-tight text-white">Ready to Start Planning?</h2>
            <p class="text-[#D1D5DB] text-base font-light max-w-xl mx-auto leading-relaxed">
              Tell us what you want to see, document, research, revisit, or experience in Afghanistan.
            </p>
            <div class="pt-6 flex flex-wrap justify-center gap-4">
              <a href="/contact?action=plan" class="px-6 py-3.5 text-xs font-black uppercase tracking-wider bg-[#D4A437] text-zinc-950 rounded-xl hover:bg-[#bfa030] transition-all shadow-md">
                Start Planning
              </a>
              <a href="/contact" class="px-6 py-3.5 text-xs font-black uppercase tracking-wider bg-zinc-900 text-white rounded-xl border border-zinc-800 hover:bg-zinc-800 transition-all">
                Contact Us
              </a>
            </div>
          </div>
        </section>

        <script define:vars={{ tours }}>
          const drawer = document.getElementById('preview-drawer');
          const closeBtn = document.getElementById('close-drawer');
      
          const drawerHero = document.getElementById('drawer-hero');
          const drawerTitle = document.getElementById('drawer-title');
          const drawerDesc = document.getElementById('drawer-desc');
          const drawerPills = document.getElementById('drawer-pills');
      
          const metaDuration = document.getElementById('meta-duration');
          const metaActivity = document.getElementById('meta-activity');
          const metaGroup = document.getElementById('meta-group');
          const metaSeason = document.getElementById('meta-season');
      
          const openLink = document.getElementById('drawer-open-link');
          const askLink = document.getElementById('drawer-ask-link');

          window.addEventListener('open-tour-preview', (e) => {
            const tourSlug = e.detail.slug;
            const tourData = tours.find(t => t.slug === tourSlug);
            if (!tourData) return;

            drawerHero.src = `/assets/images/tours/${tourData.slug}/hero.webp`;
            drawerTitle.innerText = tourData.title;
            drawerDesc.innerText = tourData.description || 'Custom field operations planned around actual regional transit updates.';
        
            drawerPills.innerHTML = '';
            (tourData.highlights || []).forEach(h => {
              const pill = document.createElement('span');
              pill.className = 'text-[10px] font-bold uppercase tracking-wider bg-zinc-100 border border-zinc-200 px-2.5 py-1 rounded text-zinc-700';
              pill.innerText = h;
              drawerPills.appendChild(pill);
            });

            metaDuration.innerText = `${tourData.duration_days} Days`;
            metaActivity.innerText = tourData.activity_level || 'Moderate';
            metaGroup.innerText = tourData.group_size || 'Direct Access';
            metaSeason.innerText = tourData.season || 'Year-Round';

            openLink.href = `/tours/${tourData.slug}`;
            askLink.href = `/contact?tour=${tourData.slug}&action=question`;

            drawer.classList.remove('translate-x-full');
          });

          closeBtn.addEventListener('click', () => {
            drawer.classList.add('translate-x-full');
          });
        </script>
  </div>
</BaseLayout>
