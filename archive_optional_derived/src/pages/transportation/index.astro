---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { parseCSV } from '../../lib/csv';

function readCsv(name: string) {
  try { return parseCSV(fs.readFileSync(path.join(process.cwd(), 'data', name), 'utf8')); } catch { return []; }
}

const ground = readCsv('ground_transport.csv');
const flights = readCsv('domestic_flights.csv');
const transportSections = [
  {
    title: 'Airport Transfers',
    text: 'Pickup and drop-off support for arriving travelers, with drivers coordinated around flight timing and city movement requirements.',
    image: '/assets/images/transport/airports/airport-pickup.webp',
  },
  {
    title: 'City Taxis & Day Rates',
    text: 'Trusted taxi and local driver coordination for travelers who need practical movement inside major cities without a full guided tour.',
    image: '/assets/images/transport/budget/taxi-kabul.webp',
  },
  {
    title: 'Intercity Transport',
    text: 'Assistance reaching bus terminals, shared vehicle points, or private intercity transport based on route, budget, and comfort level.',
    image: '/assets/images/transport/shared/gallery-1.webp',
  },
  {
    title: 'Private 4x4 Vehicles',
    text: 'Route-appropriate private vehicles for mountain roads, provincial travel, and itineraries requiring more flexible movement.',
    image: '/assets/images/transport/standard/4x4-vehicle.webp',
  },
  {
    title: 'Premium / Expedition Vehicles',
    text: 'Higher-comfort SUVs and expedition vehicles for difficult roads, remote regions, and travelers who require additional reliability.',
    image: '/assets/images/transport/premium/wakhan-offroad.webp',
  },
  {
    title: 'Armored Transport',
    text: 'Soft-skinned or armored transport may be arranged for professional travelers where appropriate and available.',
    image: '/assets/images/transport/luxury/armored-suv.webp',
  },
  {
    title: 'Domestic Flights',
    text: 'Domestic flight planning can be used where routes, schedules, and conditions support air movement between major cities.',
    image: '/assets/images/transport/airports/kabul-airport.webp',
  },
  {
    title: 'Route Planning & Seasonal Access',
    text: 'Transport planning considers road condition, snow, daylight movement, route timing, vehicle suitability, and local coordination.',
    image: '/assets/images/transport/roads/mountain-pass.webp',
  },
];
---

<BaseLayout title="Transportation | AfghanTours" description="Transportation support for Afghanistan tours, airport transfers, private vehicles, domestic flights, and route planning.">
  <PageHero
    eyebrow="Travel Logistics"
    title="Transportation that supports the itinerary"
    text="Movement in Afghanistan depends on the route, season, terrain, timing, comfort level, and local coordination."
    image="/assets/images/transport/roads/mountain-pass.webp"
    video="/assets/images/heroes/hero-transportation.mov"
    height="min-h-[58vh]"
  />

  <section class="transport-intro">
    <div>
      <p class="eyebrow">Route Support</p>
      <h2>Transport is planned around the journey, not treated as an afterthought.</h2>
      <p>
        AfghanTours coordinates transportation based on current route conditions, access requirements, vehicle suitability, traveler comfort expectations, and the practical realities of each province or city. Options may include airport transfers, city taxis, private vehicles, armored transport, shared intercity options, or domestic flights where available.
      </p>
    </div>
  </section>

  <section class="transport-grid-section">
    <div class="transport-grid">
      {transportSections.map((item) => (
        <article class="transport-card">
          <img src={item.image} alt={item.title} loading="lazy" onerror="this.src='/assets/images/placeholders/default-transport.webp'" />
          <div>
            <h2>{item.title}</h2>
            <p>{item.text}</p>
            <a href={`/contact/?type=transportation&topic=${encodeURIComponent(item.title)}`}>Ask about this</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  {(ground.length || flights.length) && (
    <section class="transport-data">
      <div class="transport-data__inner">
        {ground.length > 0 && (
          <div>
            <p class="eyebrow">Ground Options</p>
            <h2>Vehicle references</h2>
            <div class="data-list">
              {ground.slice(0, 8).map((row) => (
                <article>
                  <strong>{row.name || row.vehicle_type || row.type || 'Ground transport'}</strong>
                  <span>{row.description || row.notes || row.capacity || 'Route-dependent availability'}</span>
                </article>
              ))}
            </div>
          </div>
        )}
        {flights.length > 0 && (
          <div>
            <p class="eyebrow">Domestic Flights</p>
            <h2>Air route references</h2>
            <div class="data-list">
              {flights.slice(0, 8).map((row) => (
                <article>
                  <strong>{row.route || row.name || `${row.origin || ''} ${row.destination || ''}`}</strong>
                  <span>{row.notes || row.airline || row.frequency || 'Schedule and availability must be confirmed'}</span>
                </article>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <section class="transport-cta">
    <div>
      <p class="eyebrow">Plan with us</p>
      <h2>Ask about transportation support</h2>
      <p>Tell us your route, dates, comfort level, and whether you prefer budget, private, premium, or specialized transport.</p>
      <a href="/contact/?type=transportation">Ask About Transportation Support</a>
    </div>
  </section>
</BaseLayout>

<style>
  .eyebrow { margin: 0 0 0.7rem; color: #b45309; font-size: 0.78rem; font-weight: 900; letter-spacing: 0.22em; text-transform: uppercase; }
  .transport-intro { background: #f7f2e9; color: #11100d; padding: clamp(3rem, 6vw, 5rem) 1rem; }
  .transport-intro > div { width: min(980px, 100%); margin: 0 auto; }
  .transport-intro h2, .transport-data h2, .transport-cta h2 { margin: 0; font-family: Georgia, "Times New Roman", serif; font-size: clamp(2.3rem, 5vw, 4.4rem); line-height: 0.95; letter-spacing: -0.055em; }
  .transport-intro p:last-child { max-width: 820px; margin: 1.3rem 0 0; color: #514c44; line-height: 1.8; font-size: 1.08rem; }
  .transport-grid-section { background: #fbf8f2; padding: clamp(3rem, 6vw, 5rem) 1rem; }
  .transport-grid { width: min(1180px, 100%); margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .transport-card { overflow: hidden; border-radius: 28px; background: white; border: 1px solid rgba(0,0,0,0.08); box-shadow: 0 14px 32px rgba(0,0,0,0.06); }
  .transport-card img { width: 100%; height: 190px; object-fit: cover; display: block; }
  .transport-card div { padding: 1.25rem; }
  .transport-card h2 { margin: 0; font-family: Georgia, "Times New Roman", serif; font-size: 1.55rem; line-height: 1; }
  .transport-card p { color: #5d554b; line-height: 1.65; font-size: 0.94rem; }
  .transport-card a, .transport-cta a { display: inline-flex; margin-top: 0.5rem; border-radius: 999px; background: #07110d; color: #fff8ec; padding: 0.72rem 0.95rem; font-size: 0.8rem; font-weight: 900; text-decoration: none; }
  .transport-data { background: #fffaf2; padding: clamp(3rem, 6vw, 5rem) 1rem; }
  .transport-data__inner { width: min(1180px, 100%); margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .data-list { margin-top: 1.2rem; display: grid; gap: 0.7rem; }
  .data-list article { display: grid; gap: 0.25rem; border-radius: 20px; background: #f7f2e9; padding: 1rem; border: 1px solid rgba(0,0,0,0.06); }
  .data-list span { color: #625b50; line-height: 1.55; font-size: 0.92rem; }
  .transport-cta { background: #f7efe2; color: #11100d; text-align: center; padding: clamp(4rem, 8vw, 7rem) 1rem; }
  .transport-cta > div { width: min(760px, 100%); margin: 0 auto; }
  .transport-cta p:not(.eyebrow) { max-width: 650px; margin: 1rem auto 0; color: #514c44; line-height: 1.75; }
  @media (max-width: 1080px) { .transport-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 760px) { .transport-grid, .transport-data__inner { grid-template-columns: 1fr; } }
</style>
