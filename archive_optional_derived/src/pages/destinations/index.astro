---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getProvinces } from '../../lib/buildRelations';
const provinces = getProvinces().filter((p) => p.slug);
---
<BaseLayout title="Destinations | AfghanTours" description="Province and destination guides for Afghanistan travel planning.">
  <PageHero eyebrow="Destination Guide" title="Afghanistan destinations" text="Province-by-province travel context, regional highlights, and practical planning notes." image="/assets/images/heroes/hero-destinations.webp" height="min-h-[58vh]" />
  <section class="bg-[#fbf8f2] py-16 text-stone-950">
    <div class="mx-auto grid max-w-7xl gap-6 px-6 md:grid-cols-2 lg:grid-cols-3">
      {provinces.map((p) => (
        <a href={`/destinations/${p.slug}/`} class="overflow-hidden rounded-[1.5rem] bg-white shadow-sm ring-1 ring-stone-200 transition hover:-translate-y-1 hover:shadow-xl">
          <img src={p.image || p.cover_image_path || '/assets/images/placeholders/default-province.webp'} alt={p.title || p.name} class="h-56 w-full object-cover" />
          <div class="p-6">
            <p class="text-xs font-black uppercase tracking-[0.22em] text-amber-700">{p.region || 'Afghanistan'}</p>
            <h2 class="mt-2 text-2xl font-black">{p.title || p.name}</h2>
            <p class="mt-3 line-clamp-3 text-sm leading-7 text-stone-600">{p.short_blurb || p.excerpt}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
