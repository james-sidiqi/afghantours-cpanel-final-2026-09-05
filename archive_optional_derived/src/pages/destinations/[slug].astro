---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getProvinces, getProvinceBySlug, getAttractions } from '../../lib/buildRelations';

export function getStaticPaths() {
  return getProvinces().filter((p) => p?.slug).map((p) => ({ params: { slug: p.slug } }));
}
const province = Astro.params.slug ? getProvinceBySlug(Astro.params.slug) : undefined;
if (!province) return Astro.redirect('/destinations/');
const attractions = getAttractions().filter((a) => String(a.province_code || '').toLowerCase() === String(province.province_code || '').toLowerCase() || String(a.province || '').toLowerCase() === String(province.name || province.province_name || '').toLowerCase());
const image = province.image || province.cover_image_path || '/assets/images/placeholders/default-province.webp';
---
<BaseLayout title={`${province.title || province.name} | AfghanTours`} description={province.short_blurb || province.excerpt || ''} image={image}>
  <PageHero eyebrow={province.region || 'Afghanistan'} title={province.title || province.name} text={province.short_blurb || ''} image={image} height="min-h-[64vh]" />
  <section class="bg-white py-16 text-stone-950">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 lg:grid-cols-[1fr_0.8fr]">
      <div class="editorial-prose" set:html={province.content_html || ''} />
      <aside class="rounded-[2rem] bg-[#fbf8f2] p-6 ring-1 ring-stone-200">
        <h2 class="text-3xl font-black">Attractions in {province.title || province.name}</h2>
        <div class="mt-6 grid gap-3">
          {attractions.map((a) => <a class="rounded-2xl bg-white p-4 font-black hover:text-amber-700" href={`/attractions/${a.slug}/`}>{a.title || a.name}</a>)}
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
