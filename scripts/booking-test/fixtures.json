{
  "_doc": "Shared status fixtures: run by scripts/booking-test/core.test.mjs (JS) AND scripts/booking-test/test-core.php (PHP) so both runtimes agree.",
  "settings": { "shared_min_group_default": 3, "limited_places_threshold": 2 },
  "cases": [
    { "name": "1 confirmed traveler → awaiting minimum", "today": "2026-10-10", "dep": { "status": "scheduled", "start_date": "2026-12-05", "end_date": "2026-12-16", "min_group_size": 3, "max_capacity": 8, "confirmed_count": 1, "operational_approval": "pending" }, "expect": "available_awaiting_minimum" },
    { "name": "2 confirmed travelers → awaiting minimum", "today": "2026-10-10", "dep": { "status": "scheduled", "start_date": "2026-12-05", "end_date": "2026-12-16", "min_group_size": 3, "max_capacity": 8, "confirmed_count": 2, "operational_approval": "approved" }, "expect": "available_awaiting_minimum" },
    { "name": "3 confirmed but NOT approved → still awaiting (no auto-confirm)", "today": "2026-10-10", "dep": { "status": "scheduled", "start_date": "2026-12-05", "end_date": "2026-12-16", "min_group_size": 3, "max_capacity": 8, "confirmed_count": 3, "operational_approval": "pending" }, "expect": "available_awaiting_minimum" },
    { "name": "3 confirmed + approved → confirmed", "today": "2026-10-10", "dep": { "status": "scheduled", "start_date": "2026-12-05", "end_date": "2026-12-16", "min_group_size": 3, "max_capacity": 8, "confirmed_count": 3, "operational_approval": "approved" }, "expect": "confirmed" },
    { "name": "pending travelers never count", "today": "2026-10-10", "dep": { "status": "scheduled", "start_date": "2026-12-05", "end_date": "2026-12-16", "min_group_size": 3, "max_capacity": 8, "confirmed_count": 0, "pending_count": 9, "operational_approval": "approved" }, "expect": "available_awaiting_minimum" },
    { "name": "confirmed + approved + 2 left → limited", "today": "2026-10-10", "dep": { "status": "scheduled", "start_date": "2026-12-05", "end_date": "2026-12-16", "min_group_size": 3, "max_capacity": 6, "confirmed_count": 4, "operational_approval": "approved" }, "expect": "limited" },
    { "name": "remaining 0 → sold out", "today": "2026-10-10", "dep": { "status": "scheduled", "start_date": "2026-12-05", "end_date": "2026-12-16", "min_group_size": 3, "max_capacity": 6, "confirmed_count": 6, "operational_approval": "approved" }, "expect": "sold_out" },
    { "name": "no capacity set → never sold out / limited", "today": "2026-10-10", "dep": { "status": "scheduled", "start_date": "2026-12-05", "end_date": "2026-12-16", "min_group_size": 3, "max_capacity": null, "confirmed_count": 12, "operational_approval": "approved" }, "expect": "confirmed" },
    { "name": "ended → completed (never available)", "today": "2026-10-10", "dep": { "status": "scheduled", "start_date": "2026-09-21", "end_date": "2026-09-29", "min_group_size": 3, "confirmed_count": 0 }, "expect": "completed" },
    { "name": "ends today → closed (in progress)", "today": "2026-10-10", "dep": { "status": "scheduled", "start_date": "2026-10-05", "end_date": "2026-10-10", "min_group_size": 3 }, "expect": "closed" },
    { "name": "starts today → closed", "today": "2026-10-12", "dep": { "status": "scheduled", "start_date": "2026-10-12", "end_date": "2026-10-20", "min_group_size": 3 }, "expect": "closed" },
    { "name": "cutoff passed → closed", "today": "2026-11-20", "dep": { "status": "scheduled", "start_date": "2026-12-05", "end_date": "2026-12-16", "booking_cutoff": "2026-11-15", "min_group_size": 3 }, "expect": "closed" },
    { "name": "manually closed", "today": "2026-10-10", "dep": { "status": "closed", "start_date": "2026-12-05", "end_date": "2026-12-16", "min_group_size": 3 }, "expect": "closed" },
    { "name": "cancelled", "today": "2026-10-10", "dep": { "status": "cancelled", "start_date": "2026-12-05", "end_date": "2026-12-16", "min_group_size": 3 }, "expect": "cancelled" },
    { "name": "past cancelled → completed (history)", "today": "2027-01-10", "dep": { "status": "cancelled", "start_date": "2026-12-05", "end_date": "2026-12-16", "min_group_size": 3 }, "expect": "completed" },
    { "name": "private departure → on request", "today": "2026-10-10", "dep": { "status": "scheduled", "departure_type": "private", "start_date": "2026-12-05", "end_date": "2026-12-16", "min_group_size": 1 }, "expect": "on_request" },
    { "name": "proposed is never public", "today": "2026-10-10", "dep": { "status": "proposed", "published": true, "start_date": "2026-12-05", "end_date": "2026-12-16", "min_group_size": 3 }, "expect": "proposed", "expect_public": false },
    { "name": "published scheduled is public", "today": "2026-10-10", "dep": { "status": "scheduled", "published": true, "start_date": "2026-12-05", "end_date": "2026-12-16", "min_group_size": 3 }, "expect": "available_awaiting_minimum", "expect_public": true },
    { "name": "unpublished scheduled is not public", "today": "2026-10-10", "dep": { "status": "scheduled", "published": false, "start_date": "2026-12-05", "end_date": "2026-12-16", "min_group_size": 3 }, "expect": "available_awaiting_minimum", "expect_public": false },
    { "name": "past published is not public", "today": "2026-10-10", "dep": { "status": "scheduled", "published": true, "start_date": "2026-08-20", "end_date": "2026-08-22", "min_group_size": 3 }, "expect": "completed", "expect_public": false }
