# Server-side library. No URL in this directory is public.
# PHP is not enabled here. Front controllers include these files from disk.
Options -Indexes
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
