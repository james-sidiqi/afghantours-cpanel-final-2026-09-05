---
const features = [
  {
    icon: `<svg class="w-8 h-8 text-emerald-800" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9-6h.008v.008H12v-.008ZM12 15h.008v.008H12V15Zm0 2.25h.008v.008H12v-.008ZM9.75 15h.008v.008H9.75V15Zm0 2.25h.008v.008H9.75v-.008ZM7.5 15h.008v.008H7.5V15Zm0 2.25h.008v.008H7.5v-.008Zm6.75-4.5h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V15Zm0 2.25h.008v.008h-.008v-.008Zm2.25-4.5h.008v.008H16.5v-.008Zm0 2.25h.008v.008H16.5V15Z" /></svg>`,
    title: '15+ years on the ground',
    text: 'Long-term operational experience in Afghanistan, not short-term fixer work.'
  },
  {
    icon: `<svg class="w-8 h-8 text-emerald-800" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498 4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 0 0-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.996 2.497c.317.158.69.158 1.006 0Z" /></svg>`,
    title: 'Western-led planning',
    text: 'We understand international traveler expectations and Afghan operating realities.'
  },
  {
    icon: `<svg class="w-8 h-8 text-emerald-800" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" /></svg>`,
    title: 'Kabul-based operations',
    text: 'Planning is handled by a team working from Afghanistan with real local coordination.'
  },
  {
    icon: `<svg class="w-8 h-8 text-emerald-800" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" /></svg>`,
    title: 'Security-aware routing',
    text: 'Routes are reviewed based on access, timing, local conditions, and feasibility.'
  }
];
---
<section class="bg-[#fbf8f2] py-24 text-stone-950 border-t border-stone-200/60">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    
    <div class="max-w-4xl mb-16">
      <p class="text-xs font-black uppercase tracking-[0.25em] text-emerald-800">Why AfghanTours</p>
      <h2 class="mt-3 text-4xl font-black tracking-tight sm:text-6xl text-stone-950">
        Access with control
      </h2>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4 mb-14">
      {features.map((item) => (
        <div class="rounded-3xl bg-white/70 backdrop-blur-sm p-8 shadow-sm border border-stone-200/80 transition-all duration-300 hover:shadow-md hover:bg-white flex flex-col justify-start">
          <div class="mb-5 p-2 bg-stone-50 rounded-xl w-fit border border-stone-100">
            <Fragment set:html={item.icon} />
          </div>
          <h3 class="text-lg font-black text-stone-950 tracking-tight">{item.title}</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-stone-600 font-normal">{item.text}</p>
        </div>
      ))}
    </div>

    <div class="grid gap-8 lg:grid-cols-[1fr_2fr] lg:items-center pt-4">
      <div class="space-y-3 max-w-md">
        <p class="text-lg font-bold text-stone-900 tracking-tight leading-snug">
          We are not trying to sell generic tourism.
        </p>
        <p class="text-lg font-bold text-stone-900 tracking-tight leading-snug">
          We plan meaningful, realistic travel with logistics discipline and local coordination.
        </p>
      </div>
      
      <div class="overflow-hidden rounded-3xl border border-stone-200/80 shadow-md">
        <img 
          src="/assets/images/scenery/highway-route.webp" 
          alt="Logistics aware driving route through Afghanistan mountain valleys" 
          class="w-full h-[320px] object-cover object-center transition-transform duration-700 hover:scale-105"
        />
      </div>
    </div>

  </div>
</section>
