---
const goldAccent = "text-amber-500";
---

<footer class="bg-zinc-950 border-t border-zinc-900 pt-20 pb-12 text-zinc-400 font-normal">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    
    <div class="grid gap-12 lg:grid-cols-3 lg:gap-16 pb-16 border-b border-zinc-900">
      
      <div class="space-y-6">
        <img src="/assets/images/logo/footer-logo.webp" alt="James Tourist & Travel Agency" class="h-12 w-auto object-contain" />
        <p class="text-sm leading-relaxed max-w-sm text-zinc-500">
          Licensed Kabul tour operators executing multi-province expeditions, high-risk operational planning, and field-tested media logistics since 2012.
        </p>
        
        <div class="pt-2">
          <p class={`text-xs font-black tracking-[0.4em] uppercase ${goldAccent}`}>
            Service • Integrity • Excellence
          </p>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8 lg:col-span-2">
        
        <div>
          <h3 class={`text-sm font-black uppercase tracking-widest ${goldAccent}`}>Explore</h3>
          <ul class="mt-6 space-y-4 text-sm">
            <li><a href="/tours/" class="hover:text-white transition-colors">Tours</a></li>
            <li><a href="/destinations/" class="hover:text-white transition-colors">Destinations</a></li>
            <li><a href="/attractions/" class="hover:text-white transition-colors">Attractions</a></li>
            <li><a href="/food-culture/" class="hover:text-white transition-colors">Food & Culture</a></li>
            <li><a href="/hotels/" class="hover:text-white transition-colors">Hotels</a></li>
            <li><a href="/transportation/" class="hover:text-white transition-colors">Transportation</a></li>
          </ul>
        </div>

        <div>
          <h3 class={`text-sm font-black uppercase tracking-widest ${goldAccent}`}>Plan</h3>
          <ul class="mt-6 space-y-4 text-sm">
            <li><a href="/safety/" class="hover:text-white transition-colors">Safety</a></li>
            <li><a href="/faq/" class="hover:text-white transition-colors">FAQ</a></li>
            <li><a href="/contact/" class="hover:text-white transition-colors">Custom Inquiry</a></li>
            <li><a href="/terms/" class="hover:text-white transition-colors">Terms</a></li>
            <li><a href="/privacy/" class="hover:text-white transition-colors">Privacy</a></li>
          </ul>
        </div>

      </div>
    </div>

    <div class="mt-12 grid gap-8 sm:grid-cols-3 text-xs text-zinc-500">
      <div>
        <h4 class="font-bold text-zinc-400 uppercase tracking-wider mb-2">Secure Communications</h4>
        <p class="hover:text-white transition-colors">WhatsApp Secure Direct Line</p>
        <p class="mt-1 text-zinc-400 font-mono">ops@afghantours.com / info@afghantours.com</p>
      </div>
      <div>
        <h4 class="font-bold text-zinc-400 uppercase tracking-wider mb-2">Kabul HQ Command Operations</h4>
        <p>James Tourist & Travel Agency</p>
        <p class="mt-1">Licensed Ministry of Information & Culture Operator</p>
        <p class="text-zinc-600">Kabul, Afghanistan</p>
      </div>
      <div class="sm:text-right flex flex-col justify-end">
        <p>&copy; {new Date().getFullYear()} AfghanTours.com / James Tourist & Travel Agency.</p>
        <p class="mt-1 text-zinc-600">All rights reserved worldwide. Ground logistics subject to permit parameters.</p>
      </div>
    </div>

  </div>
</footer>
