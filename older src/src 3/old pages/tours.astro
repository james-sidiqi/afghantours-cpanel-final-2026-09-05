---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FeaturedTours from '../components/FeaturedTours.astro';
import TourDirectory from '../components/TourDirectory.astro';
import CustomTours from '../components/CustomTours.astro';
import { getTours } from '../lib/buildRelations';

const tours = getTours().filter((tour) => tour.is_active !== false && tour.slug);
---
<BaseLayout title="Tours | AfghanTours" description="Browse featured Afghanistan tours, cultural circuits, private expeditions, and custom travel programs.">
  <PageHero
    eyebrow="Afghanistan Tours"
    title="Choose the journey that fits your reason for coming"
    text="Cultural circuits, fixed departures, private expeditions, photography support, winter routes, and custom itineraries built around real logistics."
    image="/assets/images/heroes/hero-tours.webp"
    primaryHref="#featured-tours"
    primaryLabel="Featured Tours"
    secondaryHref="#custom-tours"
    secondaryLabel="Custom Tours"
    height="min-h-[72vh]"
  />
  <div id="featured-tours"><FeaturedTours tours={tours.slice(0, 10)} /></div>
  <TourDirectory tours={tours} />
  <div id="custom-tours"><CustomTours /></div>
</BaseLayout>
