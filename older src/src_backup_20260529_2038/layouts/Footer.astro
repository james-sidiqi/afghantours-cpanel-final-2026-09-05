---
const year = new Date().getFullYear();
const columns = [
  {
    title: 'Explore',
    links: [
      { label: 'Tours', href: '/tours/' },
      { label: 'Destinations', href: '/destinations/' },
      { label: 'Attractions', href: '/attractions/' },
      { label: 'Food & Culture', href: '/food-culture/' },
      { label: 'Hotels', href: '/hotels/' },
      { label: 'Transportation', href: '/transportation/' },
    ],
  },
  {
    title: 'Plan',
    links: [
      { label: 'Safety', href: '/safety/' },
      { label: 'FAQ', href: '/faq/' },
      { label: 'Custom Inquiry', href: '/contact/?type=custom-trip' },
      { label: 'Terms', href: '/terms/' },
      { label: 'Privacy', href: '/privacy/' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <section class="footer-brand" aria-label="AfghanTours company information">
      <img class="footer-brand__seal" src="/assets/images/logo/footer-logo.webp" alt="James Tourist & Travel Agency" loading="lazy" />
      <p class="footer-brand__copy">
        AfghanTours.com is owned and operated by <strong>James Tourist & Travel Agency</strong>, a licensed Afghanistan travel operator based in Kabul.
      </p>
      <p class="footer-brand__motto">History • Hospitality • Field-tested logistics</p>
    </section>

    <nav class="footer-nav" aria-label="Footer navigation">
      {columns.map((column) => (
        <div class="footer-nav__column">
          <h2>{column.title}</h2>
          <ul>
            {column.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </div>
      ))}
    </nav>

    <section class="footer-contact" aria-label="Contact information">
      <h2>Contact</h2>
      <p><a href="https://wa.me/93780123456">WhatsApp: +93 780 123 456</a></p>
      <p><a href="mailto:info@afghantours.com">info@afghantours.com</a></p>
      <address>
        2nd Floor, Majid Mall<br />
        Shahr-e-Naw, District 10<br />
        Kabul, Afghanistan
      </address>
    </section>
  </div>

  <div class="site-footer__bottom">© {year} AfghanTours.com / James Tourist & Travel Agency</div>
</footer>

<style>
  .site-footer {
    background: radial-gradient(circle at left top, rgba(41, 84, 54, 0.45), transparent 34rem), #07110d;
    color: #f5efe4;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .site-footer__inner {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
    padding: clamp(3.5rem, 6vw, 5.2rem) 0 3rem;
    display: grid;
    grid-template-columns: 1.25fr 1.4fr 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }

  .footer-brand__seal { width: 128px; max-width: 100%; height: auto; display: block; margin-bottom: 1.4rem; }
  .footer-brand__copy { max-width: 320px; margin: 0; color: #e6ded0; font-size: 0.98rem; line-height: 1.7; }
  .footer-brand__motto { margin: 1.2rem 0 0; color: #d69f35; font-size: 0.72rem; font-weight: 900; letter-spacing: 0.24em; text-transform: uppercase; }

  .footer-nav { display: grid; grid-template-columns: repeat(2, minmax(130px, 1fr)); gap: 2rem; }
  .footer-nav__column h2, .footer-contact h2 { margin: 0 0 1.2rem; color: #fff8ec; font-size: 0.82rem; font-weight: 900; letter-spacing: 0.18em; text-transform: uppercase; }
  .footer-nav ul { display: grid; gap: 0.85rem; list-style: none; padding: 0; margin: 0; }
  .footer-nav a, .footer-contact a { color: rgba(245, 239, 228, 0.78); text-decoration: none; }
  .footer-nav a:hover, .footer-contact a:hover { color: #d2aa65; }

  .footer-contact { color: rgba(245, 239, 228, 0.78); }
  .footer-contact p { margin: 0 0 0.85rem; line-height: 1.5; }
  .footer-contact address { margin: 1rem 0 0; font-style: normal; line-height: 1.55; }

  .site-footer__bottom { padding: 1rem; text-align: center; color: rgba(245, 239, 228, 0.45); font-size: 0.85rem; border-top: 1px solid rgba(255, 255, 255, 0.05); }

  @media (max-width: 920px) { .site-footer__inner { grid-template-columns: 1fr; } .footer-brand__copy { max-width: 560px; } }
  @media (max-width: 620px) { .footer-nav { grid-template-columns: 1fr; gap: 2rem; } }
</style>
