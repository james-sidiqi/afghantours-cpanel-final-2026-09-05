---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Pull everything from the unified src/content/food/ collection
const allFoodItems = await getCollection('food');

// Filter out items that are explicitly inside the dishes subdirectory
const dishesOnly = allFoodItems.filter(item => item.id.startsWith('dishes/'));

// Helper to clean up markdown body text for a quick preview snippet
const getSnippet = (body: string) => {
  if (!body) return '';
  return body
    .replace(/[#*`_-]/g, '') // Strip markdown formatting
    .trim()
    .split('\n')[0] // Grab first descriptive sentence/paragraph
    .slice(0, 140) + '...';
};
---

<BaseLayout title="Culinary Heritage">
  <main class="max-w-7xl mx-auto px-4 py-12">
    <div class="mb-10">
      <h1 class="text-4xl font-bold mb-2 text-slate-900">Culinary Heritage</h1>
      <p class="text-gray-600 max-w-2xl">Explore our comprehensive guide to traditional culinary specialties, regional profiles, and dietary options.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {dishesOnly.map((dish) => (
        <div class="border border-slate-200 rounded-xl overflow-hidden shadow-sm bg-white flex flex-col justify-between p-5">
          <div>
            <div class="flex items-start justify-between gap-2 mb-2">
              <h2 class="text-xl font-bold text-slate-800 leading-tight">{dish.data.title}</h2>
              
              {/* Diet Badges */}
              <div class="flex gap-1 flex-shrink-0 mt-0.5">
                {dish.data.vegan && (
                  <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs px-2 py-0.5 rounded-full font-medium">
                    Vegan
                  </span>
                )}
                {dish.data.vegetarian && !dish.data.vegan && (
                  <span class="bg-green-50 text-green-700 border border-green-200 text-xs px-2 py-0.5 rounded-full font-medium">
                    Veg
                  </span>
                )}
              </div>
            </div>
            
            {/* Geographic/Province Tags */}
            {dish.data.provinces && dish.data.provinces.length > 0 && (
              <div class="flex flex-wrap gap-1 mb-3">
                {dish.data.provinces.map((prov) => (
                  <span class="text-[10px] uppercase tracking-wider bg-slate-100 text-slate-600 px-1.5 py-0.5 rounded font-semibold">
                    {prov}
                  </span>
                ))}
              </div>
            )}
            
            {/* Preview Snippet */}
            <p class="text-slate-600 text-sm leading-relaxed line-clamp-3">
              {getSnippet(dish.body)}
            </p>
          </div>
          
          <div class="mt-4 pt-3 border-t border-slate-100 flex justify-between items-center text-xs text-slate-400">
            <span>Code: {dish.data.dish_code || 'N/A'}</span>
            <a href={`/food-culture/${dish.slug || dish.id}`} class="text-blue-600 hover:underline font-medium">
              View Details →
            </a>
          </div>
        </div>
      ))}
    </div>
  </main>
</BaseLayout>
