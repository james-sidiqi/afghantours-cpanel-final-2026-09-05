---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getAttractions, getAttractionBySlug } from '../../lib/buildRelations';

export function getStaticPaths() {
  return getAttractions().filter((item) => item?.slug).map((item) => ({ params: { slug: item.slug } }));
}

const item = Astro.params.slug ? getAttractionBySlug(Astro.params.slug) : undefined;
if (!item) return Astro.redirect('/attractions/');
const image = item.image || item.image_path || item.thumbnail_path || '/assets/images/placeholders/default-attraction.webp';
const facts = [
  ['Province', item.province || item.province_code],
  ['Region', item.region],
  ['Category', item.category],
  ['Visit duration', item.visit_duration_hours ? `${item.visit_duration_hours} hours` : 'Varies'],
  ['Access', item.access_difficulty],
  ['Season', [item.season_start, item.season_end].filter(Boolean).join('–') || 'Year-round / confirm locally'],
].filter(([, value]) => value);
---
<BaseLayout title={`${item.title || item.name} | AfghanTours`} description={item.desc_short || item.excerpt || ''} image={image}>
  <PageHero eyebrow={item.province || item.region || 'Afghanistan'} title={item.title || item.name} text={item.desc_short || ''} image={image} height="min-h-[68vh]" />
  <section class="bg-[#fbf8f2] py-16 text-stone-950">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 lg:grid-cols-[1fr_0.8fr]">
      <div class="rounded-[2rem] bg-white p-8 shadow-sm ring-1 ring-stone-200">
        <div class="editorial-prose" set:html={item.content_html || ''} />
      </div>
      <aside class="rounded-[2rem] bg-white p-6 shadow-sm ring-1 ring-stone-200 lg:sticky lg:top-28">
        <h2 class="text-3xl font-black">Visit snapshot</h2>
        <div class="mt-6 grid gap-3">
          {facts.map(([label, value]) => (
            <div class="rounded-2xl bg-stone-100 p-4">
              <p class="text-xs font-black uppercase tracking-[0.18em] text-stone-500">{label}</p>
              <p class="mt-1 font-black text-stone-950">{value}</p>
            </div>
          ))}
        </div>
        {item.notes && <p class="mt-5 text-sm leading-7 text-stone-600">{item.notes}</p>}
      </aside>
    </div>
  </section>
</BaseLayout>
