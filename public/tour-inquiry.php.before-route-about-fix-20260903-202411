<?php
header('X-Content-Type-Options: nosniff');
header('Referrer-Policy: same-origin');

function wants_json() {
    $accept = isset($_SERVER['HTTP_ACCEPT']) ? $_SERVER['HTTP_ACCEPT'] : '';
    return stripos($accept, 'application/json') !== false;
}

function respond($ok, $message, $status = 200) {
    http_response_code($status);
    if (wants_json()) {
        header('Content-Type: application/json; charset=utf-8');
        echo json_encode(array('ok' => $ok, 'message' => $message));
        exit;
    }
    header('Content-Type: text/html; charset=utf-8');
    $safe = htmlspecialchars($message, ENT_QUOTES, 'UTF-8');
    echo '<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AfghanTours Inquiry</title></head><body style="font-family:Arial,sans-serif;max-width:720px;margin:60px auto;padding:20px"><h1>AfghanTours</h1><p>' . $safe . '</p><p><a href="/tours/">Return to tours</a></p></body></html>';
    exit;
}

if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    respond(false, 'Invalid request.', 405);
}

function value($key, $max = 4000) {
    $v = isset($_POST[$key]) ? trim((string)$_POST[$key]) : '';
    $v = str_replace(array("\r\0", "\0"), '', $v);
    if (function_exists('mb_substr')) return mb_substr($v, 0, $max, 'UTF-8');
    return substr($v, 0, $max);
}

function one_line($value) {
    return trim(str_replace(array("\r", "\n"), ' ', $value));
}

if (value('website', 200) !== '') {
    respond(true, 'Thank you.');
}

$name = one_line(value('name', 160));
$email = one_line(value('email', 200));
$whatsapp = one_line(value('whatsapp', 120));
$country = one_line(value('country', 120));
$tour = one_line(value('tour', 240));
$tourSlug = one_line(value('tour_slug', 200));
$tourUrl = one_line(value('tour_url', 800));
$sourceUrl = one_line(value('source_url', 800));
$dates = one_line(value('travel_dates', 200));
$travelers = one_line(value('travelers', 80));
$messageText = value('message', 5000);

if ($name === '' || ($email === '' && $whatsapp === '')) {
    respond(false, 'Please provide your name and either an email address or WhatsApp number.', 422);
}

if ($email !== '' && !filter_var($email, FILTER_VALIDATE_EMAIL)) {
    respond(false, 'Please enter a valid email address or leave the email field blank and use WhatsApp.', 422);
}

$to = 'info@afghantours.com';
$subjectTour = $tour !== '' ? $tour : 'Tour';
$subject = 'AfghanTours Tour Inquiry - ' . preg_replace('/[^A-Za-z0-9 .,&()\-]/', '', $subjectTour);

$body = array(
    'NEW AFGHANTOURS TOUR INQUIRY',
    '',
    'Tour: ' . $tour,
    'Tour slug: ' . $tourSlug,
    'Tour page: ' . $tourUrl,
    '',
    'Name: ' . $name,
    'Country: ' . $country,
    'Email: ' . $email,
    'WhatsApp: ' . $whatsapp,
    'Preferred dates: ' . $dates,
    'Travelers: ' . $travelers,
    '',
    'Message:',
    $messageText,
    '',
    'Source/referrer: ' . $sourceUrl,
    'Submitted: ' . gmdate('Y-m-d H:i:s') . ' UTC',
    'IP: ' . (isset($_SERVER['REMOTE_ADDR']) ? $_SERVER['REMOTE_ADDR'] : ''),
);

$headers = array(
    'From: AfghanTours Website <info@afghantours.com>',
    'Content-Type: text/plain; charset=UTF-8',
);
if ($email !== '') $headers[] = 'Reply-To: ' . $email;

$sent = @mail($to, $subject, implode("\r\n", $body), implode("\r\n", $headers));
if (!$sent) {
    respond(false, 'The form could not send from the server. Please use WhatsApp or email info@afghantours.com while we check the mail configuration.', 500);
}

respond(true, 'Thank you. Your tour inquiry has been sent to AfghanTours.');
