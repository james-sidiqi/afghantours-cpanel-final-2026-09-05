# AfghanTours private calculator — this directory only.
# Do not copy these rules into the staging or production docroot .htaccess.
# Anonymous access is not granted here, so staging Directory Privacy is not replaced.
Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_php.c>
  php_flag engine on
  php_flag display_errors Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^$ index.php [L]
  RewriteRule !^index\.php$ - [F,L]
</IfModule>

<FilesMatch "^(?!index\.php$).+">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<Files "index.php">
  <IfModule mod_authz_core.c>
    AuthMerging And
    Require valid-user
  </IfModule>
</Files>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Cache-Control "private, no-store, max-age=0, must-revalidate"
</IfModule>
