---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import RelatedTourCards from '../../components/cards/RelatedTourCards.astro';

export async function getStaticPaths() {
  const foodEntries = await getCollection('food');
  return foodEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const heroImage = entry.data.hero_image || entry.data.image || '/assets/images/heroes/food-and-culture/hero.webp';
const isExperience = entry.data.category === 'Cultural Experiences';
---

<BaseLayout title={`${entry.data.title} | Food & Culture | AfghanTours`} description={entry.data.card_description || entry.data.subtitle || ''} image={heroImage}>
  <main class="bg-white">
    <section class="relative overflow-hidden bg-slate-950 text-white">
      <div class="absolute inset-0 opacity-45">
        <img src={heroImage} alt={entry.data.title} class="h-full w-full object-cover" />
      </div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/80 to-slate-950/20"></div>
      <div class="relative mx-auto max-w-6xl px-4 py-20 md:py-28">
        <nav class="mb-6 text-xs font-bold uppercase tracking-[0.22em] text-white/60">
          <a href="/food-culture/" class="hover:text-white">Food & Culture</a>
          <span class="mx-2">/</span>
          <span>{entry.data.category || 'Experience'}</span>
        </nav>
        <p class="text-sm font-bold uppercase tracking-[0.24em] text-blue-200">{entry.data.experience_type || entry.data.category || 'Food & Culture'}</p>
        <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-tight md:text-6xl">{entry.data.title}</h1>
        {entry.data.subtitle && <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-200">{entry.data.subtitle}</p>}
      </div>
    </section>

    <section class="mx-auto grid max-w-6xl gap-8 px-4 py-12 lg:grid-cols-[1fr_320px]">
      <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm md:p-10">
        <div class="prose prose-slate max-w-none prose-headings:font-bold prose-h2:text-2xl prose-h2:mt-9 prose-h2:mb-4 prose-h3:text-xl prose-p:leading-8 prose-li:leading-7">
          <Content />
        </div>

        {isExperience && <RelatedTourCards tours={entry.data.related_tours} title="Tours that can include this experience" intro="These cards link to actual AfghanTours itineraries or to Custom Tours where this experience can be added intentionally." />}
      </article>

      <aside class="space-y-5">
        <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
          <p class="text-xs font-bold uppercase tracking-[0.22em] text-blue-700">Traveler notes</p>
          <dl class="mt-4 space-y-4 text-sm">
            {entry.data.best_season && <div><dt class="font-bold text-slate-900">Best season</dt><dd class="mt-1 text-slate-600">{entry.data.best_season}</dd></div>}
            {entry.data.provinces?.length > 0 && <div><dt class="font-bold text-slate-900">Common locations</dt><dd class="mt-2 flex flex-wrap gap-2">{entry.data.provinces.map((prov: string) => <span class="rounded-full bg-white px-3 py-1 text-xs font-bold text-slate-700 ring-1 ring-slate-200">{prov}</span>)}</dd></div>}
            {entry.data.paired_foods?.length > 0 && <div><dt class="font-bold text-slate-900">Cultural pairing</dt><dd class="mt-2 flex flex-wrap gap-2">{entry.data.paired_foods.map((food: string) => <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-bold text-amber-800 ring-1 ring-amber-200">{food}</span>)}</dd></div>}
          </dl>
        </div>

        <div class="rounded-3xl border border-blue-100 bg-blue-50 p-5">
          <h2 class="text-lg font-bold text-slate-950">Build it into a trip</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">Most cultural experiences depend on season, local access, timing, and host availability. AfghanTours can build them into Kabul-based routes, featured tours, or custom itineraries.</p>
          <a href="/contact/" class="mt-4 inline-flex rounded-full bg-slate-950 px-5 py-3 text-sm font-bold text-white hover:bg-slate-800">Start the conversation today</a>
        </div>
      </aside>
    </section>
  </main>
</BaseLayout>
