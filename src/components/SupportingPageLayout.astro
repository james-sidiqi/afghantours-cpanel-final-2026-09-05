---
const { eyebrow = 'Planning', title = '', intro = '', image = '', mapImage = '', contentHtml = '', compact = false } = Astro.props;
---
<section class="supporting-page" class:list={[compact && 'is-compact']}>
  <div class="supporting-page__inner">
    <header class="supporting-page__header">
      <div>
        <p>{eyebrow}</p>
        <h1>{title}</h1>
        {intro && <div class="supporting-page__intro">{intro}</div>}
      </div>
      {(image || mapImage) && (
        <aside class="supporting-page__visual">
          {image && <img src={image} alt="" loading="lazy" onerror="this.style.display='none'" />}
          {mapImage && <img src={mapImage} alt={`${title} map`} loading="lazy" onerror="this.style.display='none'" />}
        </aside>
      )}
    </header>
    <article class="supporting-page__body editorial-prose" set:html={contentHtml || ''} />
    <section class="supporting-page__cta">
      <p>Have a question about planning travel in Afghanistan?</p>
      <div><a href="/contact/">Contact AfghanTours</a><a href="/tours/">View Tours</a></div>
    </section>
  </div>
</section>

<style>
  .supporting-page { background: #fbf8f2; color:#11100d; padding: clamp(3rem, 7vw, 6rem) 0; }
  .supporting-page__inner { width:min(980px, calc(100% - 2rem)); margin:0 auto; }
  .supporting-page__header { display:grid; grid-template-columns: 1fr minmax(260px, 0.52fr); gap:2rem; align-items:start; margin-bottom:2rem; }
  .supporting-page__header p { margin:0 0 0.85rem; color:#b45309; font-size:0.72rem; font-weight:900; letter-spacing:0.28em; text-transform:uppercase; }
  .supporting-page__header h1 { margin:0; font-family:Georgia,'Times New Roman',serif; font-size:clamp(3rem,6vw,5rem); line-height:0.92; letter-spacing:-0.055em; }
  .supporting-page__intro { max-width:720px; margin-top:1.3rem; font-size:1.08rem; line-height:1.8; color:#4b463d; }
  .supporting-page__visual { overflow:hidden; border-radius:2rem; background:#efe7da; box-shadow:0 18px 46px rgba(0,0,0,0.10); ring:1px solid rgba(0,0,0,0.06); }
  .supporting-page__visual img { width:100%; max-height:360px; object-fit:cover; display:block; }
  .supporting-page__visual img + img { object-fit:contain; padding:1rem; background:#efe7da; }
  .supporting-page__body { background:#fffaf0; border:1px solid rgba(17,16,13,0.08); border-radius:2rem; padding:clamp(1.5rem, 4vw, 3rem); box-shadow:0 18px 46px rgba(0,0,0,0.06); }
  .supporting-page__body :global(h2), .supporting-page__body :global(h3) { font-family:Georgia,'Times New Roman',serif; letter-spacing:-0.035em; }
  .supporting-page__body :global(p), .supporting-page__body :global(li) { line-height:1.8; }
  .supporting-page__cta { margin-top:2rem; text-align:center; border-radius:2rem; background:#071b12; color:#fff8ec; padding:2rem; }
  .supporting-page__cta p { margin:0; font-family:Georgia,'Times New Roman',serif; font-size:clamp(1.8rem,4vw,3rem); font-weight:900; line-height:1; }
  .supporting-page__cta div { display:flex; justify-content:center; gap:0.75rem; flex-wrap:wrap; margin-top:1.5rem; }
  .supporting-page__cta a { border-radius:999px; padding:0.85rem 1.15rem; text-decoration:none; font-size:0.88rem; font-weight:900; }
  .supporting-page__cta a:first-child { background:#d9a12d; color:#11100d; } .supporting-page__cta a:last-child { color:#fff8ec; border:1px solid rgba(255,255,255,0.2); }
  @media (max-width: 860px) { .supporting-page__header { grid-template-columns:1fr; } }
</style>
