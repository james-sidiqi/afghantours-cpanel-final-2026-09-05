---
const {
  eyebrow = 'AfghanTours',
  title = 'Afghanistan, planned with care',
  text = '',
  image = '/assets/images/heroes/default-hero.webp',
  video = '',
  poster = '',
  primaryHref = '',
  primaryLabel = '',
  secondaryHref = '',
  secondaryLabel = '',
  height = 'min-h-[76vh]'
} = Astro.props;
---
<section class={`relative ${height} overflow-hidden bg-stone-950 text-white`}>
  {video ? (
    <video
      class="absolute inset-0 h-full w-full object-cover opacity-65"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={poster || image}
      aria-label={title}
    >
      <source src={video} />
    </video>
  ) : (
    <img src={image} alt={title} class="absolute inset-0 h-full w-full object-cover opacity-65" />
  )}
  <div class="absolute inset-0 bg-gradient-to-r from-black via-black/70 to-black/20"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent"></div>
  <div class={`relative mx-auto flex ${height} max-w-7xl flex-col justify-end px-6 py-20`}>
    <p class="mb-5 text-xs font-black uppercase tracking-[0.32em] text-amber-300">{eyebrow}</p>
    <h1 class="editorial-title max-w-5xl text-5xl font-black leading-[0.95] text-white drop-shadow-2xl md:text-7xl">{title}</h1>
    {text && <p class="mt-7 max-w-2xl text-lg leading-8 text-stone-200 md:text-xl">{text}</p>}
    {(primaryHref || secondaryHref) && (
      <div class="mt-9 flex flex-wrap gap-4">
        {primaryHref && <a href={primaryHref} class="rounded-full bg-amber-400 px-7 py-4 text-sm font-black text-stone-950 transition hover:bg-white">{primaryLabel}</a>}
        {secondaryHref && <a href={secondaryHref} class="rounded-full border border-white/35 px-7 py-4 text-sm font-black text-white transition hover:bg-white hover:text-stone-950">{secondaryLabel}</a>}
      </div>
    )}
  </div>
</section>
