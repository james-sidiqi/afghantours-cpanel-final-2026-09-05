---
const {
  attractions = [],
  title = "Featured Attractions",
  intro = "",
} = Astro.props;

function imageFor(item) {
  return (
    item?.hero_image_path ||
    item?.card_image_path ||
    item?.hero_image ||
    item?.card_image ||
    item?.image_path ||
    item?.image ||
    "/assets/images/placeholders/default-card.webp"
  );
}

function summaryFor(item) {
  return (
    item?.short_description ||
    item?.summary ||
    item?.desc_short ||
    item?.description ||
    ""
  );
}

const featured = attractions.slice(0, 8);
---

{featured.length > 0 && (
  <section class="tour-attraction-summary">
    <div class="tour-attraction-wrap">
      <header>
        <p>Route Highlights</p>
        <h2>{title}</h2>

        {intro && <span>{intro}</span>}
      </header>

      <div class="tour-attraction-grid">
        {featured.map((item) => (
          <a
            class="tour-attraction-card"
            href={item.slug ? `/attractions/${item.slug}/` : "#itinerary"}
          >
            <img
              src={imageFor(item)}
              alt={item.name || item.title || "Tour attraction"}
              loading="lazy"
            />

            <div>
              <p>{item.category || "Attraction"}</p>
              <h3>{item.name || item.title}</h3>

              {summaryFor(item) && (
                <span>{summaryFor(item)}</span>
              )}

              <strong>Explore attraction →</strong>
            </div>
          </a>
        ))}
      </div>

      {attractions.length > featured.length && (
        <p class="tour-attraction-more">
          Additional route stops are listed in the day-by-day itinerary above.
        </p>
      )}
    </div>
  </section>
)}

<style>
  .tour-attraction-summary {
    background: #fbf8f2;
    color: #101820;
    padding: clamp(4rem, 7vw, 7rem) 0;
  }

  .tour-attraction-wrap {
    width: min(1180px, calc(100% - 2rem));
    margin: auto;
  }

  .tour-attraction-wrap > header {
    max-width: 760px;
    margin-bottom: 2rem;
  }

  .tour-attraction-wrap > header > p {
    margin: 0;
    color: #a4650d;
    font-size: .7rem;
    font-weight: 900;
    letter-spacing: .2em;
    text-transform: uppercase;
  }

  .tour-attraction-wrap > header h2 {
    margin: .5rem 0 .8rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.5rem, 4.7vw, 4.4rem);
    line-height: .96;
    letter-spacing: -.05em;
  }

  .tour-attraction-wrap > header span {
    display: block;
    color: #5b6368;
    line-height: 1.7;
  }

  .tour-attraction-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0,1fr));
    gap: .8rem;
  }

  .tour-attraction-card {
    overflow: hidden;
    border: 1px solid rgba(16,24,32,.08);
    border-radius: 1.15rem;
    background: #fff;
    color: inherit;
    text-decoration: none;
    transition: transform .22s ease, box-shadow .22s ease;
  }

  .tour-attraction-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 38px rgba(16,24,32,.1);
  }

  .tour-attraction-card img {
    display: block;
    width: 100%;
    height: 170px;
    object-fit: cover;
  }

  .tour-attraction-card > div {
    padding: 1rem;
  }

  .tour-attraction-card p {
    margin: 0;
    color: #a4650d;
    font-size: .62rem;
    font-weight: 900;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .tour-attraction-card h3 {
    margin: .35rem 0 .55rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.35rem;
    line-height: 1.05;
    letter-spacing: -.03em;
  }

  .tour-attraction-card span {
    display: -webkit-box;
    overflow: hidden;
    color: #5c6368;
    font-size: .81rem;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .tour-attraction-card strong {
    display: block;
    margin-top: .8rem;
    color: #8f5d0d;
    font-size: .75rem;
  }

  .tour-attraction-more {
    margin: 1rem 0 0;
    color: #656b6f;
    font-size: .82rem;
  }

  @media (max-width: 980px) {
    .tour-attraction-grid {
      grid-template-columns: repeat(2, minmax(0,1fr));
    }
  }

  @media (max-width: 560px) {
    .tour-attraction-grid {
      grid-template-columns: 1fr;
    }

    .tour-attraction-card {
      display: grid;
      grid-template-columns: 120px minmax(0, 1fr);
    }

    .tour-attraction-card img {
      height: 100%;
      min-height: 150px;
    }
  }
</style>
