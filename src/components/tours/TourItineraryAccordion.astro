---
const { itinerary = [] } = Astro.props;
---
<section class="bg-white py-16 text-stone-950">
  <div class="mx-auto max-w-5xl px-6">
    <p class="text-xs font-black uppercase tracking-[0.28em] text-amber-700">Day by Day</p>
    <h2 class="editorial-title mt-3 text-4xl font-black md:text-6xl">Itinerary</h2>
    <div class="mt-9 grid gap-4">
      {itinerary.map((day, index) => (
        <details class="group rounded-[1.5rem] border border-stone-200 bg-[#fbf8f2] p-5 open:bg-white open:shadow-lg" open={index === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-5">
            <div>
              <p class="text-xs font-black uppercase tracking-[0.18em] text-amber-700">Day {day.day_number || index + 1}</p>
              <h3 class="editorial-title mt-1 text-2xl font-black">{day.title || day.location || `Day ${index + 1}`}</h3>
            </div>
            <span class="rounded-full bg-stone-950 px-3 py-1 text-sm font-black text-white group-open:bg-amber-500">+</span>
          </summary>
          <div class="mt-5 grid gap-5 border-t border-stone-200 pt-5 md:grid-cols-[1fr_0.38fr]">
            <div class="leading-8 text-stone-700">{day.description}</div>
            <aside class="rounded-2xl bg-stone-100 p-4 text-sm leading-6 text-stone-600">
              {day.location && <p><strong class="text-stone-950">Location:</strong> {day.location}</p>}
              {day.drive_time_notes && <p class="mt-2"><strong class="text-stone-950">Drive:</strong> {day.drive_time_notes}</p>}
              {day.flight_id && <p class="mt-2"><strong class="text-stone-950">Flight:</strong> {day.flight_id}</p>}
              {day.attraction_codes && <p class="mt-2"><strong class="text-stone-950">Attractions:</strong> {day.attraction_codes}</p>}
            </aside>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
