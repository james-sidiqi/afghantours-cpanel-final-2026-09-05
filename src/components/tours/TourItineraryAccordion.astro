---
import { attractions, locations, hotels } from "../../lib/data";

const { itinerary = [] } = Astro.props;

const attractionByCode = new Map(
  attractions.map((item) => [String(item.attraction_code || "").trim(), item])
);

function parseCodes(value) {
  return String(value || "")
    .split(/[|;,]/)
    .map((item) => item.trim())
    .filter(Boolean);
}

function titleCaseHyphen(value) {
  return String(value || "")
    .split("-")
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join("-");
}

function dayAttractions(day) {
  return parseCodes(day.attraction_codes)
    .map((code) => attractionByCode.get(code))
    .filter(Boolean);
}

function isHub(location) {
  return (
    String(location.type || "").toLowerCase().includes("hub") ||
    String(location.location_type || "").toLowerCase().includes("hub") ||
    String(location.is_hub || "").toLowerCase() === "true" ||
    String(location.is_hub || "") === "1"
  );
}

function hubSlug(hub) {
  const slug = hub?.slug || hub?.location_slug || hub?.hub_slug;
  return slug === "mazar-e-sharif-city" ? "mazar-e-sharif" : slug;
}

function hubName(hub) {
  return hub?.name || hub?.location_name || hub?.hub_name || hub?.title;
}

function hubDisplayName(hub) {
  const slug = hubSlug(hub);
  if (slug) return titleCaseHyphen(slug);
  return hubName(hub) || "Overnight Hub";
}

function hubImage(hub) {
  return (
    hub?.hero_image_path ||
    hub?.card_image_path ||
    hub?.image_path ||
    hub?.hero_image ||
    hub?.card_image ||
    "/assets/images/placeholders/default-card.webp"
  );
}

function findHub(day) {
  const raw = String(day.overnight_hub || day.hub || day.location || "").toLowerCase().trim();
  if (!raw) return null;

  const clean = raw.replace(/\s+/g, "-");

  const matches = locations.filter((location) => {
    if (!isHub(location)) return false;

    const text = [
      location.name,
      location.location_name,
      location.hub_name,
      location.slug,
      location.location_slug,
      location.hub_slug,
    ]
      .join(" ")
      .toLowerCase();

    return text.includes(raw) || text.includes(clean);
  });

  return (
    matches.find((hub) => String(hubSlug(hub) || "").toLowerCase() === `${clean}-city`) ||
    matches.find((hub) => String(hubSlug(hub) || "").toLowerCase().includes(`${clean}-city`)) ||
    matches[0] ||
    null
  );
}

function attractionImage(attraction) {
  return (
    attraction.hero_image ||
    attraction.hero_image_path ||
    attraction.card_image ||
    attraction.card_image_path ||
    attraction.image_path ||
    (attraction.slug ? `/assets/images/attractions/${attraction.slug}/hero.webp` : null) ||
    "/assets/images/placeholders/default-attraction.webp"
  );
}

function attractionSummary(attraction) {
  return (
    attraction.desc_short ||
    attraction.short_description ||
    attraction.summary ||
    attraction.description ||
    attraction.desc_long ||
    attraction.long_description ||
    "A featured stop included in this day of the itinerary."
  );
}

function attractionLong(attraction) {
  const long = String(
    attraction.desc_long ||
    attraction.long_description ||
    attraction.description ||
    attraction.desc_short ||
    attraction.short_description ||
    ""
  ).trim();
  if (long) return long;
  return attractionSummary(attraction);
}

function attractionLocation(attraction) {
  return [attraction.province, attraction.region].filter(Boolean).join(" · ") || "";
}

function attractionTags(attraction) {
  return String(attraction.tags || "")
    .split(/[,|#]/)
    .map((t) => t.trim())
    .filter(Boolean)
    .slice(0, 6);
}

function attractionPractical(attraction) {
  const notes = [];
  if (attraction.visit_duration_hours) notes.push(["Duration", `${attraction.visit_duration_hours} hours`]);
  if (attraction.access_difficulty) notes.push(["Access", String(attraction.access_difficulty)]);
  const season = [attraction.season_start, attraction.season_end].filter(Boolean).join("–");
  if (season) notes.push(["Season", season]);
  if (attraction.seasonal_notes) notes.push(["Season note", String(attraction.seasonal_notes)]);
  if (attraction.recommended_time_of_day) notes.push(["Best time", String(attraction.recommended_time_of_day)]);
  if (attraction.photography_rating) notes.push(["Photography", String(attraction.photography_rating)]);
  if (attraction.cultural_sensitivity) notes.push(["Sensitivity", String(attraction.cultural_sensitivity)]);
  if (attraction.notes) notes.push(["Notes", String(attraction.notes)]);
  return notes;
}

function hotelName(hotel) {
  return hotel.display_name || hotel.hotel_name || hotel.name || "Hotel Option";
}

function hotelImage(hotel) {
  return (
    hotel.image_path_property_1 ||
    hotel.image_path_property_2 ||
    hotel.image_path_property_3 ||
    hotel.hero_image ||
    hotel.card_image ||
    "/assets/images/placeholders/default-card.webp"
  );
}

function hotelTier(hotel) {
  return String(hotel.tier || hotel.category || hotel.price_tier || hotel.class || "standard").toLowerCase();
}

function hotelsForHub(hub) {
  if (!hub) return [];

  const tokens = [
    hubName(hub),
    hubSlug(hub),
    String(hubSlug(hub) || "").replace("-city", ""),
  ]
    .filter(Boolean)
    .map((item) => String(item).toLowerCase());

  return hotels
    .filter((hotel) => {
      const text = [
        hotel.hub,
        hotel.hub_name,
        hotel.destination_code,
        hotel.city,
        hotel.location,
        hotel.hotel_slug,
        hotel.slug,
        hotel.display_name,
        hotel.name,
        hotel.description,
      ]
        .join(" ")
        .toLowerCase();

      return tokens.some((token) => text.includes(token));
    })
    .slice(0, 8);
}

function standardHotelsForHub(hub) {
  return hotelsForHub(hub).filter((hotel) => {
    const tier = hotelTier(hotel);
    return !tier.includes("premium") && !tier.includes("luxury") && !tier.includes("luxurious");
  });
}

function upgradedHotelsForHub(hub) {
  return hotelsForHub(hub).filter((hotel) => {
    const tier = hotelTier(hotel);
    return tier.includes("premium") || tier.includes("luxury") || tier.includes("luxurious");
  });
}
---

<section class="bg-white py-16 text-stone-950">
  <div class="mx-auto max-w-6xl px-6">
    <p class="text-xs font-black uppercase tracking-[0.28em] text-amber-700">Day by Day</p>
    <h2 class="editorial-title mt-3 text-4xl font-black md:text-6xl">Itinerary</h2>

    <div class="mt-9 grid gap-5">
      {itinerary.map((day, index) => {
        const hub = findHub(day);
        const attractionsForDay = dayAttractions(day);
        const standardHotels = standardHotelsForHub(hub);
        const upgradeHotels = upgradedHotelsForHub(hub);

        const attractionDialogId = `attractions-day-${index}`;
        const hotelDialogId = `hotels-day-${index}`;

        const defaultPreviewImage =
          attractionsForDay[0] ? attractionImage(attractionsForDay[0]) : hubImage(hub);

        const defaultPreviewTitle =
          attractionsForDay[0]?.name || hubDisplayName(hub);

        const defaultPreviewText =
          attractionsForDay[0] ? attractionSummary(attractionsForDay[0]) : "Hover over an attraction card to preview details here.";

        return (
          <details
            class="group rounded-[1.5rem] border border-stone-200 bg-white p-5 shadow-lg open:bg-white"
            open={index === 0}
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-5">
              <div>
                <p class="text-xs font-black uppercase tracking-[0.18em] text-amber-700">
                  Day {day.day_number || index + 1}
                </p>
                <h3 class="editorial-title mt-1 text-2xl font-black">
                  {day.title || day.location || `Day ${index + 1}`}
                </h3>
              </div>

              <span class="rounded-full bg-stone-950 px-3 py-1 text-sm font-black text-white group-open:bg-amber-500">
                +
              </span>
            </summary>

            <div class="mt-5 grid gap-5 border-t border-stone-200 pt-5 lg:grid-cols-[1fr_320px]">
              <div>
                <div class="max-w-3xl leading-8 text-stone-700">{day.description}</div>

                {attractionsForDay.length > 0 && (
                  <div class="mt-6">
                    <div class="flex items-center justify-between gap-4">
                      <h4 class="text-lg font-black text-stone-950">Attractions This Day</h4>

                      <button
                        type="button"
                        onclick={`document.getElementById('${attractionDialogId}').showModal()`}
                        class="rounded-full bg-stone-950 px-4 py-2 text-xs font-black text-white transition hover:bg-amber-600"
                      >
                        View All
                      </button>
                    </div>

                    <div class="mt-4 grid gap-4 md:grid-cols-2">
                      {attractionsForDay.map((attraction, aIndex) => {
                        const detailId = `${attractionDialogId}-detail-${aIndex}`;
                        return (
                        <button
                          type="button"
                          onclick={`document.getElementById('${detailId}').showModal()`}
                          data-preview-card
                          data-preview-title={attraction.name}
                          data-preview-image={attractionImage(attraction)}
                          data-preview-text={attractionSummary(attraction)}
                          class="group/card overflow-hidden rounded-[1.25rem] bg-[#fbf8f2] text-left shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
                        >
                          <img
                            src={attractionImage(attraction)}
                            alt={attraction.name}
                            loading="lazy"
                            class="h-40 w-full object-cover"
                          />
                          <div class="p-4">
                            <p class="text-[10px] font-black uppercase tracking-[0.18em] text-amber-700">
                              {attraction.category || "Attraction"}
                            </p>
                            <h5 class="mt-1 text-base font-black text-stone-950">
                              {attraction.name}
                            </h5>
                            <p class="mt-2 line-clamp-2 text-xs leading-5 text-stone-700">
                              {attractionSummary(attraction)}
                            </p>
                          </div>
                        </button>
                        );
                      })}
                    </div>
                  </div>
                )}
              </div>

              <aside
                data-day-preview
                class="rounded-[1.5rem] bg-stone-100 p-4 text-sm leading-6 text-stone-700"
              >
                <div class="overflow-hidden rounded-2xl bg-stone-950">
                  <img
                    data-preview-image-target
                    src={defaultPreviewImage}
                    alt={defaultPreviewTitle}
                    loading="lazy"
                    class="h-44 w-full object-cover"
                  />
                </div>

                <div class="mt-4">
                  <p class="text-xs font-black uppercase tracking-[0.18em] text-amber-700">
                    Day Context
                  </p>

                  <h4 data-preview-title-target class="mt-1 text-xl font-black text-stone-950">
                    {defaultPreviewTitle}
                  </h4>

                  <p data-preview-text-target class="mt-2 text-sm leading-6 text-stone-700">
                    {defaultPreviewText}
                  </p>
                </div>

                <div class="mt-4 rounded-2xl bg-white p-4">
                  {day.location && (
                    <p>
                      <strong class="text-stone-950">Location:</strong> {day.location}
                    </p>
                  )}

                  {hub && (
                    <p class="mt-2">
                      <strong class="text-stone-950">Overnight:</strong>{" "}
                      {hubSlug(hub) ? (
                        <a href={`/hubs/${hubSlug(hub)}/`} class="font-black text-amber-700 hover:underline">
                          {hubDisplayName(hub)}
                        </a>
                      ) : (
                        hubDisplayName(hub)
                      )}
                    </p>
                  )}

                  {day.provinces_traversed && (
                    <p class="mt-2">
                      <strong class="text-stone-950">Province:</strong> {day.provinces_traversed}
                    </p>
                  )}

                  {day.drive_time_notes && (
                    <p class="mt-2">
                      <strong class="text-stone-950">Drive:</strong> {day.drive_time_notes}
                    </p>
                  )}

                  {standardHotels.length > 0 && (
                    <button
                      type="button"
                      onclick={`document.getElementById('${hotelDialogId}').showModal()`}
                      class="mt-4 w-full rounded-full bg-stone-950 px-4 py-2 text-xs font-black text-white transition hover:bg-amber-600"
                    >
                      View Hotel Options
                    </button>
                  )}
                </div>
              </aside>
            </div>

            <!-- ATTRACTION LIST POPUP -->
            <dialog id={attractionDialogId} class="attraction-itinerary-dialog w-[min(980px,96vw)] max-w-none rounded-[1.5rem] p-0 backdrop:bg-black/70 sm:rounded-[2rem]">
              <div class="max-h-[90vh] overflow-y-auto overscroll-contain bg-white text-stone-950">
                <div class="sticky top-0 z-10 flex items-center justify-between gap-3 border-b border-stone-200 bg-white p-4 sm:p-5">
                  <div>
                    <p class="text-xs font-black uppercase tracking-[0.22em] text-amber-700">
                      Day {day.day_number || index + 1}
                    </p>
                    <h3 class="text-xl font-black sm:text-2xl">Attractions this day</h3>
                  </div>

                  <button
                    type="button"
                    onclick={`document.getElementById('${attractionDialogId}').close()`}
                    class="rounded-full bg-stone-950 px-4 py-2 text-sm font-black text-white"
                  >
                    Close
                  </button>
                </div>

                <div class="grid gap-4 p-4 sm:grid-cols-2 sm:p-5">
                  {attractionsForDay.map((attraction, aIndex) => {
                    const detailId = `${attractionDialogId}-detail-${aIndex}`;
                    return (
                    <button
                      type="button"
                      onclick={`document.getElementById('${attractionDialogId}').close(); document.getElementById('${detailId}').showModal()`}
                      class="overflow-hidden rounded-[1.25rem] bg-[#fbf8f2] text-left shadow-sm"
                    >
                      <img src={attractionImage(attraction)} alt={attraction.name} loading="lazy" class="h-44 w-full object-cover" />
                      <div class="p-4">
                        <p class="text-[10px] font-black uppercase tracking-[0.18em] text-amber-700">{attraction.category || "Attraction"}</p>
                        <h4 class="mt-1 text-lg font-black">{attraction.name}</h4>
                        <p class="mt-2 line-clamp-3 text-sm leading-6 text-stone-700">{attractionSummary(attraction)}</p>
                      </div>
                    </button>
                    );
                  })}
                </div>
              </div>
            </dialog>

            {/* Per-attraction detail sheets */}
            {attractionsForDay.map((attraction, aIndex) => {
              const detailId = `${attractionDialogId}-detail-${aIndex}`;
              const practical = attractionPractical(attraction);
              const tags = attractionTags(attraction);
              const location = attractionLocation(attraction);
              return (
                <dialog id={detailId} class="attraction-itinerary-dialog w-[min(720px,96vw)] max-w-none rounded-[1.5rem] p-0 backdrop:bg-black/70 sm:rounded-[2rem]">
                  <div class="flex max-h-[92vh] flex-col overflow-hidden bg-white text-stone-950">
                    <div class="sticky top-0 z-10 flex items-center justify-between gap-3 border-b border-stone-200 bg-white p-4">
                      <button
                        type="button"
                        onclick={`document.getElementById('${detailId}').close(); document.getElementById('${attractionDialogId}').showModal()`}
                        class="rounded-full border border-stone-300 px-3 py-2 text-xs font-black text-stone-800"
                      >
                        ← Back to itinerary day
                      </button>
                      <button
                        type="button"
                        onclick={`document.getElementById('${detailId}').close()`}
                        class="rounded-full bg-stone-950 px-4 py-2 text-sm font-black text-white"
                      >
                        Close
                      </button>
                    </div>

                    <div class="overflow-y-auto overscroll-contain">
                      <img
                        src={attractionImage(attraction)}
                        alt={attraction.name}
                        loading="lazy"
                        class="max-h-[42vh] w-full object-cover sm:max-h-[48vh]"
                      />
                      <div class="space-y-4 p-5 sm:p-6">
                        <div>
                          <p class="text-xs font-black uppercase tracking-[0.22em] text-amber-700">
                            Day {day.day_number || index + 1} · {attraction.category || "Attraction"}
                          </p>
                          <h3 class="mt-2 text-2xl font-black sm:text-3xl">{attraction.name}</h3>
                          {location && <p class="mt-1 text-sm font-semibold text-stone-600">{location}</p>}
                        </div>

                        {tags.length > 0 && (
                          <div class="flex flex-wrap gap-2">
                            {tags.map((tag) => (
                              <span class="rounded-full bg-stone-100 px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-stone-700">{tag}</span>
                            ))}
                          </div>
                        )}

                        <div>
                          <p class="text-xs font-black uppercase tracking-[0.18em] text-amber-700">About this stop</p>
                          <p class="mt-2 text-sm leading-7 text-stone-700 sm:text-base">{attractionLong(attraction)}</p>
                        </div>

                        <div class="rounded-2xl bg-stone-50 p-4">
                          <p class="text-xs font-black uppercase tracking-[0.18em] text-amber-700">Itinerary context</p>
                          <p class="mt-2 text-sm leading-6 text-stone-700">
                            Included on Day {day.day_number || index + 1}{day.title ? ` — ${day.title}` : ""}{day.location ? ` (${day.location})` : ""}.
                          </p>
                        </div>

                        {practical.length > 0 && (
                          <div>
                            <p class="text-xs font-black uppercase tracking-[0.18em] text-amber-700">Traveler notes</p>
                            <dl class="mt-3 grid gap-2">
                              {practical.map(([label, value]) => (
                                <div class="grid grid-cols-[120px_1fr] gap-3 text-sm">
                                  <dt class="font-black text-stone-950">{label}</dt>
                                  <dd class="text-stone-700">{value}</dd>
                                </div>
                              ))}
                            </dl>
                          </div>
                        )}

                        {attraction.slug && (
                          <a
                            href={`/attractions/${attraction.slug}/`}
                            class="inline-flex rounded-full bg-stone-950 px-5 py-3 text-sm font-black text-white transition hover:bg-amber-600"
                          >
                            Explore {attraction.name}
                          </a>
                        )}
                      </div>
                    </div>
                  </div>
                </dialog>
              );
            })}

            <!-- HOTEL POPUP -->
            <dialog id={hotelDialogId} class="w-[min(920px,92vw)] rounded-[2rem] p-0 backdrop:bg-black/70">
              <div class="max-h-[86vh] overflow-y-auto bg-white text-stone-950">
                <div class="sticky top-0 z-10 flex items-center justify-between border-b border-stone-200 bg-white p-5">
                  <div>
                    <p class="text-xs font-black uppercase tracking-[0.22em] text-amber-700">
                      {hub ? hubDisplayName(hub) : "Hotel Options"}
                    </p>
                    <h3 class="text-2xl font-black">Hotel Options</h3>
                  </div>

                  <button
                    type="button"
                    onclick={`document.getElementById('${hotelDialogId}').close()`}
                    class="rounded-full bg-stone-950 px-4 py-2 text-sm font-black text-white"
                  >
                    Close
                  </button>
                </div>

                <div class="p-5">
                  <div class="rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm leading-6 text-stone-800">
                    Standard hotel options are used for base tour planning unless otherwise stated. Premium and luxury upgrades may be available in this city, but they increase the final tour price and are not included in the base price shown on the tour page.
                  </div>

                  <h4 class="mt-6 text-xl font-black">Standard Hotel Options</h4>

                  <div class="mt-4 grid gap-5 md:grid-cols-2">
                    {(standardHotels.length ? standardHotels : hotelsForHub(hub).slice(0, 4)).map((hotel) => (
                      <article class="overflow-hidden rounded-[1.5rem] bg-[#fbf8f2] shadow-sm">
                        <img src={hotelImage(hotel)} alt={hotelName(hotel)} loading="lazy" class="h-48 w-full object-cover" />
                        <div class="p-5">
                          <p class="text-xs font-black uppercase tracking-[0.18em] text-amber-700">
                            {hotel.tier || hotel.category || "Standard"}
                          </p>
                          <h5 class="mt-2 text-lg font-black">{hotelName(hotel)}</h5>
                          <p class="mt-3 text-sm leading-6 text-stone-700">
                            {hotel.description || hotel.summary || hotel.best_for || "Hotel option used according to availability and route requirements."}
                          </p>

                          {(hotel.slug || hotel.hotel_slug) && (
                            <a
                              href={`/hotels/${hotel.slug || hotel.hotel_slug}/`}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="mt-4 inline-flex rounded-full bg-stone-950 px-4 py-2 text-xs font-black text-white"
                            >
                              View Hotel Page
                            </a>
                          )}
                        </div>
                      </article>
                    ))}
                  </div>

                  {upgradeHotels.length > 0 && (
                    <>
                      <h4 class="mt-8 text-xl font-black">Premium & Luxury Upgrade Options</h4>
                      <p class="mt-2 text-sm leading-6 text-stone-700">
                        These options are shown for comparison and may be available at additional cost.
                      </p>

                      <div class="mt-4 grid gap-5 md:grid-cols-2">
                        {upgradeHotels.map((hotel) => (
                          <article class="overflow-hidden rounded-[1.5rem] bg-stone-950 text-white shadow-sm">
                            <img src={hotelImage(hotel)} alt={hotelName(hotel)} loading="lazy" class="h-48 w-full object-cover" />
                            <div class="p-5">
                              <p class="text-xs font-black uppercase tracking-[0.18em] text-amber-300">
                                {hotel.tier || hotel.category || "Upgrade"}
                              </p>
                              <h5 class="mt-2 text-lg font-black">{hotelName(hotel)}</h5>
                              <p class="mt-3 text-sm leading-6 text-stone-200">
                                {hotel.description || hotel.summary || "Premium or luxury hotel option subject to availability and additional cost."}
                              </p>
                            </div>
                          </article>
                        ))}
                      </div>
                    </>
                  )}
                </div>
              </div>
            </dialog>
          </details>
        );
      })}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll("[data-preview-card]").forEach((card) => {
    card.addEventListener("mouseenter", () => {
      const wrapper = card.closest("details");
      if (!wrapper) return;

      const titleTarget = wrapper.querySelector("[data-preview-title-target]");
      const imageTarget = wrapper.querySelector("[data-preview-image-target]");
      const textTarget = wrapper.querySelector("[data-preview-text-target]");

      const title = card.getAttribute("data-preview-title");
      const image = card.getAttribute("data-preview-image");
      const text = card.getAttribute("data-preview-text");

      if (titleTarget && title) titleTarget.textContent = title;
      if (imageTarget && image) imageTarget.setAttribute("src", image);
      if (textTarget && text) textTarget.textContent = text;
    });
  });
</script>