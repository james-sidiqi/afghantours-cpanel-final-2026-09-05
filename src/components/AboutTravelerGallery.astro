  },
  {
    src: '/assets/images/page-assets/about/travelers/guide-and-traveler.webp',
    alt: 'Afghan guide and traveler during a countryside stop',
    shape: 'standard',
  },
  {
    src: '/assets/images/page-assets/about/travelers/traveler-afghanistan-sign.webp',
    alt: 'Traveler photographed at the Afghanistan sign in Kabul',
    shape: 'tall',
  },
  {
    src: '/assets/images/page-assets/about/travelers/horseback-cultural-experience.webp',
    alt: 'Travelers riding horses along a rural path in Afghanistan',
    shape: 'wide',
