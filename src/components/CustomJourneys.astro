import InteractiveShowcase from './InteractiveShowcase.astro';
const journeys = [
  { title: 'Photography & Documentary Journeys', label: 'Visual Storytelling', description: 'Meaningful access, route planning, local introductions, driver coordination, translator support, and practical field support for visual storytellers.', image: '/assets/images/custom-tours/photography-tour/hero.webp', href: '/contact/?journey=Photography%20%26%20Documentary%20Journeys', cta: 'Discuss this journey', meta: '7–14 days • Photographers • Filmmakers • Visual artists' },
  { title: 'Business & Investment Visits', label: 'Commercial Visits', description: 'Operational support for investors, consultants, and commercial delegations arranging meetings, site visits, transport, translation, and local coordination.', image: '/assets/images/custom-tours/business-investment/hero.webp', href: '/contact/?journey=Business%20%26%20Investment%20Visits', cta: 'Plan a business visit', meta: 'Flexible / 3–10 days • Investors • Consultants' },
  { title: 'Media & Journalism Support', label: 'Media Logistics', description: 'Field support for journalists, documentary crews, photographers, and media teams who need reliable local coordination while working in Afghanistan.', image: '/assets/images/custom-tours/media-support/hero.webp', href: '/contact/?journey=Media%20%26%20Journalism%20Support', cta: 'Request media support', meta: 'Flexible • Journalists • Documentary teams • Fixers' },
