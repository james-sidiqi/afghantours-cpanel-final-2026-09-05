---
/**
 * Legacy component name retained for imports.
 * Cards point at canonical product families — not retired /tours/* URLs.
 */
const cards = [
  {
    title: 'Build My Journey',
    label: 'Custom Journey',
    description: 'Private leisure planning — duration, route, and price set only after scoping with our Kabul team.',
    image: '/assets/images/custom-tours/custom-expedition/hero.webp',
    href: '/custom-requests/',
    cta: 'Build My Journey',
    meta: 'Inquiry-led · Private leisure',
  },
  {
    title: 'Photography & Documentary Support',
    label: 'Specialist service',
    description: 'Route-aware logistics and local coordination for visual storytellers — proposal-led, not a fixed photo package.',
    image: '/assets/images/custom-tours/photography-tour/hero.webp',
    href: '/specialist-services/photography-documentary/',
    cta: 'Request a proposal',
    meta: 'Specialist · Proposal-led',
  },
  {
    title: 'Diaspora & Heritage Return',
    label: 'Return journey',
    description: 'Family and heritage return planning around current access — distinct from leisure tour packages.',
    image: '/assets/images/return-journeys/diaspora/afghan-diaspora-heritage.webp',
    href: '/return-journeys/diaspora/',
    cta: 'Request a return journey',
    meta: 'Return · Inquiry-led',
  },
];
---

<section class="cj-legacy" aria-label="Custom, specialist, and return planning">
  <div class="cj-legacy__wrap">
    {cards.map((card) => (
      <a class="cj-legacy__card" href={card.href}>
        <img src={card.image} alt="" loading="lazy" />
        <div>
          <p>{card.label}</p>
          <h3>{card.title}</h3>
          <p>{card.description}</p>
          <span>{card.cta} →</span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .cj-legacy__wrap { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .cj-legacy__card { display: grid; gap: .75rem; text-decoration: none; color: inherit; border: 1px solid rgba(16,24,32,.1); border-radius: 1rem; overflow: hidden; background: #fffaf2; }
  .cj-legacy__card img { width: 100%; aspect-ratio: 16/10; object-fit: cover; }
  .cj-legacy__card div { padding: 0 1rem 1rem; }
  .cj-legacy__card p:first-child { margin: 0; color: #a86a12; font-size: .68rem; font-weight: 900; letter-spacing: .14em; text-transform: uppercase; }
  .cj-legacy__card h3 { margin: .35rem 0; font-family: Georgia, serif; }
  .cj-legacy__card span { font-weight: 800; }
</style>
