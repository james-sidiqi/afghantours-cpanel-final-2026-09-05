  { title: 'Ski & Winter Expeditions', label: 'Winter Backcountry', description: 'Winter journeys for experienced skiers and mountain travelers interested in Afghanistan’s backcountry terrain, especially around Bamyan and the central highlands.', image: '/assets/images/custom-tours/ski-expeditions/hero.webp', href: '/contact/?journey=Ski%20%26%20Winter%20Expeditions', cta: 'Plan winter travel', meta: '7–12 days • Skiers • Winter teams' },
