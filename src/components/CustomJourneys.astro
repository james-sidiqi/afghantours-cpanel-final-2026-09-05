  { title: 'Historical Afghanistan Circuits', label: 'Living History', description: 'A route through Afghanistan’s ancient cities, citadels, shrines, museums, and historic landscapes, planned around access and cultural context.', image: '/assets/images/page-assets/activities/sightseeing/historical/01.webp', href: '/contact/?journey=Historical%20Afghanistan%20Circuits', cta: 'Discuss this journey', meta: '7–15 days • History travelers • Researchers' },
  { title: 'Silk Road Exploration', label: 'Ancient Crossroads', description: 'A cultural journey through old trade routes, markets, craft traditions, and historic cities that connected Afghanistan to the wider Silk Road world.', image: '/assets/images/featured-tours/treasures-of-silk-road-afghanistan/hero.webp', href: '/contact/?journey=Silk%20Road%20Exploration', cta: 'Explore route', meta: '8–16 days • Cultural travelers • Collectors' },
  { title: 'Afghan Hospitality & Culture', label: 'Local Culture', description: 'A slower, people-focused journey built around food, conversation, hospitality, daily life, and respectful cultural exchange.', image: '/assets/images/page-assets/people/hospitality/bamiyan-tea-house.webp', href: '/contact/?journey=Afghan%20Hospitality%20%26%20Culture', cta: 'Discuss culture trip', meta: '5–12 days • Slow travelers • Food travelers' },
  { title: 'Return & Reflection Journeys', label: 'Personal Return Visits', description: 'Private, respectful planning for former service members, diplomats, contractors, Peace Corps volunteers, NGO employees, and others with a meaningful personal connection to Afghanistan.', image: '/assets/images/custom-tours/veteran-return/hero.webp', href: '/contact/?journey=Return%20%26%20Reflection%20Journeys', cta: 'Plan private return', meta: '5–12 days • Former service members • Diplomats • Contractors' },
  { title: 'Creative & Cultural Residencies', label: 'Creative Residencies', description: 'Custom support for artists, designers, researchers, and creative professionals interested in Afghan craft, architecture, materials, and living traditions.', image: '/assets/images/page-assets/people/cultural-interactions/local-authorities.webp', href: '/contact/?journey=Creative%20%26%20Cultural%20Residencies', cta: 'Design residency', meta: '7–14 days • Artists • Researchers • Curators' },
