    background: #f7f0e6;
    color: #101820;
    padding: clamp(2.5rem, 4.5vw, 4.75rem) 0;
    border-top: 1px solid rgba(16,24,32,.08);
    border-bottom: 1px solid rgba(16,24,32,.08);
  }

  .featured-wrap {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .section-kicker {
    margin: 0;
    color: #b77926;
    font-size: .72rem;
    font-weight: 950;
    letter-spacing: .32em;
    text-transform: uppercase;
  }

  .featured-head {
    max-width: 760px;
    margin-bottom: 1.4rem;
  }

  .featured-head h2 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.25rem, 4.2vw, 4.4rem);
    line-height: .9;
    letter-spacing: -.06em;
    margin: .75rem 0 1rem;
  }

  .featured-head p:not(.section-kicker) {
    color: #3f4a57;
    line-height: 1.75;
    max-width: 58ch;
    margin: 0;
  }

  .featured-active {
    position: relative;
    min-height: 360px;
  }

  .featured-active-card {
    display: none;
    overflow: hidden;
    border: 1px solid rgba(16,24,32,.12);
    border-radius: 2rem;
    background: #fff;
    box-shadow: 0 24px 70px rgba(20,14,8,.12);
