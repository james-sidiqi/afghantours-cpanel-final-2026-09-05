    min-height: 360px;
    background: #101820;
  }

  .featured-active-image img {
    width: 100%;
    height: 100%;
    min-height: 360px;
    object-fit: cover;
    display: block;
  }

  .featured-active-copy {
    padding: clamp(1.6rem, 3vw, 2.7rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .featured-label {
    color: #b77926;
    margin: 0 0 .9rem;
    font-size: .72rem;
    font-weight: 950;
    letter-spacing: .24em;
    text-transform: uppercase;
  }

  .featured-active-copy h3 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.85rem, 3vw, 3.35rem);
    line-height: .94;
    letter-spacing: -.055em;
    margin: 0;
  }

  .featured-meta,
  .featured-modal__meta {
    display: flex;
    flex-wrap: wrap;
    gap: .55rem;
    margin: 1rem 0;
  }

  .featured-meta span,
  .featured-modal__meta span {
    border-radius: 999px;
    background: #f2eadc;
    color: #25303b;
    padding: .45rem .75rem;
    font-size: .72rem;
    font-weight: 900;
  }

  .featured-active-copy p:not(.featured-label) {
    color: #3f4a57;
