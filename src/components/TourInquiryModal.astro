<div class="tour-inquiry-modal" data-tour-inquiry-modal hidden>
  <button class="tour-inquiry-modal__backdrop" type="button" data-tour-inquiry-close aria-label="Close inquiry form"></button>

  <section class="tour-inquiry-modal__panel" role="dialog" aria-modal="true" aria-labelledby="tour-inquiry-title">
    <button class="tour-inquiry-modal__close" type="button" data-tour-inquiry-close aria-label="Close inquiry form">×</button>

    <div class="tour-inquiry-modal__heading">
      <p data-inquiry-eyebrow>Tour inquiry</p>
      <h2 id="tour-inquiry-title">Plan this journey</h2>
      <span data-inquiry-lead>Tell us your dates and group details. Context from the page you were viewing is already filled in.</span>
    </div>

    <form class="tour-inquiry-form" data-tour-inquiry-form action="/tour-inquiry.php" method="post">
      <input type="hidden" name="flow" data-inquiry-flow value="private-fixed" />
      <input type="hidden" name="entity_type" data-inquiry-entity-type value="tour" />
      <input type="hidden" name="entity_code" data-inquiry-entity-code />
      <input type="hidden" name="entity_slug" data-inquiry-entity-slug />
      <input type="hidden" name="entity_name" data-inquiry-entity-name />
      <input type="hidden" name="product_class" data-inquiry-product-class />
      <input type="hidden" name="tour_slug" data-inquiry-tour-slug />
      <input type="hidden" name="tour_url" data-inquiry-tour-url />
      <input type="hidden" name="source_url" data-inquiry-source-url />
      <input type="hidden" name="departure_id" data-inquiry-departure-id />
      <input type="hidden" name="departure_start" data-inquiry-departure-start />
      <input type="hidden" name="departure_end" data-inquiry-departure-end />
      <input type="hidden" name="last_minute" data-inquiry-last-minute />
      <input type="hidden" name="manual_contact" data-inquiry-manual-contact />
      <input type="hidden" name="extras" data-inquiry-extras />
      <input class="tour-inquiry-hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <label class="tour-inquiry-form__full">
        <span data-inquiry-entity-label>Tour</span>
        <input name="tour_name" data-inquiry-tour readonly />
      </label>

      <label class="tour-inquiry-form__full" data-inquiry-departure-row hidden>
        <span>Selected departure</span>
        <input data-inquiry-departure-label readonly />
      </label>

      <div class="tour-inquiry-form__grid">
        <label>
          Shared or private
          <select name="booking_type" data-inquiry-booking-type>
            <option value="">Not sure yet</option>
            <option value="shared">Join a shared group departure</option>
            <option value="private">Private tour</option>
          </select>
        </label>
        <label data-inquiry-arrival-row hidden>
          Arrival
          <select name="arrival_option" data-inquiry-arrival>
            <option value="">No preference</option>
            <option value="fri-sun">Friday–Sunday</option>
            <option value="sat-mon">Saturday–Monday</option>
          </select>
        </label>
      </div>

      <div class="tour-inquiry-form__grid">
        <label>
          Name
          <input name="name" autocomplete="name" required />
        </label>
        <label>
          Country
          <input name="country" autocomplete="country-name" />
        </label>
      </div>

      <div class="tour-inquiry-form__grid">
        <label>
          Email
          <input type="email" name="email" autocomplete="email" />
        </label>
        <label>
          WhatsApp
          <input name="whatsapp" autocomplete="tel" placeholder="Include country code" />
        </label>
      </div>

      <div class="tour-inquiry-form__grid">
        <label>
          Preferred travel dates
          <input name="preferred_dates" data-inquiry-date placeholder="Exact dates, month, or season" />
        </label>
        <label>
          Number of travelers
          <input name="travelers" data-inquiry-travelers type="number" min="1" max="50" step="1" inputmode="numeric" placeholder="e.g. 2" />
        </label>
      </div>

      <p class="tour-inquiry-form__hint" data-inquiry-group-hint hidden aria-live="polite"></p>

      <div class="tour-inquiry-form__grid">
        <label>
          Accommodation preference
          <select name="accommodation">
            <option value="">Standard hotels on the itinerary</option>
            <option value="Upgrade where available">Upgrade where available</option>
            <option value="Discuss with the team">Discuss with the team</option>
          </select>
        </label>
        <label>
          Extra nights (optional)
          <select name="extension_nights">
            <option value="">None</option>
            <option value="1">1 extra night</option>
            <option value="2">2 extra nights</option>
            <option value="3">3 extra nights</option>
            <option value="4+">4 or more</option>
          </select>
        </label>
      </div>

      <fieldset class="tour-inquiry-form__extras" data-inquiry-extras-row hidden>
        <legend>Additional options</legend>
        <label><input type="checkbox" value="Extra hotel night" data-inquiry-extra /> Extra hotel night</label>
        <label><input type="checkbox" value="Additional sightseeing" data-inquiry-extra /> Additional sightseeing</label>
        <label><input type="checkbox" value="Custom arrival/departure arrangements" data-inquiry-extra /> Custom arrival/departure arrangements</label>
      </fieldset>

      <label class="tour-inquiry-form__full">
        Additional requests
        <textarea name="notes" rows="5" placeholder="Interests, pace, hotel preferences, mobility needs, photography, private group requirements, or anything else that will help us plan."></textarea>
      </label>

      <div class="tour-inquiry-form__note">
        Please provide either an email address or WhatsApp number so our Kabul team can reply.
        Sending this form is a request — it does not confirm a place or take payment.
      </div>

      <div class="tour-inquiry-form__status" data-inquiry-status aria-live="polite"></div>

      <div class="tour-inquiry-form__actions">
        <button class="tour-inquiry-submit" type="submit">Send request</button>
        <button class="tour-inquiry-cancel" type="button" data-tour-inquiry-close>Cancel</button>
      </div>
    </form>
  </section>
</div>

<script is:inline>
  (() => {
    const modal = document.querySelector('[data-tour-inquiry-modal]');
    const form = modal?.querySelector('[data-tour-inquiry-form]');
    if (!modal || !form) return;

    const tourInput = form.querySelector('[data-inquiry-tour]');
    const slugInput = form.querySelector('[data-inquiry-tour-slug]');
    const entitySlugInput = form.querySelector('[data-inquiry-entity-slug]');
    const entityNameInput = form.querySelector('[data-inquiry-entity-name]');
    const entityCodeInput = form.querySelector('[data-inquiry-entity-code]');
    const entityTypeInput = form.querySelector('[data-inquiry-entity-type]');
    const flowInput = form.querySelector('[data-inquiry-flow]');
    const productClassInput = form.querySelector('[data-inquiry-product-class]');
    const tourUrlInput = form.querySelector('[data-inquiry-tour-url]');
    const sourceUrlInput = form.querySelector('[data-inquiry-source-url]');
    const dateInput = form.querySelector('[data-inquiry-date]');
    const travelersInput = form.querySelector('[data-inquiry-travelers]');
    const status = form.querySelector('[data-inquiry-status]');
    const submit = form.querySelector('.tour-inquiry-submit');
    const eyebrow = modal.querySelector('[data-inquiry-eyebrow]');
    const lead = modal.querySelector('[data-inquiry-lead]');
    const entityLabel = modal.querySelector('[data-inquiry-entity-label]');
    const titleEl = modal.querySelector('#tour-inquiry-title');
    const depId = form.querySelector('[data-inquiry-departure-id]');
    const depStart = form.querySelector('[data-inquiry-departure-start]');
    const depEnd = form.querySelector('[data-inquiry-departure-end]');
    const depRow = form.querySelector('[data-inquiry-departure-row]');
    const depLabel = form.querySelector('[data-inquiry-departure-label]');
    const bookingType = form.querySelector('[data-inquiry-booking-type]');
    const arrivalRow = form.querySelector('[data-inquiry-arrival-row]');
    const arrival = form.querySelector('[data-inquiry-arrival]');
    const extrasRow = form.querySelector('[data-inquiry-extras-row]');
    const extrasHidden = form.querySelector('[data-inquiry-extras]');
    const groupHint = form.querySelector('[data-inquiry-group-hint]');
    const CONFIRMATION = 'Your request has been received. Our team will confirm availability, arrangements, and next steps.';
    let isWeekend = false;
    let groupMin = null;

    const updateHint = () => {
      if (!groupHint) return;
      const n = Number(travelersInput?.value || 0);
      const type = bookingType?.value || '';
      let text = '';
      if (type === 'private') {
        text = isWeekend
          ? 'Private Weekend in Kabul works for 1 or 2 travelers too — no group minimum. Private pricing is quoted separately from the shared rate.'
          : 'Private tours are quoted separately; the shared per-person rate does not apply.';
      } else if (type === 'shared' && n > 0 && groupMin && n < groupMin) {
        text = `This departure operates once ${groupMin} travelers are confirmed. You can still request ${n === 1 ? 'a place for 1 traveler' : `places for ${n} travelers`} — your booking can be confirmed while the departure is open, and we will tell you when the departure itself is confirmed.`;
      } else if (type === 'shared' && n > 0 && !groupMin) {
        text = `We will confirm availability for ${n === 1 ? '1 traveler' : `${n} travelers`} and how this shared departure is operating${isWeekend ? ' — or arrange a private weekend for you' : ''}.`;
      } else if (type === 'shared' && n > 0) {
        text = 'Thank you — we will confirm availability and arrangements with you before anything is confirmed.';
      }
      groupHint.textContent = text;
      groupHint.hidden = !text;
    };
    travelersInput?.addEventListener('input', updateHint);
    bookingType?.addEventListener('change', updateHint);

    const humanize = (value = '') => String(value)
      .replace(/^\/+|\/+$/g, '')
      .split('/').pop()
      .replace(/[-_]+/g, ' ')
      .replace(/\b\w/g, (c) => c.toUpperCase());

    const pageTourSlug = () => {
      const match = window.location.pathname.match(/^\/tours\/([^/]+)/);
      return match ? decodeURIComponent(match[1]) : '';
    };

    const pageTourTitle = () => {
      const h1 = document.querySelector('main h1, h1');
      return h1?.textContent?.trim() || humanize(pageTourSlug());
    };

    const pageProductClass = () => {
      const el = document.querySelector('[data-product-class]');
      return el?.getAttribute('data-product-class') || '';
    };

    const flowFromProductClass = (productClass) => {
      if (productClass === 'scheduled') return 'scheduled';
      if (productClass === 'private-fixed') return 'private-fixed';
      return 'private-fixed';
    };

    const pageTourCode = () => {
      const el = document.querySelector('[data-tour-code]');
      return el?.getAttribute('data-tour-code') || '';
    };

    const openModal = ({ tour, slug, date, travelers, flow, entityType, entityCode, productClass, departureId, departureStart, departureEnd, type, arrivalOption, weekend, days, lastMinute, manualContact } = {}) => {
      form.reset();
      const mc = form.querySelector('[data-inquiry-manual-contact]');
      if (mc) mc.value = manualContact ? '1' : '';
      const lm = form.querySelector('[data-inquiry-last-minute]');
      if (lm) lm.value = lastMinute ? '1' : '';
      // Owner decision 10 Oct 2026: 5+ day scheduled group tours need 6 to operate; shared departures of 4 days or less need 2.
      groupMin = Number(days) >= 5 ? 6 : Number(days) > 0 ? 2 : null;
      isWeekend = Boolean(weekend) || pageTourSlug() === 'weekend-in-kabul';
      if (depId) depId.value = departureId || '';
      if (depStart) depStart.value = departureStart || '';
      if (depEnd) depEnd.value = departureEnd || '';
      if (depRow) depRow.hidden = !departureId;
      if (depLabel) depLabel.value = departureId ? (date || `${departureStart} – ${departureEnd}`) : '';
      if (bookingType) bookingType.value = type || (departureId ? 'shared' : '');
      if (arrivalRow) arrivalRow.hidden = !isWeekend;
      if (arrival) arrival.value = arrivalOption || '';
      if (extrasRow) extrasRow.hidden = !isWeekend;
      const resolvedSlug = slug || pageTourSlug();
      const resolvedName = tour || pageTourTitle();
      const resolvedClass = productClass || pageProductClass();
      const resolvedFlow = flow || flowFromProductClass(resolvedClass);
      const resolvedCode = entityCode || pageTourCode();

      if (tourInput) tourInput.value = resolvedName;
      if (slugInput) slugInput.value = resolvedSlug;
      if (entitySlugInput) entitySlugInput.value = resolvedSlug;
      if (entityNameInput) entityNameInput.value = resolvedName;
      if (entityCodeInput) entityCodeInput.value = resolvedCode;
      if (entityTypeInput) entityTypeInput.value = entityType || 'tour';
      if (flowInput) flowInput.value = resolvedFlow;
      if (productClassInput) productClassInput.value = resolvedClass;
      if (tourUrlInput) tourUrlInput.value = window.location.href.split('#')[0];
      if (sourceUrlInput) sourceUrlInput.value = window.location.href.split('#')[0];
      if (dateInput && date) dateInput.value = date;
      if (travelersInput && travelers) travelersInput.value = travelers;
      if (status) status.textContent = '';
      updateHint();

      if (eyebrow) eyebrow.textContent = resolvedFlow === 'scheduled' ? 'Scheduled tour inquiry' : 'Tour inquiry';
      if (entityLabel) entityLabel.textContent = 'Tour';
      if (titleEl) titleEl.textContent = 'Plan this journey';
      if (lead) lead.textContent = departureId
        ? 'Request a place on this departure. Our team confirms availability and arrangements with you — nothing is confirmed automatically.'
        : 'Tell us your dates and group details. The tour you selected is already filled in.';
      if (titleEl && departureId) titleEl.textContent = 'Request a place';
      if (manualContact && departureId && !lastMinute) {
        if (titleEl) titleEl.textContent = 'Check availability';
        if (lead) lead.textContent = 'Tell us who is travelling and our team will check availability on this departure with you directly — nothing is confirmed or held until we reply.';
      }
      if (lastMinute && departureId) {
        if (titleEl) titleEl.textContent = 'Last-minute availability';
        if (lead) lead.textContent = 'This departure is inside its final booking window. Tell us who is travelling and we will check last-minute availability manually — nothing is confirmed or held until our team replies.';
      }
      if (titleEl && type === 'private') titleEl.textContent = 'Request a private tour';

      modal.hidden = false;
      document.documentElement.classList.add('tour-inquiry-open');
      setTimeout(() => form.querySelector('input[name="name"]')?.focus(), 40);
    };

    const closeModal = () => {
      modal.hidden = true;
      document.documentElement.classList.remove('tour-inquiry-open');
    };

    document.addEventListener('click', (event) => {
      const close = event.target.closest('[data-tour-inquiry-close]');
      if (close && modal.contains(close)) {
        event.preventDefault();
        closeModal();
        return;
      }

      const trigger = event.target.closest('[data-tour-inquiry], a[href*="/contact/?tour="], a[href*="/contact?tour="], a[href*="/contact/?flow=scheduled"], a[href*="/contact/?flow=private-fixed"], a[href*="entity_type=tour"]');
      if (!trigger) return;

      const explicitlyMarked = trigger.hasAttribute('data-tour-inquiry');
      const isTourPage = window.location.pathname.startsWith('/tours/');
      const rawHref = trigger.getAttribute('href') || '';
      let hrefLooksTour = /[?&](tour|tour_slug)=/.test(rawHref) || /[?&]flow=(scheduled|private-fixed)/.test(rawHref) || /[?&]entity_type=tour/.test(rawHref);
      if (!explicitlyMarked && !isTourPage && !hrefLooksTour) return;

      let tour = trigger.getAttribute('data-tour-title') || '';
      let slug = trigger.getAttribute('data-tour-slug') || '';
      let date = trigger.getAttribute('data-tour-date') || '';
      let travelers = trigger.getAttribute('data-tour-travelers') || '';
      let productClass = trigger.getAttribute('data-product-class') || '';
      let flow = trigger.getAttribute('data-inquiry-flow') || '';
      let entityCode = trigger.getAttribute('data-tour-code') || '';
      const departureId = trigger.getAttribute('data-departure-id') || '';
      const departureStart = trigger.getAttribute('data-departure-start') || '';
      const departureEnd = trigger.getAttribute('data-departure-end') || '';
      const type = trigger.getAttribute('data-booking-type') || '';
      const arrivalOption = trigger.getAttribute('data-arrival-option') || '';
      const weekend = trigger.getAttribute('data-weekend') === '1';
      const days = Number(trigger.getAttribute('data-tour-days') || 0);
      const lastMinute = trigger.getAttribute('data-last-minute') === '1';
      const manualContact = trigger.getAttribute('data-manual-contact') === '1';

      if (rawHref) {
        try {
          const url = new URL(rawHref, window.location.href);
          const sp = url.searchParams;
          // Canonical first, then legacy.
          tour ||= sp.get('entity_name') || sp.get('tour') || '';
          slug ||= sp.get('entity_slug') || sp.get('tour_slug') || sp.get('tour') || '';
          entityCode ||= sp.get('entity_code') || sp.get('tour_code') || '';
          productClass ||= sp.get('product_class') || '';
          flow ||= sp.get('flow') || sp.get('type') || '';
          date ||= sp.get('date') || sp.get('preferred_month') || sp.get('preferred_dates') || '';
          travelers ||= sp.get('group_size') || sp.get('travelers') || '';
        } catch (_) {}
      }

      event.preventDefault();
      openModal({ tour, slug, date, travelers, flow, productClass, entityCode, departureId, departureStart, departureEnd, type, arrivalOption, weekend, days, lastMinute, manualContact });
    });

    document.addEventListener('submit', (event) => {
      const planner = event.target.closest('form.tour-date-planner');
      if (planner) {
        event.preventDefault();
        const data = new FormData(planner);
        openModal({
          tour: data.get('tour') || pageTourTitle(),
          slug: pageTourSlug(),
          date: data.get('preferred_month') || '',
          travelers: data.get('group_size') || '',
          productClass: pageProductClass(),
        });
      }
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (status) status.textContent = '';

      const data = new FormData(form);
      const email = String(data.get('email') || '').trim();
      const whatsapp = String(data.get('whatsapp') || '').trim();
      if (!email && !whatsapp) {
        if (status) status.textContent = 'Please enter an email address or WhatsApp number.';
        return;
      }

      // Keep entity_name aligned with the visible tour field.
      if (entityNameInput && tourInput) entityNameInput.value = tourInput.value;
      if (extrasHidden) {
        extrasHidden.value = [...form.querySelectorAll('[data-inquiry-extra]:checked')].map((el) => el.value).join('; ');
        data.set('extras', extrasHidden.value);
      }
      if (entityNameInput) data.set('entity_name', entityNameInput.value);

      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Sending…';
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { 'Accept': 'application/json' },
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || result.ok === false) throw new Error(result.message || 'Unable to send inquiry.');

        if (status) status.textContent = result.message || CONFIRMATION;
        form.querySelectorAll('input:not([readonly]):not([type="hidden"]):not([type="checkbox"]), textarea').forEach((el) => { el.value = ''; });
        setTimeout(closeModal, 4000);
      } catch (error) {
        if (status) status.textContent = error?.message || 'Unable to send inquiry. Please email info@afghantours.com.';
      } finally {
        if (submit) {
          submit.disabled = false;
          submit.textContent = 'Send request';
        }
      }
    });
  })();
</script>

<style>
  :global(html.tour-inquiry-open) { overflow: hidden; }
  .tour-inquiry-modal[hidden] { display: none !important; }
  .tour-inquiry-modal { position: fixed; inset: 0; z-index: 5000; display: grid; place-items: center; padding: 1rem; }
  .tour-inquiry-modal__backdrop { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; border-radius: 0; background: rgba(6, 12, 9, .78); backdrop-filter: blur(7px); cursor: default; }
  .tour-inquiry-modal__panel { position: relative; z-index: 1; width: min(760px, 100%); max-height: calc(100vh - 2rem); overflow: auto; border: 1px solid rgba(16,24,32,.12); border-radius: 1.45rem; background: #fffaf2; color: #101820; box-shadow: 0 30px 90px rgba(0,0,0,.35); }
  .tour-inquiry-modal__close { position: absolute; right: 1rem; top: 1rem; z-index: 2; width: 40px; height: 40px; border: 1px solid #d8c9b5; border-radius: 999px; background: #fff; color: #101820; font-size: 1.7rem; line-height: 1; cursor: pointer; }
  .tour-inquiry-modal__heading { padding: 1.7rem 1.7rem 1rem; border-bottom: 1px solid #e5d9c7; }
  .tour-inquiry-modal__heading p { margin: 0 0 .55rem; color: #a86a12; text-transform: uppercase; letter-spacing: .18em; font-size: .68rem; font-weight: 900; }
  .tour-inquiry-modal__heading h2 { margin: 0; padding-right: 3rem; font-family: Georgia, "Times New Roman", serif; font-size: clamp(2.2rem, 5vw, 3.7rem); line-height: .92; letter-spacing: -.055em; }
  .tour-inquiry-modal__heading span { display: block; margin-top: .7rem; color: #596158; line-height: 1.6; }
  .tour-inquiry-form { padding: 1.35rem 1.7rem 1.7rem; }
  .tour-inquiry-form__grid { display: grid; grid-template-columns: 1fr 1fr; gap: .9rem; }
  .tour-inquiry-form label { display: grid; gap: .38rem; margin: 0 0 .9rem; color: #101820; font-size: .78rem; font-weight: 900; }
  .tour-inquiry-form [hidden] { display: none !important; }
  .tour-inquiry-form select { width: 100%; box-sizing: border-box; border: 1px solid #d6c8b4; border-radius: .72rem; background: #fff; color: #101820; padding: .85rem .9rem; font: inherit; min-height: 48px; }
  .tour-inquiry-form__hint { margin: -.2rem 0 .9rem; padding: .7rem .85rem; border-left: 3px solid #c99027; background: #fbf6ec; color: #4d473e; font-size: .8rem; line-height: 1.5; }
  .tour-inquiry-form__extras { margin: 0 0 .9rem; padding: 0; border: 0; }
  .tour-inquiry-form__extras legend { margin-bottom: .45rem; font-size: .78rem; font-weight: 900; }
  .tour-inquiry-form__extras label { display: flex !important; align-items: center; gap: .55rem; margin: 0 0 .35rem !important; font-weight: 700 !important; }
  .tour-inquiry-form__extras input { width: auto !important; }
  .tour-inquiry-form input, .tour-inquiry-form textarea { width: 100%; box-sizing: border-box; border: 1px solid #d6c8b4; border-radius: .72rem; background: #fff; color: #101820; padding: .85rem .9rem; font: inherit; }
  .tour-inquiry-form input[readonly] { background: #f2eadf; font-weight: 800; }
  .tour-inquiry-form input:focus, .tour-inquiry-form textarea:focus { outline: 2px solid rgba(214,162,58,.28); border-color: #c99027; }
  .tour-inquiry-form textarea { resize: vertical; min-height: 120px; }
  .tour-inquiry-form__note { margin: .15rem 0 .8rem; padding: .8rem .9rem; border: 1px solid #eadfce; border-radius: .75rem; background: #f6efe4; color: #60584e; font-size: .8rem; line-height: 1.5; }
  .tour-inquiry-form__status { min-height: 1.25rem; margin: .2rem 0 .7rem; color: #765018; font-weight: 800; font-size: .82rem; }
  .tour-inquiry-form__actions { display: flex; gap: .7rem; align-items: center; }
  .tour-inquiry-submit, .tour-inquiry-cancel { min-height: 44px; padding: .75rem 1.1rem; border-radius: 999px; font-weight: 900; cursor: pointer; }
  .tour-inquiry-submit { border: 0; background: #111b16; color: #fff; }
  .tour-inquiry-submit:hover { background: #d9a02d; color: #111b16; }
  .tour-inquiry-submit:disabled { opacity: .65; cursor: wait; }
  .tour-inquiry-cancel { border: 1px solid #cdbfae; background: transparent; color: #101820; }
  .tour-inquiry-hp { position: absolute !important; left: -9999px !important; width: 1px !important; height: 1px !important; opacity: 0 !important; }
  @media (max-width: 720px) {
    .tour-inquiry-modal { padding: .45rem; }
    .tour-inquiry-modal__panel { max-height: calc(100vh - .9rem); border-radius: 1rem; }
    .tour-inquiry-modal__heading, .tour-inquiry-form { padding-left: 1rem; padding-right: 1rem; }
    .tour-inquiry-form__grid { grid-template-columns: 1fr; gap: 0; }
    .tour-inquiry-form__actions { align-items: stretch; flex-direction: column; }
  }
</style>
