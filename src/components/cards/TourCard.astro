---
const { tour } = Astro.props;

const title = tour.title || tour.name;
const image = tour.thumbnail_image || tour.hero_image || tour.hero_image_path || "/assets/images/placeholders/tour-placeholder.webp";
const href = `/tours/${tour.slug}/`;

const rawDuration = tour.duration || tour.duration_days || "";
const duration = String(rawDuration).trim().toLowerCase() === "inquire"
  ? "Custom duration"
  : tour.duration
    ? tour.duration
    : tour.duration_days
      ? `${tour.duration_days} Days`
      : "";

const style = tour.tour_type || tour.category || "Private Journey";
const season = tour.season || "";
const difficulty = tour.difficulty || tour.activity_level || "";
const route = tour.locations || tour.route || tour.hubs || tour.summary_route || "";

const price = tour.price_from || tour.price || "";
const priceOnRequest =
  String(price).trim().toLowerCase() === "inquire";

const priceLabel = (() => {
  const raw = String(price || '').trim();

  if (!raw) return 'Custom quote';
  if (raw.toLowerCase() === 'inquire') return 'Request proposal';

  const numeric = Number(raw.replace(/[$,\s]/g, ''));

  if (Number.isFinite(numeric)) {
    return `From $${numeric.toLocaleString('en-US')} / person`;
  }

  return raw;
})();
---

<article class="tour-card">
  <a href={href} class="tour-card__media" aria-label={`View ${title}`}>
    <img src={image} alt={title} loading="lazy" />
    <div class="tour-card__shade"></div>
    {tour.badge && <span class="tour-card__badge">{tour.badge}</span>}
    {season && <span class="tour-card__season">{season}</span>}
  </a>

  <div class="tour-card__body">
    <p class="tour-card__eyebrow">{style}</p>

    <h3 class="tour-card__title">
      <a href={href}>{title}</a>
    </h3>

    {tour.tagline && <p class="tour-card__tagline">{tour.tagline}</p>}
    {route && <p class="tour-card__route">{route}</p>}

    <div class="tour-card__meta">
      {duration && <span>{duration}</span>}
      {difficulty && <span>{difficulty}</span>}
      {tour.group_size && <span>{tour.group_size}</span>}
    </div>

    <div class="tour-card__footer">
      <p class="tour-card__price">
        {priceLabel}
      </p>

      <a href={href} class="tour-card__cta">Explore Journey →</a>
    </div>
  </div>
</article>

<style>
  .tour-card {
    overflow: hidden;
    border-radius: 22px;
    background: #fff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    box-shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  }

  .tour-card:hover {
    transform: translateY(-4px);
    border-color: rgba(180, 126, 32, 0.35);
    box-shadow: 0 24px 65px rgba(15, 23, 42, 0.14);
  }

  .tour-card__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 11;
    overflow: hidden;
    background: #0f172a;
  }

  .tour-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms ease;
  }

  .tour-card:hover .tour-card__media img {
    transform: scale(1.06);
  }

  .tour-card__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(2, 6, 23, 0.55), transparent 52%),
      linear-gradient(to bottom, rgba(2, 6, 23, 0.2), transparent 42%);
  }

  .tour-card__badge,
  .tour-card__season {
    position: absolute;
    z-index: 2;
    top: 18px;
    border-radius: 999px;
    padding: 7px 12px;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .tour-card__badge {
    left: 18px;
    background: #b77a18;
    color: white;
  }

  .tour-card__season {
    right: 18px;
    background: rgba(255, 255, 255, 0.92);
    color: #0f172a;
  }

  .tour-card__body {
    padding: 22px;
  }

  .tour-card__eyebrow {
    margin: 0 0 8px;
    color: #b77a18;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tour-card__title {
    margin: 0;
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    line-height: 1.15;
    color: #0f172a;
  }

  .tour-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .tour-card__tagline {
    margin: 10px 0 0;
    color: #334155;
    line-height: 1.55;
  }

  .tour-card__route {
    margin: 14px 0 0;
    color: #64748b;
    font-size: 0.92rem;
  }

  .tour-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }

  .tour-card__meta span {
    border-radius: 999px;
    background: #f8fafc;
    border: 1px solid rgba(15, 23, 42, 0.08);
    padding: 7px 10px;
    color: #334155;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .tour-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid rgba(15, 23, 42, 0.08);
  }

  .tour-card__price {
    margin: 0;
    color: #64748b;
    font-size: 0.88rem;
  }

  .tour-card__price strong {
    color: #0f172a;
    font-size: 1.1rem;
  }

  .tour-card__cta {
    color: #9a6512;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .tour-card__body {
      padding: 18px;
    }

    .tour-card__footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
