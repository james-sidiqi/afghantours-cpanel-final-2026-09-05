---
const pillars = [
  {
    title: 'On the ground in Kabul',
    text: 'Planning happens here, not from a desk abroad. Drivers, guides, and hotel partners are people we already work with.',
    image: '/assets/images/page-assets/people/guides/guides-on-tour.webp',
    alt: 'AfghanTours guides and travelers on the ground in Afghanistan'
  },
  {
    title: 'Letter of Invitation',
    text: 'Every customer who books a tour with us receives LOI support. Provincial travel permits for the itinerary are processed in advance. We do not issue visas.',
    image: '/assets/images/page-assets/people/guides/guide-james-explaining.webp',
    alt: 'AfghanTours ground coordination during a guided visit'
  },
  {
    title: 'Routes that can change',
    text: 'Itineraries are built around real drive times, seasons, and access. If a pass is the wrong call that week, we use another road or we wait.',
    image: '/assets/images/transport/roads/kabul-parwan-bamyan/01.webp',
    alt: 'Afghanistan road used for route planning'
  },
  {
    title: 'Vehicles',
    text: 'Standard journeys use 4WD. An armored vehicle is available as a premium option when you request it. It is not required.',
    image: '/assets/images/page-assets/people/guides/edrees-white-4runner.webp',
    alt: 'AfghanTours guide beside a four wheel drive vehicle'
  },
  {
    title: 'What the days are for',
    text: 'Markets, tea houses, working monuments, and the people who keep them. Not a checklist of ruins.',
    image: '/assets/images/page-assets/people/hospitality/bamiyan-tea-house.webp',
    alt: 'Afghan hospitality in a Bamyan tea house'
  },
];
---

<section id="why-afghantours" class="why-section">
  <div class="why-overlay"></div>

  <div class="why-wrap">
    <div class="why-copy">
      <p class="section-eyebrow">Why travel with AfghanTours</p>
      <h2>Afghanistan is extraordinary. It deserves more than guesswork.</h2>

      <p class="why-subtitle">
        Private journeys are planned around the country as it actually works:
        its roads, seasons, access, hospitality, and people.
      </p>

      <div class="why-actions">
        <a href="/tours/">View all tours</a>
        <a
          href="https://wa.me/93780123456"
          target="_blank"
          rel="noopener noreferrer"
        >
          WhatsApp
        </a>
      </div>
    </div>

    <div class="pillar-grid">
      {pillars.map((pillar) => (
        <article class="pillar-card">
          <img
            src={pillar.image}
            alt={pillar.alt}
            loading="lazy"
            data-lightbox
          />

          <div class="pillar-card__body">
            <h3>{pillar.title}</h3>
            <p>{pillar.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .why-section {
    position: relative;
    overflow: hidden;
    padding: clamp(3.8rem,5.5vw,5.2rem) 0;
    border-top: 1px solid rgba(16,24,32,.08);
    border-bottom: 1px solid rgba(16,24,32,.08);
    background-image: url('/assets/images/hubs/kabul-city/hero.webp');
    background-size: cover;
    background-position: center;
    color: #101820;
  }

  .why-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(7,28,29,.90) 0%,
        rgba(7,28,29,.78) 35%,
        rgba(248,244,236,.91) 58%,
        rgba(248,244,236,.97) 100%
      ),
      rgba(248,244,236,.72);
    pointer-events: none;
  }

  .why-wrap {
    position: relative;
    z-index: 1;
    width: min(1220px,calc(100% - 2rem));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(320px,.88fr) minmax(0,1.22fr);
    gap: clamp(2rem,4vw,3.5rem);
    align-items: center;
  }

  .why-copy {
    color: #fff;
    max-width: 540px;
  }

  .section-eyebrow {
    margin: 0 0 .85rem;
    color: #d6a548;
    text-transform: uppercase;
    font-size: .72rem;
    font-weight: 900;
    letter-spacing: .26em;
  }

  .why-copy h2 {
    margin: 0;
    font-family: Georgia,'Times New Roman',serif;
    font-size: clamp(2.45rem,4vw,4rem);
    line-height: 1;
    letter-spacing: -.045em;
    color: #fff;
    max-width: 560px;
  }

  .why-subtitle {
    margin: 1.15rem 0 0;
    max-width: 510px;
    color: rgba(255,255,255,.88);
    font-size: .98rem;
    line-height: 1.7;
  }

  .why-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin-top: 1.5rem;
  }

  .why-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: .78rem 1.1rem;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,.32);
    color: #fff;
    text-decoration: none;
    font-size: .82rem;
    font-weight: 900;
  }

  .why-actions a:first-child {
    border-color: #d6a548;
    background: #d6a548;
    color: #101820;
  }

  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(6,minmax(0,1fr));
    gap: .9rem;
  }

  .pillar-card {
    grid-column: span 2;
    overflow: hidden;
    min-width: 0;
    border: 1px solid rgba(166,137,95,.24);
    border-radius: 1.15rem;
    background: rgba(255,250,242,.97);
    color: #101820;
    box-shadow: 0 18px 55px rgba(35,23,8,.12);
  }

  .pillar-card:nth-child(2n) {
    background: rgba(242,232,216,.97);
  }

  .pillar-card:nth-child(4),
  .pillar-card:nth-child(5) {
    grid-column: span 3;
  }

  .pillar-card > img {
    display: block;
    width: 100%;
    height: 126px;
    object-fit: cover;
    transition: transform .35s ease;
  }

  .pillar-card:hover > img {
    transform: scale(1.025);
  }

  .pillar-card__body {
    padding: 1rem 1rem 1.1rem;
  }

  .pillar-card h3 {
    margin: 0 0 .55rem;
    font-family: Georgia,'Times New Roman',serif;
    font-size: clamp(1.08rem,1.35vw,1.28rem);
    line-height: 1.05;
    letter-spacing: -.025em;
    color: #101820;
  }

  .pillar-card p {
    margin: 0;
    color: #4b4034;
    font-size: .85rem;
    line-height: 1.55;
  }

  @media(max-width:1050px) {
    .why-overlay {
      background: linear-gradient(
        rgba(7,28,29,.88),
        rgba(7,28,29,.88)
      );
    }

    .why-wrap {
      grid-template-columns: 1fr;
    }

    .why-copy {
      max-width: 760px;
    }
  }

  @media(max-width:760px) {
    .pillar-grid {
      grid-template-columns: repeat(2,minmax(0,1fr));
    }

    .pillar-card,
    .pillar-card:nth-child(4),
    .pillar-card:nth-child(5) {
      grid-column: auto;
    }
  }

  @media(max-width:520px) {
    .pillar-grid {
      grid-template-columns: 1fr;
    }

    .pillar-card > img {
      height: 160px;
    }
  }
</style>
