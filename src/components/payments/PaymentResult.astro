---
/**
 * Shared layout for /pay/success/ and /pay/cancelled/.
 * Customer-facing only: HesabPay's webhook (not this page) is the source of truth for payment status.
 */
const { eyebrow = 'Payments', title = '', primaryHref = '/contact/', primaryLabel = 'Contact us', secondaryHref = '', secondaryLabel = '' } = Astro.props;
---
<section class="pay-result">
  <div class="pay-result__card">
    <p class="pay-eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <div class="pay-result__body"><slot /></div>
    <p class="pay-result__alt">
      Questions? Email <a href="mailto:info@afghantours.com">info@afghantours.com</a> or message us on
      <a href="https://wa.me/93780123456" target="_blank" rel="noopener noreferrer">WhatsApp +93 780 123 456</a>.
    </p>
    <div class="pay-result__actions">
      <a class="pay-btn" href={primaryHref}>{primaryLabel}</a>
      {secondaryHref && <a class="pay-btn pay-btn--soft" href={secondaryHref}>{secondaryLabel}</a>}
    </div>
  </div>
</section>

<style>
  .pay-result { background:#fbf6ed; color:#101820; padding:clamp(3.5rem,8vw,7rem) 1rem; }
  .pay-result__card { width:min(720px,100%); margin:0 auto; background:#fff; border:1px solid rgba(16,24,32,.1); border-radius:1.5rem; box-shadow:0 18px 50px rgba(21,16,9,.1); padding:clamp(1.5rem,4vw,2.6rem); box-sizing:border-box; }
  .pay-eyebrow { margin:0; color:#b97816; text-transform:uppercase; letter-spacing:.24em; font-size:.75rem; font-weight:900; }
  h1 { font-family:Georgia,"Times New Roman",serif; font-size:clamp(2.3rem,6vw,3.6rem); line-height:.98; letter-spacing:-.045em; margin:.7rem 0 1.1rem; color:#101820; }
  .pay-result__body :global(p) { color:#4b5563; line-height:1.8; margin:0 0 1rem; font-size:1.04rem; }
  .pay-result__alt { border-radius:1rem; background:#f8f1e5; border:1px solid #eadfce; padding:.95rem 1rem; color:#4b5563; font-size:.92rem; line-height:1.6; margin:1.2rem 0 0; }
  .pay-result__alt a { color:#101820; font-weight:800; }
  .pay-result__actions { display:flex; flex-wrap:wrap; gap:.7rem; margin-top:1.5rem; }
  .pay-btn { display:inline-flex; align-items:center; justify-content:center; border-radius:999px; background:#101820; color:#fff; text-decoration:none; padding:.95rem 1.2rem; font-weight:900; }
  .pay-btn:hover { background:#d6a23a; color:#101820; }
  .pay-btn--soft { background:#f1dfb8; color:#101820; }
</style>
