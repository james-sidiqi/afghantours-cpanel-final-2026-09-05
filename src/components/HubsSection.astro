---

<section id="hubs" class="relative overflow-hidden bg-[#06150f] text-white">
  <div class="absolute inset-0">
    {hubs.map((hub, index) => (
      <img
        id={`hub-bg-${index}`}
        src={hub.image}
        alt=""
        class={`absolute inset-0 h-full w-full object-cover transition-opacity duration-1000 ${index === 0 ? 'opacity-100' : 'opacity-0'}`}
      />
    ))}
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/45 to-black/85"></div>
  </div>

  <div class="relative mx-auto grid max-w-[1600px] gap-0 lg:grid-cols-[1fr_460px]">
    <div class="px-6 py-24 md:px-10 lg:px-16">
      <p class="text-xs font-bold uppercase tracking-[0.35em] text-[#d6a23a]">
        Operational Geography
      </p>

      <h2 class="mt-6 max-w-4xl font-serif text-5xl leading-none md:text-7xl">
        Travel Through Afghanistan’s Key Hubs
      </h2>

      <p class="mt-8 max-w-2xl text-lg leading-8 text-white/80">
        Afghanistan journeys are built around a network of operational hubs. Each offers
        different attractions, transportation options, accommodations, seasonal advantages,
        and regional access.
      </p>

      <div id="hub-main-panel" class="mt-12 max-w-3xl">
        <h3 class="font-serif text-5xl">{hubs[0].name}</h3>
        <p class="mt-2 text-sm text-white/70">{hubs[0].province} Province · {hubs[0].type}</p>
        <p class="mt-5 text-base leading-7 text-white/80">{hubs[0].summary}</p>

        <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-4">
          {hubs[0].stats.map((stat) => (
            <div class="rounded-2xl border border-white/15 bg-white/10 p-4 backdrop-blur">
              <p class="text-sm font-semibold">{stat}</p>
            </div>
          ))}
        </div>

        <div class="mt-8 flex flex-wrap gap-4">
          <a href={`/hubs/${hubs[0].slug}/`} class="rounded-full bg-[#d6a23a] px-6 py-3 text-sm font-bold uppercase tracking-wider text-black">
            Explore Hub
          </a>
          <a href={`/contact/?hub=${hubs[0].slug}`} class="rounded-full border border-white/30 px-6 py-3 text-sm font-bold uppercase tracking-wider text-white">
            Plan From This Hub
          </a>
        </div>
      </div>

      <div class="mt-16 flex gap-4 overflow-x-auto pb-4">
        {hubs.map((hub, index) => (
          <button
            type="button"
            data-hub-index={index}
            class={`hub-card min-w-[220px] rounded-2xl border p-3 text-left transition ${index === 0 ? 'border-[#d6a23a] bg-white/15' : 'border-white/10 bg-black/30 hover:border-[#d6a23a]'}`}
          >
            <img src={hub.cardImage || hub.image} alt={hub.name} class="h-28 w-full rounded-xl object-cover" />
            <h4 class="mt-3 font-serif text-2xl">{hub.name}</h4>
            <p class="text-sm text-white/70">{hub.type}</p>
          </button>
        ))}
      </div>
    </div>

    <aside class="border-l border-white/10 bg-black/80 px-6 py-20 backdrop-blur-xl md:px-8">
      <p class="text-xs font-bold uppercase tracking-[0.35em] text-[#d6a23a]">
        Hub Preview
      </p>

      <h3 id="preview-title" class="mt-4 font-serif text-5xl">{hubs[0].name}</h3>

      <div class="mt-8 flex flex-wrap gap-4 border-b border-white/10 pb-4 text-xs font-bold uppercase tracking-wider">
        <button class="hub-tab text-[#d6a23a]" data-tab="overview">Overview</button>
        <button class="hub-tab" data-tab="attractions">Attractions</button>
        <button class="hub-tab" data-tab="hotels">Hotels</button>
        <button class="hub-tab" data-tab="food">Food</button>
        <button class="hub-tab" data-tab="transport">Transport</button>
        <button class="hub-tab" data-tab="tours">Tours</button>
      </div>

      <div id="hub-preview-content" class="mt-8"></div>

      <a
        id="hub-preview-link"
        href={`/hubs/${hubs[0].slug}/`}
        class="mt-8 block rounded-xl bg-[#d6a23a] px-6 py-4 text-center text-sm font-bold uppercase tracking-wider text-black"
      >
        View All Hub Details →
      </a>
    </aside>
  </div>
</section>

<script define:vars={{ hubs }}>
  let activeHub = 0;
  let activeTab = "overview";

  const content = document.getElementById("hub-preview-content");
  const title = document.getElementById("preview-title");
  const mainPanel = document.getElementById("hub-main-panel");
  const previewLink = document.getElementById("hub-preview-link");

  function cardGrid(items) {
    return `
      <div class="grid grid-cols-2 gap-4">
        ${items.map(([name, image, href]) => `
          <a href="${href || '#'}" class="group block">
            <img src="${image}" alt="${name}" class="h-24 w-full rounded-xl object-cover transition duration-300 group-hover:scale-[1.02]" />
            <p class="mt-2 text-sm font-semibold leading-tight">${name}</p>
          </a>
        `).join("")}
      </div>
    `;
  }

  function tourList(items) {
    return `
      <div class="space-y-3">
        ${items.map(([name, href]) => `
          <a href="${href}" class="block rounded-2xl border border-white/10 bg-white/5 p-4 transition hover:border-[#d6a23a]">
            <p class="font-semibold">${name}</p>
          </a>
        `).join("")}
      </div>
    `;
  }

  function renderOverview(hub) {
    return `
      <div class="space-y-6">
        <p class="text-sm leading-7 text-white/75">${hub.summary}</p>

        <div class="grid grid-cols-2 gap-4">
          ${(hub.gallery || []).slice(0, 4).map((image) => `
            <button type="button" class="hub-gallery-image group overflow-hidden rounded-xl">
              <img src="${image}" alt="${hub.name}" class="h-28 w-full object-cover transition duration-300 group-hover:scale-105" />
            </button>
          `).join("")}
        </div>

        <div class="grid grid-cols-2 gap-3">
          ${hub.stats.map((stat) => `
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4 text-sm font-semibold">
              ${stat}
            </div>
          `).join("")}
        </div>
      </div>
    `;
  }

  function renderPreview() {
    const hub = hubs[activeHub];
    if (!hub || !content || !title) return;

    title.textContent = hub.name;

    if (previewLink) {
      previewLink.href = `/hubs/${hub.slug}/`;
    }

    if (activeTab === "overview") {
      content.innerHTML = renderOverview(hub);
    } else if (activeTab === "tours") {
      content.innerHTML = tourList(hub.tours || []);
    } else {
      content.innerHTML = cardGrid(hub[activeTab] || []);
    }
  }

  function renderMainPanel() {
    const hub = hubs[activeHub];
    if (!mainPanel || !hub) return;

    mainPanel.innerHTML = `
      <h3 class="font-serif text-5xl">${hub.name}</h3>
      <p class="mt-2 text-sm text-white/70">${hub.province} Province · ${hub.type}</p>
      <p class="mt-5 text-base leading-7 text-white/80">${hub.summary}</p>

      <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-4">
        ${hub.stats.map((stat) => `
          <div class="rounded-2xl border border-white/15 bg-white/10 p-4 backdrop-blur">
            <p class="text-sm font-semibold">${stat}</p>
          </div>
        `).join("")}
      </div>

      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/hubs/${hub.slug}/" class="rounded-full bg-[#d6a23a] px-6 py-3 text-sm font-bold uppercase tracking-wider text-black">
          Explore Hub
        </a>
        <a href="/contact/?hub=${hub.slug}" class="rounded-full border border-white/30 px-6 py-3 text-sm font-bold uppercase tracking-wider text-white">
          Plan From This Hub
        </a>
      </div>
    `;
  }

  function setHub(index) {
    activeHub = index;

    document.querySelectorAll("[id^='hub-bg-']").forEach((bg, i) => {
      bg.classList.toggle("opacity-100", i === index);
      bg.classList.toggle("opacity-0", i !== index);
    });

    document.querySelectorAll("[data-hub-index]").forEach((btn, i) => {
      btn.classList.toggle("border-[#d6a23a]", i === index);
      btn.classList.toggle("bg-white/15", i === index);
      btn.classList.toggle("border-white/10", i !== index);
      btn.classList.toggle("bg-black/30", i !== index);
    });

    renderMainPanel();
    renderPreview();
  }

  document.querySelectorAll("[data-hub-index]").forEach((button) => {
    button.addEventListener("click", () => setHub(Number(button.dataset.hubIndex)));
  });

  document.querySelectorAll("[data-tab]").forEach((button) => {
    button.addEventListener("click", () => {
      activeTab = button.dataset.tab || "overview";
      document.querySelectorAll("[data-tab]").forEach((tab) => tab.classList.remove("text-[#d6a23a]"));
      button.classList.add("text-[#d6a23a]");
      renderPreview();
    });
  });

  renderPreview();
</script>
