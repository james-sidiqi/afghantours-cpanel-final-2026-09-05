---
import { buildHubIndexCatalog } from '../lib/hubCatalog';

/**
 * Prefer a catalog passed from hubs/index.astro; otherwise build from
 * the same canonical relationship data used by /hubs/[slug]/.
 * Never keep a second hard-coded hub list here.
 */
const props = Astro.props || {};
const hubs = (Array.isArray(props.hubs) && props.hubs.length && props.hubs[0]?.attractions)
  ? props.hubs
  : buildHubIndexCatalog();
---

<section id="hubs" class="hubs-page">

  <div class="hub-hero">
    <div class="hub-hero-bg" aria-hidden="true">
      {hubs.map((hub, index) => (
        <img
          src={hub.image}
          alt=""
          class={`hub-bg-image ${index === 0 ? 'is-active' : ''}`}
          data-bg-index={index}
        />
      ))}
      <div class="hub-hero-overlay"></div>
    </div>

    <div class="hub-container hub-hero-content">
      <p class="section-kicker">Travel Hubs</p>

      <h1>
        Use Afghanistan's cities as your gateways.
      </h1>

      <p>
        Each hub connects you to places to stay, local food, cultural and
        historical attractions, activities, and the routes that continue
        deeper into the country.
      </p>
    </div>
  </div>


  <div class="hub-container">

    <section class="hub-chooser">

      <div class="hub-chooser-heading">
        <div>
          <p class="section-kicker">Choose a hub</p>
          <h2>Where do you want to base your journey?</h2>
        </div>

        <span>{hubs.length} travel hubs</span>
      </div>


      <div class="hub-grid" id="hub-selector">

        {hubs.map((hub, index) => (
          <button
            type="button"
            data-hub-index={index}
            class={`hub-choice ${index === 0 ? 'is-active' : ''}`}
          >
            <img
              src={hub.cardImage || hub.image}
              alt={hub.name}
              loading={index > 3 ? 'lazy' : 'eager'}
            />

            <span class="hub-choice-copy">
              <small>{hub.type}</small>
              <strong>{hub.name}</strong>
              <em>{hub.province} Province</em>
            </span>
          </button>
        ))}

      </div>

    </section>


    <section class="selected-hub">

      <div class="selected-hub-image">
        <img
          id="hub-main-image"
          src={hubs[0].cardImage || hubs[0].image}
          alt={hubs[0].name}
        />

        <div class="selected-image-label">
          <span id="hub-type">{hubs[0].type}</span>
          <strong id="hub-image-name">{hubs[0].name}</strong>
        </div>
      </div>


      <div class="selected-hub-copy">

        <p class="section-kicker" id="hub-label">
          {hubs[0].province} Province
        </p>

        <h2 id="hub-title">{hubs[0].name}</h2>

        <p id="hub-summary" class="hub-summary">
          {hubs[0].summary}
        </p>

        <div id="hub-stats" class="hub-stats">
          {hubs[0].stats.map((stat) => (
            <span>{stat}</span>
          ))}
        </div>

        <div class="hub-actions">
          <a
            id="hub-open-link"
            class="hub-button-primary"
            href={`/hubs/${hubs[0].slug}/`}
          >
            Explore this hub
          </a>

          <a
            id="hub-plan-link"
            class="hub-button-secondary"
            href={`/contact/?hub=${hubs[0].slug}`}
          >
            Plan from this hub
          </a>
        </div>

      </div>

    </section>


    <section class="hub-access">

      <div class="hub-access-heading">
        <div>
          <p class="section-kicker">Accessible from this hub</p>

          <h2 id="access-title">
            What you can experience from {hubs[0].name}
          </h2>
        </div>

        <p>
          Hotels, food, attractions and activities are shown together so you
          can understand what each hub actually gives you access to.
        </p>
      </div>


      <div class="access-grid">

        <!-- HOTELS -->

        <section class="access-column">

          <div class="access-column-heading">
            <span class="access-icon">01</span>

            <div>
              <small>Stay</small>
              <h3>Hotels</h3>
            </div>

            <a href="/hotels/">All hotels →</a>
          </div>

          <div
            id="hub-hotels"
            class="access-items"
          ></div>

        </section>


        <!-- FOOD -->

        <section class="access-column">

          <div class="access-column-heading">
            <span class="access-icon">02</span>

            <div>
              <small>Eat</small>
              <h3>Local Food</h3>
            </div>

            <a href="/food-culture/">Explore food →</a>
          </div>

          <div
            id="hub-food"
            class="access-items"
          ></div>

        </section>


        <!-- ATTRACTIONS -->

        <section class="access-column">

          <div class="access-column-heading">
            <span class="access-icon">03</span>

            <div>
              <small>Explore</small>
              <h3>Attractions</h3>
            </div>

            <a href="/attractions/">All attractions →</a>
          </div>

          <div
            id="hub-attractions"
            class="access-items"
          ></div>

        </section>


        <!-- ACTIVITIES -->

        <section class="access-column">

          <div class="access-column-heading">
            <span class="access-icon">04</span>

            <div>
              <small>Do</small>
              <h3>Activities & Trips</h3>
            </div>

            <a href="/tours/">View tours →</a>
          </div>

          <div
            id="hub-activities"
            class="activity-items"
          ></div>

        </section>

      </div>

    </section>


    <section class="hub-connect">

      <div>
        <p class="section-kicker">Moving onward</p>
        <h2>How this hub connects to the journey.</h2>
      </div>

      <div
        id="hub-transport"
        class="transport-list"
      ></div>

    </section>

  </div>

</section>


<script define:vars={{ hubs }}>
  (() => {
    let activeHub = 0;

    const title = document.getElementById('hub-title');
    const label = document.getElementById('hub-label');
    const type = document.getElementById('hub-type');
    const imageName = document.getElementById('hub-image-name');

    const summary = document.getElementById('hub-summary');
    const stats = document.getElementById('hub-stats');

    const mainImage = document.getElementById('hub-main-image');

    const openLink = document.getElementById('hub-open-link');
    const planLink = document.getElementById('hub-plan-link');

    const accessTitle = document.getElementById('access-title');

    const hotelsEl = document.getElementById('hub-hotels');
    const foodEl = document.getElementById('hub-food');
    const attractionsEl = document.getElementById('hub-attractions');
    const activitiesEl = document.getElementById('hub-activities');
    const transportEl = document.getElementById('hub-transport');


    function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }


    function renderImageItems(element, items, hub, limit = 3) {
      if (!element) return;

      const sliced = (items || []).slice(0, limit);

      if (!sliced.length) {
        element.innerHTML = `
          <p class="access-empty">
            More recommendations are being added.
          </p>
        `;
        return;
      }

      element.innerHTML = sliced
        .map(([name, image, href]) => `
          <a
            class="access-card"
            href="${href || `/hubs/${hub.slug}/`}"
          >
            <div class="access-card-image">
              <img
                src="${image || hub.cardImage || hub.image}"
                alt="${escapeHtml(name)}"
                loading="lazy"
              />
            </div>

            <span>${escapeHtml(name)}</span>
          </a>
        `)
        .join('');
    }


    function renderActivities(element, hub) {
      if (!element) return;

      const activities = (hub.activities && hub.activities.length
        ? hub.activities
        : (hub.tours || [])).slice(0, 4);

      if (!activities.length) {
        element.innerHTML = `
          <p class="access-empty">
            More activities are being added.
          </p>
        `;
        return;
      }

      element.innerHTML = activities
        .map(([name, href], index) => `
          <a
            class="activity-card"
            href="${href || `/contact/?hub=${hub.slug}`}"
          >
            <span>0${index + 1}</span>

            <strong>
              ${escapeHtml(name)}
            </strong>

            <b>→</b>
          </a>
        `)
        .join('');
    }


    function renderTransport(element, hub) {
      if (!element) return;

      const items = (hub.transport || []).slice(0, 4);

      element.innerHTML = items
        .map(([name, image, href]) => `
          <a
            href="${href || '/transportation/'}"
            class="transport-chip"
          >
            ${escapeHtml(name)}
            <span>→</span>
          </a>
        `)
        .join('');
    }


    function renderStats(hub) {
      if (!stats) return;

      stats.innerHTML = (hub.stats || [])
        .map(stat => `
          <span>${escapeHtml(stat)}</span>
        `)
        .join('');
    }


    function setHub(index) {
      const hub = hubs[index];

      if (!hub) return;

      activeHub = index;


      document
        .querySelectorAll('[data-hub-index]')
        .forEach((button, i) => {
          button.classList.toggle(
            'is-active',
            i === index
          );
        });


      document
        .querySelectorAll('[data-bg-index]')
        .forEach((image, i) => {
          image.classList.toggle(
            'is-active',
            i === index
          );
        });


      if (title) {
        title.textContent = hub.name;
      }

      if (label) {
        label.textContent =
          `${hub.province} Province`;
      }

      if (type) {
        type.textContent = hub.type;
      }

      if (imageName) {
        imageName.textContent = hub.name;
      }

      if (summary) {
        summary.textContent = hub.summary;
      }

      if (mainImage) {
        mainImage.src =
          hub.cardImage || hub.image;

        mainImage.alt =
          hub.name;
      }

      if (openLink) {
        openLink.href =
          `/hubs/${hub.slug}/`;
      }

      if (planLink) {
        planLink.href =
          `/contact/?hub=${hub.slug}`;
      }

      if (accessTitle) {
        accessTitle.textContent =
          `What you can experience from ${hub.name}`;
      }


      renderStats(hub);

      renderImageItems(
        hotelsEl,
        hub.hotels,
        hub,
        3
      );

      renderImageItems(
        foodEl,
        hub.food,
        hub,
        3
      );

      renderImageItems(
        attractionsEl,
        hub.attractions,
        hub,
        3
      );

      renderActivities(
        activitiesEl,
        hub
      );

      renderTransport(
        transportEl,
        hub
      );
    }


    document
      .querySelectorAll('[data-hub-index]')
      .forEach(button => {
        button.addEventListener(
          'click',
          () => {
            setHub(
              Number(
                button.dataset.hubIndex || 0
              )
            );
          }
        );
      });


    setHub(0);
  })();
</script>


<style>

  .hubs-page {
    background: #f4efe5;
    color: #111a1d;
  }


  .hub-container {
    width: min(1360px, calc(100% - 2.5rem));
    margin: 0 auto;
  }


  /* ========================================================
     COMPACT HERO
     ======================================================== */

  .hub-hero {
    position: relative;
    overflow: hidden;

    min-height: 350px;

    display: flex;
    align-items: end;

    color: #fff;
    background: #0d1917;
  }


  .hub-hero-bg,
  .hub-bg-image,
  .hub-hero-overlay {
    position: absolute;
    inset: 0;
  }


  .hub-bg-image {
    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    opacity: 0;

    transition: opacity .45s ease;
  }


  .hub-bg-image.is-active {
    opacity: 1;
  }


  .hub-hero-overlay {
    background:
      linear-gradient(
        90deg,
        rgba(8,18,16,.92) 0%,
        rgba(8,18,16,.67) 45%,
        rgba(8,18,16,.28) 100%
      ),
      linear-gradient(
        to top,
        rgba(8,18,16,.72),
        transparent 75%
      );
  }


  .hub-hero-content {
    position: relative;
    z-index: 2;

    padding:
      clamp(3rem, 6vw, 5rem)
      0;
  }


  .section-kicker {
    margin: 0;

    color: #b97821;

    font-size: .65rem;
    font-weight: 950;
    letter-spacing: .2em;

    text-transform: uppercase;
  }


  .hub-hero .section-kicker {
    color: #e0ab43;
  }


  .hub-hero h1 {
    max-width: 800px;

    margin: .6rem 0 .8rem;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size:
      clamp(3rem, 5.8vw, 5.5rem);

    line-height: .91;
    letter-spacing: -.055em;
  }


  .hub-hero p:not(.section-kicker) {
    max-width: 720px;

    margin: 0;

    color: rgba(255,255,255,.78);

    font-size: .98rem;
    line-height: 1.65;
  }



  /* ========================================================
     HUB CHOOSER
     ======================================================== */

  .hub-chooser {
    padding:
      2.4rem
      0
      2rem;
  }


  .hub-chooser-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;

    gap: 2rem;

    margin-bottom: 1rem;
  }


  .hub-chooser-heading h2 {
    margin: .35rem 0 0;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size:
      clamp(1.8rem, 3vw, 2.7rem);

    line-height: .97;
    letter-spacing: -.035em;
  }


  .hub-chooser-heading > span {
    color: #716a60;

    font-size: .72rem;
  }


  .hub-grid {
    display: grid;

    grid-template-columns:
      repeat(7, minmax(0,1fr));

    gap: .65rem;
  }


  .hub-choice {
    min-width: 0;

    overflow: hidden;

    display: flex;
    flex-direction: column;

    padding: 0;

    border:
      1px solid #ddd4c6;

    border-radius: .85rem;

    background: #fff;
    color: #131d20;

    text-align: left;

    cursor: pointer;

    transition:
      transform .18s ease,
      border-color .18s ease,
      box-shadow .18s ease;
  }


  .hub-choice:hover {
    transform: translateY(-2px);

    border-color: #b97821;
  }


  .hub-choice.is-active {
    border-color: #14211e;

    box-shadow:
      0 0 0 2px #14211e;
  }


  .hub-choice img {
    display: block;

    width: 100%;
    height: 90px;

    object-fit: cover;
  }


  .hub-choice-copy {
    min-width: 0;

    display: block;

    padding:
      .65rem
      .7rem
      .75rem;
  }


  .hub-choice small {
    display: block;

    overflow: hidden;

    margin-bottom: .25rem;

    color: #a86418;

    font-size: .5rem;
    font-weight: 950;
    letter-spacing: .08em;
    text-transform: uppercase;

    text-overflow: ellipsis;
    white-space: nowrap;
  }


  .hub-choice strong {
    display: block;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: .95rem;
    line-height: 1;
  }


  .hub-choice em {
    display: block;

    margin-top: .25rem;

    color: #777066;

    font-size: .58rem;
    font-style: normal;
  }



  /* ========================================================
     SELECTED HUB
     ======================================================== */

  .selected-hub {
    overflow: hidden;

    display: grid;

    grid-template-columns:
      minmax(330px, .85fr)
      minmax(0, 1.15fr);

    min-height: 360px;

    border:
      1px solid #ddd4c6;

    border-radius: 1.2rem;

    background: #fff;

    box-shadow:
      0 12px 30px
      rgba(34,27,17,.07);
  }


  .selected-hub-image {
    position: relative;
    overflow: hidden;

    min-height: 360px;

    background: #ddd4c6;
  }


  .selected-hub-image > img {
    display: block;

    width: 100%;
    height: 100%;

    min-height: 360px;

    object-fit: cover;
  }


  .selected-image-label {
    position: absolute;

    left: 1rem;
    right: 1rem;
    bottom: 1rem;

    padding: .8rem 1rem;

    border:
      1px solid rgba(255,255,255,.18);

    border-radius: .8rem;

    background:
      rgba(8,17,15,.76);

    backdrop-filter: blur(10px);

    color: #fff;
  }


  .selected-image-label span {
    display: block;

    color: #e0ab43;

    font-size: .56rem;
    font-weight: 900;

    letter-spacing: .1em;
    text-transform: uppercase;
  }


  .selected-image-label strong {
    display: block;

    margin-top: .2rem;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 1.25rem;
  }


  .selected-hub-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;

    padding:
      clamp(1.8rem, 4vw, 3.4rem);
  }


  .selected-hub-copy h2 {
    margin:
      .45rem
      0
      .7rem;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size:
      clamp(2.7rem, 5vw, 5rem);

    line-height: .9;
    letter-spacing: -.055em;
  }


  .hub-summary {
    max-width: 700px;

    margin: 0;

    color: #545c5b;

    font-size: .92rem;
    line-height: 1.65;
  }


  .hub-stats {
    display: flex;
    flex-wrap: wrap;

    gap: .5rem;

    margin-top: 1.2rem;
  }


  .hub-stats span {
    padding:
      .48rem
      .68rem;

    border:
      1px solid #ded6ca;

    border-radius: 999px;

    background: #f8f5ef;

    color: #474f4d;

    font-size: .61rem;
    font-weight: 850;
  }


  .hub-actions {
    display: flex;
    flex-wrap: wrap;

    gap: .55rem;

    margin-top: 1.35rem;
  }


  .hub-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 42px;

    padding:
      0
      1rem;

    border-radius: 999px;

    font-size: .67rem;
    font-weight: 900;

    text-decoration: none;
    text-transform: uppercase;

    letter-spacing: .05em;
  }


  .hub-button-primary {
    background: #13201d;
    color: #fff;
  }


  .hub-button-secondary {
    border:
      1px solid #d7cdbf;

    color: #13201d;
  }



  /* ========================================================
     ACCESS SHOWCASE
     ======================================================== */

  .hub-access {
    padding:
      clamp(3rem, 5vw, 4.5rem)
      0;
  }


  .hub-access-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;

    gap: 2rem;

    margin-bottom: 1.25rem;
  }


  .hub-access-heading h2 {
    max-width: 700px;

    margin: .4rem 0 0;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size:
      clamp(2rem, 3.5vw, 3.5rem);

    line-height: .95;
    letter-spacing: -.04em;
  }


  .hub-access-heading > p {
    max-width: 430px;

    margin: 0;

    color: #70695f;

    font-size: .77rem;
    line-height: 1.55;
  }


  .access-grid {
    display: grid;

    grid-template-columns:
      repeat(4, minmax(0,1fr));

    gap: .8rem;
  }


  .access-column {
    min-width: 0;

    padding: .85rem;

    border:
      1px solid #ddd4c6;

    border-radius: 1rem;

    background: #fff;
  }


  .access-column-heading {
    display: grid;

    grid-template-columns:
      auto
      minmax(0,1fr);

    gap: .65rem;

    align-items: center;

    margin-bottom: .75rem;
  }


  .access-column-heading > a {
    grid-column: 1 / -1;

    color: #9c6118;

    font-size: .58rem;
    font-weight: 900;

    text-decoration: none;
  }


  .access-icon {
    display: grid;
    place-items: center;

    width: 31px;
    height: 31px;

    border-radius: 999px;

    background: #f0e2cc;

    color: #986018;

    font-size: .58rem;
    font-weight: 900;
  }


  .access-column-heading small {
    display: block;

    color: #a86418;

    font-size: .5rem;
    font-weight: 900;

    letter-spacing: .08em;
    text-transform: uppercase;
  }


  .access-column-heading h3 {
    margin: .08rem 0 0;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 1.2rem;
    line-height: 1;
  }


  .access-items {
    display: grid;

    gap: .5rem;
  }


  .access-card {
    overflow: hidden;

    display: grid;

    grid-template-columns:
      82px
      minmax(0,1fr);

    align-items: center;

    border:
      1px solid #e4ddd2;

    border-radius: .65rem;

    background: #faf8f4;
    color: #151e21;

    text-decoration: none;
  }


  .access-card-image {
    overflow: hidden;

    width: 82px;
    height: 66px;
  }


  .access-card img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    transition:
      transform .2s ease;
  }


  .access-card:hover img {
    transform: scale(1.04);
  }


  .access-card > span {
    padding:
      .45rem
      .55rem;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: .76rem;
    font-weight: 700;

    line-height: 1.05;
  }


  .activity-items {
    display: grid;
    gap: .5rem;
  }


  .activity-card {
    display: grid;

    grid-template-columns:
      28px
      minmax(0,1fr)
      auto;

    gap: .5rem;

    align-items: center;

    min-height: 52px;

    padding:
      .45rem
      .55rem;

    border:
      1px solid #e4ddd2;

    border-radius: .65rem;

    background: #faf8f4;
    color: #151e21;

    text-decoration: none;
  }


  .activity-card > span {
    color: #a86418;

    font-size: .58rem;
    font-weight: 950;
  }


  .activity-card strong {
    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: .76rem;
    line-height: 1.05;
  }


  .activity-card b {
    color: #9c6118;
  }


  .access-empty {
    color: #797166;

    font-size: .72rem;
  }



  /* ========================================================
