---

<section id="hubs" class="hubs-page">

  <div class="hub-hero">
    <div class="hub-hero-bg" aria-hidden="true">
      {hubs.map((hub, index) => (
        <img
          src={hub.image}
          alt=""
          class={`hub-bg-image ${index === 0 ? 'is-active' : ''}`}
          data-bg-index={index}
        />
      ))}
      <div class="hub-hero-overlay"></div>
    </div>

    <div class="hub-container hub-hero-content">
      <p class="section-kicker">Travel Hubs</p>

      <h1>
        Use Afghanistan's cities as your gateways.
      </h1>

      <p>
        Each hub connects you to places to stay, local food, cultural and
        historical attractions, activities, and the routes that continue
        deeper into the country.
      </p>
    </div>
  </div>


  <div class="hub-container">

    <section class="hub-chooser">

      <div class="hub-chooser-heading">
        <div>
          <p class="section-kicker">Choose a hub</p>
          <h2>Where do you want to base your journey?</h2>
        </div>

        <span>{hubs.length} travel hubs</span>
      </div>


      <div class="hub-grid" id="hub-selector">

        {hubs.map((hub, index) => (
          <button
            type="button"
            data-hub-index={index}
            class={`hub-choice ${index === 0 ? 'is-active' : ''}`}
          >
            <img
              src={hub.cardImage || hub.image}
              alt={hub.name}
              loading={index > 3 ? 'lazy' : 'eager'}
            />

            <span class="hub-choice-copy">
              <small>{hub.type}</small>
              <strong>{hub.name}</strong>
              <em>{hub.province} Province</em>
            </span>
          </button>
        ))}

      </div>

    </section>


    <section class="selected-hub">

      <div class="selected-hub-image">
        <img
          id="hub-main-image"
          src={hubs[0].cardImage || hubs[0].image}
          alt={hubs[0].name}
        />

        <div class="selected-image-label">
          <span id="hub-type">{hubs[0].type}</span>
          <strong id="hub-image-name">{hubs[0].name}</strong>
        </div>
      </div>


      <div class="selected-hub-copy">

        <p class="section-kicker" id="hub-label">
          {hubs[0].province} Province
        </p>

        <h2 id="hub-title">{hubs[0].name}</h2>

        <p id="hub-summary" class="hub-summary">
          {hubs[0].summary}
        </p>

        <div id="hub-stats" class="hub-stats">
          {hubs[0].stats.map((stat) => (
            <span>{stat}</span>
          ))}
        </div>

        <div class="hub-actions">
          <a
            id="hub-open-link"
            class="hub-button-primary"
            href={`/hubs/${hubs[0].slug}/`}
          >
            Explore this hub
          </a>

          <a
            id="hub-plan-link"
            class="hub-button-secondary"
            href={`/contact/?hub=${hubs[0].slug}`}
          >
            Plan from this hub
          </a>
        </div>

      </div>

    </section>


    <section class="hub-access">

      <div class="hub-access-heading">
        <div>
          <p class="section-kicker">Accessible from this hub</p>

          <h2 id="access-title">
            What you can experience from {hubs[0].name}
          </h2>
        </div>

        <p>
          Hotels, food, attractions and activities are shown together so you
          can understand what each hub actually gives you access to.
        </p>
      </div>


      <div class="access-grid">

        <!-- HOTELS -->

        <section class="access-column">

          <div class="access-column-heading">
            <span class="access-icon">01</span>

            <div>
              <small>Stay</small>
              <h3>Hotels</h3>
            </div>

            <a href="/hotels/">All hotels →</a>
          </div>

          <div
            id="hub-hotels"
            class="access-items"
          ></div>

        </section>


