---
/**
 * Homepage / supporting band that points to separated product families.
 * Not a mixed TourCard grid of Winter Circuit + Scientific + Media.
 */
const cards = [
  {
    title: 'Build My Journey',
    label: 'Custom Journey',
    image: '/assets/images/custom-tours/custom-expedition/hero.webp',
    text: 'Private leisure planning with no predetermined duration, itinerary, route, or package price.',
    href: '/custom-requests/',
    cta: 'Start Build My Journey'
  },
  {
    title: 'Specialist Services',
    label: 'Proposal-led logistics',
    image: '/assets/images/custom-tours/photography-tour/hero.webp',
    text: 'Photography, research, media, business, and expedition support — not fixed tour packages.',
    href: '/specialist-services/',
    cta: 'Browse specialist services'
  },
  {
    title: 'Return Journeys',
    label: 'Diaspora & veterans',
    image: '/assets/images/custom-tours/veteran-return/hero.webp',
    text: 'Heritage returns and veterans, contractors, and diplomats visits — distinct from leisure tours.',
    href: '/return-journeys/',
    cta: 'Explore return journeys'
  }
];
---

<section id="custom-tours" class="custom-tours-section">
  <div class="custom-wrap">
    <div class="custom-copy">
      <p class="section-kicker">Beyond the tour catalog</p>
      <h2>Custom, specialist, and return planning.</h2>
      <p class="custom-intro">
        Not every journey belongs in the tour grid. Choose the planning path that matches your goals —
        then request a proposal from our Kabul team.
      </p>
      <a href="/custom-requests/" class="custom-main-button">Build My Journey</a>
      <p class="custom-helper">Prefer a published itinerary? <a href="/tours/">Browse tour packages</a>.</p>
    </div>

    <div class="custom-services">
      <div class="custom-service-note">
        <span>No fake Day 1–N</span>
        <span>Proposal-led</span>
        <span>Separated from tours</span>
      </div>

      <div class="custom-grid">
        {cards.map((card) => (
          <a class="custom-card" href={card.href}>
            <div class="custom-card__image">
              <img src={card.image} alt={card.title} loading="lazy" />
            </div>
            <div class="custom-card__content">
              <p class="custom-card__label">{card.label}</p>
              <h3>{card.title}</h3>
              <p class="custom-card__text">{card.text}</p>
              <span class="custom-card__cta">{card.cta} →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .custom-tours-section {
    background: #f1eadc;
    padding: clamp(3rem, 5vw, 4.5rem) 0;
  }
  .custom-wrap {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
    display: grid;
    grid-template-columns: .9fr 1.2fr;
    gap: 2rem;
    align-items: start;
  }
  .section-kicker {
    margin: 0;
    color: #b46b00;
    font-size: .72rem;
    letter-spacing: .22em;
    text-transform: uppercase;
    font-weight: 900;
  }
  .custom-copy h2 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    line-height: 1.05;
    margin: .55rem 0 1rem;
  }
  .custom-intro { color: #4b5563; line-height: 1.7; }
  .custom-main-button {
    display: inline-block;
    margin-top: 1.2rem;
    background: #b98237;
    color: #fff;
    text-decoration: none;
    padding: .95rem 1.25rem;
    border-radius: .35rem;
    font-size: .78rem;
    font-weight: 900;
    text-transform: uppercase;
  }
  .custom-helper { margin-top: .9rem; color: #5a5146; font-size: .92rem; }
  .custom-helper a { color: #101820; font-weight: 700; }
  .custom-service-note {
    display: flex;
    flex-wrap: wrap;
    gap: .55rem;
    margin-bottom: .9rem;
  }
  .custom-service-note span {
    border: 1px solid #e3d7c5;
    background: #fff;
    border-radius: 999px;
    padding: .45rem .8rem;
    font-size: .78rem;
    font-weight: 800;
    color: #5a5146;
  }
  .custom-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: .9rem;
  }
  .custom-card {
    display: grid;
    grid-template-columns: 140px 1fr;
    background: #fff;
    border: 1px solid #e3d7c5;
    border-radius: .75rem;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }
  .custom-card__image img {
    width: 100%;
    height: 100%;
    min-height: 130px;
    object-fit: cover;
    display: block;
  }
  .custom-card__content { padding: 1rem 1.1rem; display: grid; gap: .35rem; }
  .custom-card__label {
    margin: 0;
    color: #b46b00;
    font-size: .66rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    font-weight: 900;
  }
  .custom-card h3 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.25rem;
  }
  .custom-card__text { margin: 0; color: #4b5563; line-height: 1.55; font-size: .92rem; }
  .custom-card__cta { color: #b98237; font-weight: 800; font-size: .88rem; }
  @media (max-width: 900px) {
    .custom-wrap { grid-template-columns: 1fr; }
    .custom-card { grid-template-columns: 110px 1fr; }
  }
</style>
