---
const navItems = [
  ["Home", "/"],
  ["Tours", "/tours/"],
  ["Destinations", "/destinations/"],
  ["Attractions", "/attractions/"],
  ["About", "/about/"],
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-brand" href="/" aria-label="AfghanTours home">
      <img src="/assets/images/logo/header-logo.webp" alt="Afghan Tours" />
      <div>
        <strong>Afghan Tours</strong>
        <span>Come for the history, stay for the hospitality</span>
      </div>
    </a>

    <nav class="site-nav" aria-label="Main navigation">
      {navItems.map(([label, href]) => (
        <a href={href}>{label}</a>
      ))}
      <a class="site-nav__cta" href="/contact/">Contact</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(10, 10, 9, 0.94);
    border-bottom: 1px solid rgba(255,255,255,.08);
    backdrop-filter: blur(16px);
    color: #fff;
  }

  .site-header__inner {
    width: min(1280px, calc(100% - 2rem));
    min-height: 76px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .site-brand {
    display: flex;
    align-items: center;
    gap: .85rem;
    color: inherit;
    text-decoration: none;
  }

  .site-brand img {
    width: auto;
    height: 48px;
    object-fit: contain;
  }

  .site-brand strong {
    display: block;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.6rem, 2.2vw, 2.15rem);
    line-height: .9;
    letter-spacing: -.04em;
  }

  .site-brand span {
    display: block;
    margin-top: .25rem;
    color: rgba(255,255,255,.7);
    font-size: .76rem;
    font-weight: 700;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.65rem;
    font-size: .9rem;
    font-weight: 900;
  }

  .site-nav a {
    color: #fff;
    text-decoration: none;
  }

  .site-nav a:hover {
    color: #d6a23a;
  }

  .site-nav__cta {
    border-radius: 999px;
    background: #d6a23a;
    color: #111 !important;
    padding: .95rem 1.35rem;
  }

  .site-nav__cta:hover {
    background: #fff;
  }

  @media(max-width: 860px) {
    .site-header__inner {
      align-items: flex-start;
      padding: .85rem 0;
      flex-direction: column;
      gap: .9rem;
    }

    .site-nav {
      width: 100%;
      overflow-x: auto;
      gap: 1rem;
      padding-bottom: .35rem;
    }

    .site-brand span {
      display: none;
    }
  }
</style>
