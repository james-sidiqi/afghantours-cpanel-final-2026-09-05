---
const tourLinks = [
  ['All Tours', '/tours/'],
  ['Scheduled Tours', '/tours/#scheduled-tours'],
  ['Private Tours', '/tours/#private-tours'],
  ['Build My Journey', '/custom-requests/'],
  ['Specialist Services', '/specialist-services/'],
  ['Return Journeys', '/return-journeys/'],
];

const exploreLinks = [
  ['Attractions', '/attractions/'],
  ['Cultural Experiences', '/cultural-experiences/'],
  ['Culinary Experiences', '/cultural-experiences/culinary/'],
  ['Activities', '/activities/'],
  ['Province Directory', '/destinations/#provinces'],
];

const planLinks = [
  ['Travel Hubs', '/hubs/'],
  ['Transportation', '/transportation/'],
  ['Visa & Entry', '/visa-entry/'],
  ['FAQ', '/faq/'],
];

const informationLinks = [
  ['About', '/about/'],
  ['Safety', '/safety/'],
  ['Contact', '/contact/'],
];
---

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <a class="site-brand" href="/" aria-label="AfghanTours home">
      <img src="/assets/images/logo/header-logo.webp" alt="Afghan Tours" width="58" height="48" />
      <div class="site-brand__copy">
        <strong>Afghan Tours</strong>
        <span>Come for the history, stay for the hospitality</span>
      </div>
    </a>

    <a class="site-nav__cta site-nav__cta--bar" href="/contact/">Contact Us</a>

    <button class="site-menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      <span class="site-menu-toggle__icon" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="site-menu-toggle__label">Menu</span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Main navigation" data-site-nav>
      {[
        ['tours', 'Tours', tourLinks],
        ['explore', 'Explore', exploreLinks],
        ['plan', 'Plan', planLinks],
        ['info', 'Information', informationLinks],
      ].map(([id, label, links]: any) => (
        <div class="site-nav__group" data-nav-group>
          <button class="site-nav__link" type="button" aria-expanded="false" aria-controls={`site-dd-${id}`} data-nav-trigger>
            {label}
            <span class="site-nav__chevron" aria-hidden="true"></span>
          </button>
          <div class="site-dropdown" id={`site-dd-${id}`} data-nav-panel>
            {links.map(([l, href]: any) => <a href={href}>{l}</a>)}
          </div>
        </div>
      ))}
      <a class="site-nav__cta site-nav__cta--menu" href="/contact/">Contact Us</a>
    </nav>
  </div>
</header>

<script>
  // One shared controller for every page: click/tap/keyboard open, Escape + outside tap close.
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const nav = header.querySelector<HTMLElement>('[data-site-nav]');
    const groups = Array.from(header.querySelectorAll<HTMLElement>('[data-nav-group]'));
    const mq = window.matchMedia('(max-width: 1023px)');
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');

    const setGroup = (g: HTMLElement, open: boolean) => {
      g.classList.toggle('is-open', open);
      g.querySelector('[data-nav-trigger]')?.setAttribute('aria-expanded', String(open));
    };
    const closeGroups = (except?: HTMLElement) => groups.forEach((g) => g !== except && setGroup(g, false));
    const setMenu = (open: boolean) => {
      header.classList.toggle('is-menu-open', open);
      toggle?.setAttribute('aria-expanded', String(open));
      if (toggle) toggle.querySelector('.site-menu-toggle__label')!.textContent = open ? 'Close' : 'Menu';
      document.documentElement.classList.toggle('site-menu-lock', open && mq.matches);
      if (!open) closeGroups();
    };

    toggle?.addEventListener('click', () => setMenu(!header.classList.contains('is-menu-open')));

    groups.forEach((g) => {
      const trigger = g.querySelector<HTMLButtonElement>('[data-nav-trigger]');
      trigger?.addEventListener('click', (e) => {
        e.preventDefault();
        // A mouse click right after hover-open should keep it open, not toggle it shut.
        const hoverOpened = Date.now() - Number(g.dataset.hoverAt || 0) < 600;
        const open = hoverOpened ? true : !g.classList.contains('is-open');
        g.dataset.hoverAt = '';
        closeGroups(g);
        setGroup(g, open);
      });
      // Desktop mouse users also get hover; touch never relies on hover.
      g.addEventListener('mouseenter', () => { if (fine.matches && !mq.matches && !g.classList.contains('is-open')) { closeGroups(g); setGroup(g, true); g.dataset.hoverAt = String(Date.now()); } });
      g.addEventListener('mouseleave', () => { if (fine.matches && !mq.matches) setGroup(g, false); });
      g.addEventListener('focusout', (e) => {
        const next = (e as FocusEvent).relatedTarget as Node | null;
        if (!mq.matches && next && !g.contains(next)) setGroup(g, false);
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const openGroup = groups.find((g) => g.classList.contains('is-open'));
      if (openGroup) { setGroup(openGroup, false); openGroup.querySelector<HTMLElement>('[data-nav-trigger]')?.focus(); return; }
      if (header.classList.contains('is-menu-open')) { setMenu(false); toggle?.focus(); }
    });

    const outside = (e: Event) => {
      if (header.contains(e.target as Node)) return;
      closeGroups();
      if (header.classList.contains('is-menu-open')) setMenu(false);
    };
    document.addEventListener('pointerdown', outside);
    document.addEventListener('touchstart', outside, { passive: true });

    mq.addEventListener?.('change', () => setMenu(false));
    nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  }
</script>

<style>
  /* Opaque by design: literal fallbacks so the header never turns transparent if tokens fail to load. */
  .site-header {
    --hdr-bg: #0f241b;
    --hdr-bg-2: #0a1a13;
    --hdr-text: #f4efe4;
    --hdr-gold: var(--at-gold, #d6a23a);
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    background-color: var(--hdr-bg);
    background-image: linear-gradient(90deg, var(--hdr-bg-2) 0%, var(--hdr-bg) 55%, var(--hdr-bg-2) 100%);
    border-bottom: 1px solid rgba(214, 162, 58, .28);
    color: var(--hdr-text);
  }
  .site-header__inner {
    position: relative;
    width: min(1280px, calc(100% - 2rem));
    min-height: 78px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .site-brand { min-width: 0; display: flex; align-items: center; gap: .85rem; color: var(--hdr-text); text-decoration: none; margin-right: auto; }
  .site-brand img { display: block; width: auto; height: 48px; flex: 0 0 auto; }
  .site-brand__copy { min-width: 0; }
  .site-brand strong { display: block; color: #fff; font-family: var(--font-display, Georgia, serif); font-size: clamp(1.45rem, 2vw, 2.1rem); font-weight: 700; line-height: .95; letter-spacing: -.03em; white-space: nowrap; }
  .site-brand span { display: block; margin-top: .3rem; color: var(--hdr-gold); font-size: .74rem; font-weight: 800; line-height: 1.1; white-space: nowrap; }

  .site-nav { display: flex; align-items: center; gap: 1.2rem; font-size: .88rem; font-weight: 800; }
  .site-nav a { text-decoration: none; }
  .site-nav__group { position: relative; }

  .site-nav__link {
    display: inline-flex; align-items: center; gap: .4rem;
    padding: 1.7rem .1rem;
    border: 0; background: none; cursor: pointer;
    color: var(--hdr-text); font: inherit; white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
  }
  .site-nav__chevron { width: .42rem; height: .42rem; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: translateY(-2px) rotate(45deg); transition: transform .16s ease; opacity: .85; }
  .site-nav__group.is-open > .site-nav__link .site-nav__chevron { transform: translateY(1px) rotate(-135deg); }
  .site-nav__link:hover, .site-nav__group.is-open > .site-nav__link { color: var(--hdr-gold); }

  .site-header :focus-visible { outline: 2px solid var(--hdr-gold); outline-offset: 3px; border-radius: 6px; }

  .site-dropdown {
    position: absolute; top: calc(100% - .4rem); left: 50%; z-index: 1100;
    min-width: 230px; padding: .5rem;
    border: 1px solid rgba(214, 162, 58, .22); border-radius: .8rem;
    background: #0d2018; box-shadow: 0 18px 44px rgba(0, 0, 0, .35);
    visibility: hidden; opacity: 0; transform: translateX(-50%) translateY(6px);
    transition: opacity .15s ease, transform .15s ease, visibility 0s linear .15s;
  }
  .site-nav__group.is-open > .site-dropdown { visibility: visible; opacity: 1; transform: translateX(-50%) translateY(0); transition: opacity .15s ease, transform .15s ease; }
  .site-dropdown a { display: block; padding: .72rem .85rem; border-radius: .55rem; color: rgba(244, 239, 228, .9); font-size: .86rem; font-weight: 700; white-space: nowrap; }
  .site-dropdown a:hover, .site-dropdown a:focus-visible { background: rgba(214, 162, 58, .14); color: var(--hdr-gold); }

  .site-nav__cta {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 48px; padding: .75rem 1.35rem; border-radius: 999px;
    background: var(--hdr-gold); color: #121713 !important;
    font-size: .86rem; font-weight: 900; white-space: nowrap; text-decoration: none;
  }
  .site-nav__cta:hover { background: var(--at-gold-light, #f3b72d); }
  .site-nav__cta--bar { display: none; }

  .site-menu-toggle { display: none; }

  /* ===== Mobile + tablet: one proper menu panel ===== */
  @media (max-width: 1023px) {
    .site-header__inner { min-height: 64px; width: min(100% - 1.25rem, 1280px); gap: .6rem; }
    .site-brand img { height: 40px; }
    .site-brand strong { font-size: 1.35rem; }
    .site-brand span { font-size: .62rem; }

    .site-nav__cta--bar { display: inline-flex; min-height: 40px; padding: .5rem .95rem; font-size: .8rem; }
    .site-nav__cta--menu { display: none; }

    .site-menu-toggle {
      display: inline-flex; align-items: center; gap: .45rem;
      min-height: 40px; padding: .45rem .7rem;
      border: 1px solid rgba(244, 239, 228, .35); border-radius: .6rem;
      background: transparent; color: var(--hdr-text); font: inherit; font-size: .8rem; font-weight: 800; cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .site-menu-toggle__icon { display: grid; gap: 4px; width: 18px; }
    .site-menu-toggle__icon span { display: block; height: 2px; border-radius: 2px; background: currentColor; transition: transform .16s ease, opacity .16s ease; }
    .site-header.is-menu-open .site-menu-toggle__icon span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
    .site-header.is-menu-open .site-menu-toggle__icon span:nth-child(2) { opacity: 0; }
    .site-header.is-menu-open .site-menu-toggle__icon span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

    .site-nav {
      position: absolute; top: 100%; left: 50%; transform: translateX(-50%);
      width: 100vw; max-height: calc(100dvh - 64px); overflow-y: auto; overscroll-behavior: contain;
      display: none; flex-direction: column; align-items: stretch; gap: 0;
      padding: .4rem 1rem 1.2rem;
      background: #0d2018; border-bottom: 1px solid rgba(214, 162, 58, .28);
      box-shadow: 0 18px 40px rgba(0, 0, 0, .35);
    }
    .site-header.is-menu-open .site-nav { display: flex; }
    .site-nav__group { border-bottom: 1px solid rgba(244, 239, 228, .1); }
    .site-nav__link { width: 100%; justify-content: space-between; padding: 1rem .25rem; font-size: 1rem; }
    .site-dropdown {
      position: static; transform: none; min-width: 0; padding: 0 0 .6rem .4rem;
      border: 0; border-radius: 0; background: none; box-shadow: none;
      display: none; visibility: visible; opacity: 1; transition: none;
    }
    .site-nav__group.is-open > .site-dropdown { display: block; transform: none; }
    .site-dropdown a { padding: .7rem .6rem; font-size: .95rem; white-space: normal; }
  }

  @media (max-width: 400px) {
    .site-brand__copy span { display: none; }
    .site-brand strong { font-size: 1.2rem; }
    .site-brand img { height: 36px; }
    .site-menu-toggle__label { display: none; }
    .site-nav__cta--bar { padding: .5rem .75rem; }
  }

  @media (max-width: 360px) {
    .site-brand { gap: .4rem; }
    .site-brand strong { font-size: .9rem; letter-spacing: -.02em; }
    .site-brand img { height: 32px; }
    .site-nav__cta--bar { padding: .45rem .6rem; font-size: .78rem; }
  }
</style>

<style is:global>
  html.site-menu-lock, html.site-menu-lock body { overflow: hidden; }
</style>
