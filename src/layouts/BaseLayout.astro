---
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/editorial.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import IconTest from '../components/IconTest.astro';
import TourInquiryModal from '../components/TourInquiryModal.astro';
import TourSalesBridge from '../components/TourSalesBridge.astro';
import ImageLightbox from '../components/ImageLightbox.astro';

const {
  title = 'AfghanTours',
  description = 'Kabul-based journeys across Afghanistan, planned with local knowledge, experienced guides, trusted drivers, and realistic routes.',
  image = '/assets/images/heroes/home/hero.webp',
  robots = 'index,follow,max-image-preview:large'
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://afghantours.com').toString();
const ogImage = new URL(image, Astro.site ?? 'https://afghantours.com').toString();
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: 'AfghanTours.com',
  alternateName: 'James Tourist & Travel Agency',
  url: 'https://afghantours.com/',
  logo: 'https://afghantours.com/assets/images/logo/header-logo.webp',
  image: ogImage,
  email: 'info@afghantours.com',
  telephone: '+93780123456',
  contactPoint: [
    { '@type': 'ContactPoint', contactType: 'customer service', email: 'info@afghantours.com', telephone: '+93780123456' },
    { '@type': 'ContactPoint', contactType: 'reservations', email: 'reservations@afghantours.com', telephone: '+93780123456' },
  ],
  identifier: { '@type': 'PropertyValue', name: 'Afghanistan tour operator license', value: 'ATO-KBL-1617' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: '2nd Floor, Majid Mall, Shahr-e-Naw, District 10',
    addressLocality: 'Kabul',
    addressCountry: 'AF',
  },
  areaServed: { '@type': 'Country', name: 'Afghanistan' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="AfghanTours.com" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
  </head>
  <body>
    <script is:inline>
      // Shared fallback: a failed image never shows a broken icon; its frame gets the brand no-image style.
      document.addEventListener('error', function (e) {
        var t = e.target;
        if (t && t.tagName === 'IMG' && !t.classList.contains('img-failed')) {
          t.classList.add('img-failed');
          if (t.parentElement) t.parentElement.classList.add('img-missing');
        }
      }, true);
    </script>
    <Header />
    <main>
      <slot />
    </main>
    <a class="floating-whatsapp" href="https://wa.me/93780123456" aria-label="Contact AfghanTours on WhatsApp">
      <IconTest name="lucide:message-circle" class="floating-whatsapp__icon" />
      <span>WhatsApp</span>
    </a>
    <TourSalesBridge />
    <TourInquiryModal />
    <Footer />
    <ImageLightbox />
    <script is:inline>
      // WhatsApp prefill: add the tour / experience name (page H1) to wa.me links that have no text yet.
      (function () {
        var h1 = document.querySelector('h1');
        var name = (h1 && h1.textContent ? h1.textContent : document.title.split('|')[0]).replace(/\s+/g, ' ').trim().slice(0, 120);
        var text = 'Hello AfghanTours, I would like information about: ' + name + ' (' + location.pathname + ')';
        document.querySelectorAll('a[href^="https://wa.me/93780123456"]').forEach(function (a) {
          try { var u = new URL(a.href); if (!u.searchParams.has('text')) { u.searchParams.set('text', text); a.href = u.toString(); } } catch (e) {}
        });
      })();
    </script>
    <style is:global>
      .img-missing { background: linear-gradient(135deg, #0f241b, #163a2a) !important; }
      img.img-failed { visibility: hidden; }
    </style>
  </body>
</html>
