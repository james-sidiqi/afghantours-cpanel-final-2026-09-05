---
/**
 * /cancellation-refund-rescheduling/ — rendered from src/content/legal/cancellation-refund-rescheduling.md.
 * Gated: the route is only generated when the owner's full policy text has been merged
 * (frontmatter policy_full_text_received: true). POLICY_PREVIEW=1 builds a noindex staff preview.
 */
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entry = await getEntry('legal', 'cancellation-refund-rescheduling');
  const enabled = entry?.data.policy_full_text_received === true;
  const preview = process.env.POLICY_PREVIEW === '1';
  return enabled || preview ? [{ params: { gate: undefined } }] : [];
}

const entry = await getEntry('legal', 'cancellation-refund-rescheduling');
if (!entry) throw new Error('legal/cancellation-refund-rescheduling.md missing');
const { Content } = await entry.render();
const d = entry.data;
const published = d.policy_full_text_received === true;
const effective = new Date(`${d.effective_date}T00:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title={`${d.title} | AfghanTours`} description={d.description} robots={published ? 'index,follow' : 'noindex,nofollow'}>
  <main class="legal-doc">
    {!published && (
      <p class="legal-doc__preview" role="note">
        STAFF PREVIEW — not published. The full policy text has not been merged yet; only the owner-approved additions are shown.
      </p>
    )}
    <header>
      <p class="eyebrow">{d.legal_entity} · {d.operating_as} · {d.license}</p>
      <h1>{d.title}</h1>
      <p class="legal-doc__meta">Effective date: {effective}{d.version ? ` · Version ${d.version}` : ''}</p>
    </header>
    <article class="content-card">
      <Content />
    </article>
    <p class="legal-doc__related"><a href="/terms/">Terms</a></p>
  </main>
</BaseLayout>

<style>
  .legal-doc { max-width: 820px; margin: 0 auto; padding: 7rem 1.25rem 4rem; }
  .legal-doc h1 { font: 700 clamp(2rem, 4vw, 2.8rem)/1.1 Georgia, 'Times New Roman', serif; margin: .3rem 0 .6rem; }
  .legal-doc__meta { color: #6b6d66; margin: 0 0 1.5rem; }
  .legal-doc__preview { background: #fbe7c6; border: 1px solid #d7b46a; border-radius: 8px; padding: .7rem .9rem; font-weight: 700; }
  .legal-doc article :global(h2) { font: 700 1.35rem/1.2 Georgia, serif; margin: 2rem 0 .6rem; }
  .legal-doc article :global(p) { line-height: 1.7; }
</style>
