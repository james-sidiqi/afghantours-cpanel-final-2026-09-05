---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSpecialistServices } from '../../lib/buildRelations';

const services = getSpecialistServices();
---
<BaseLayout
  title="Specialist Services | AfghanTours"
  description="Proposal-led specialist support for photography, research, media, business, mountaineering, and related fieldwork — not fixed tour packages."
  image="/assets/images/custom-tours/scientific-expeditions/hero.webp"
>
  <section class="svc-hero">
    <div class="svc-wrap">
      <p class="kicker">Specialist Services</p>
      <h1>Support built around your brief — not a brochure itinerary.</h1>
      <p class="lead">
        These are proposal-led services for photographers, researchers, journalists, business visitors,
        mountaineers, and other specialist teams. We do not advertise fixed durations, Day&nbsp;1–N
        itineraries, scheduled leisure departures, or catalog “from” prices for this work.
      </p>
      <div class="svc-cta-row">
        <a class="btn-primary" href="/contact/?type=specialist">Request a Proposal</a>
        <a class="btn-ghost" href="/tours/">Browse Tour Packages</a>
        <a class="btn-ghost" href="/return-journeys/">Return Journeys</a>
      </div>
    </div>
  </section>

  <section class="svc-grid-section">
    <div class="svc-wrap">
      <div class="svc-grid">
        {services.map((s) => (
          <a class="svc-card" href={`/specialist-services/${s.slug}/`}>
            <div class="svc-card__img">
              <img src={s.hero_image_path || s.image_path} alt="" loading="lazy" />
            </div>
            <div class="svc-card__body">
              <p class="svc-card__label">Specialist · proposal-led</p>
              <h2>{s.name}</h2>
              <p>{s.summary}</p>
              <span class="svc-card__cta">{s.cta_label || 'Request a Proposal'} →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .svc-wrap { width: min(1180px, calc(100% - 2rem)); margin: 0 auto; }
  .svc-hero { background: #101820; color: #fff; padding: clamp(3.5rem, 6vw, 5.5rem) 0; }
  .kicker { margin: 0; color: #d6a548; font-size: .72rem; letter-spacing: .22em; text-transform: uppercase; font-weight: 900; }
  .svc-hero h1 { font-family: Georgia, "Times New Roman", serif; font-size: clamp(2.4rem, 5vw, 3.8rem); line-height: 1.05; letter-spacing: -.04em; margin: .6rem 0 1rem; max-width: 18ch; }
  .lead { max-width: 62ch; color: rgba(255,255,255,.82); line-height: 1.7; }
  .svc-cta-row { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.6rem; }
  .btn-primary, .btn-ghost { text-decoration: none; padding: .9rem 1.2rem; border-radius: .35rem; font-size: .78rem; font-weight: 900; text-transform: uppercase; }
  .btn-primary { background: #b98237; color: #fff; }
  .btn-ghost { border: 1px solid rgba(255,255,255,.45); color: #fff; }
  .svc-grid-section { padding: 3.5rem 0 5rem; background: #f7f4ee; }
  .svc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.25rem; }
  .svc-card { background: #fff; border: 1px solid #e5dccf; border-radius: .75rem; overflow: hidden; text-decoration: none; color: inherit; box-shadow: 0 10px 28px rgba(40,28,12,.06); display: flex; flex-direction: column; }
  .svc-card__img img { width: 100%; height: 190px; object-fit: cover; display: block; }
  .svc-card__body { padding: 1.15rem 1.2rem 1.35rem; display: grid; gap: .55rem; }
  .svc-card__label { margin: 0; color: #b46b00; font-size: .68rem; letter-spacing: .16em; text-transform: uppercase; font-weight: 900; }
  .svc-card h2 { margin: 0; font-family: Georgia, "Times New Roman", serif; font-size: 1.45rem; line-height: 1.15; }
  .svc-card p { margin: 0; color: #4b5563; line-height: 1.6; font-size: .95rem; }
  .svc-card__cta { color: #b98237; font-weight: 800; font-size: .88rem; margin-top: .3rem; }
</style>
