---
import fs from 'node:fs';
import path from 'node:path';

import BaseLayout from '../../layouts/BaseLayout.astro';
import TourCardGrid from '../../components/cards/TourCardGrid.astro';

import { getCollection } from 'astro:content';
import { getTours } from '../../lib/buildRelations';
import { culinaryLinksForFoodSlug } from '../../lib/culinary';

export async function getStaticPaths() {
  const foodEntries = await getCollection('food');

  return foodEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const data = entry.data as any;
const allFood = await getCollection('food');
const allTours = getTours();

const foodPath = entry.slug || entry.id.replace(/\.md$/, '');
const parts = foodPath.split('/');
const categorySlug = parts.length > 1 ? parts[0] : 'food';
const baseSlug = parts[parts.length - 1];

/*
 * entry.slug is not always enough to determine the original content
 * category. entry.id preserves the source path such as dishes/foo.md.
 */
const sourceFoodPath = entry.id.replace(/\.md$/, '');
const sourceParts = sourceFoodPath.split('/');
const sourceCategorySlug =
  sourceParts.length > 1 ? sourceParts[0] : categorySlug;
const sourceBaseSlug =
  sourceParts[sourceParts.length - 1];

const title = data.title || baseSlug;
const subtitle =
  data.subtitle ||
  data.card_description ||
  'A taste of Afghanistan connected to place, hospitality, and the journey itself.';

const description =
  data.card_description ||
  data.subtitle ||
  `Explore ${title} as part of Afghanistan's regional food and hospitality culture.`;

/*
 * Resolve real food photography from the asset library before falling
 * back to generic imagery. This also handles historic spelling/slug
 * differences in the imported AfghanTours image archive.
 */
const foodAssetRoots: Record<string, string> = {
  dishes: '/assets/images/food/dishes',
  drinks: '/assets/images/food/drinks',
  produce: '/assets/images/food/produce',
  'dried-fruits': '/assets/images/food/dried-fruit',
  desserts: '/assets/images/food/sweets',
};

const imageSlugAliases: Record<string, string[]> = {
  'kabuli-pulao': ['kabuli-palaw'],
  'qabuli-palaw': ['kabuli-palaw', 'kabuli-pulao'],
  samosa: ['sambosa'],
  'sambosa-pastry': ['sambosa'],
  aushak: ['ashak'],
  ashak: ['aushak'],
  dogh: ['doogh'],
  'farah-watermelon': ['farah-watermellons'],
};

const publicAssetExists = (publicPath: string) => {
  if (!publicPath || !publicPath.startsWith('/')) return false;

  return fs.existsSync(
    path.join(
      process.cwd(),
      'public',
      publicPath.replace(/^\/+/, '')
    )
  );
};

const categoryCandidates = [
  sourceCategorySlug,
  categorySlug,
].filter(
  (value, index, array) =>
    value &&
    array.indexOf(value) === index
);

const slugCandidates = [
  baseSlug,
  sourceBaseSlug,
  ...(imageSlugAliases[baseSlug] || []),
  ...(imageSlugAliases[sourceBaseSlug] || []),
].filter(
  (value, index, array) =>
    value &&
    array.indexOf(value) === index
);

const dedicatedFolderCandidates: string[] = [];

for (const category of categoryCandidates) {
  const root = foodAssetRoots[category];

  if (!root) continue;

  for (const candidateSlug of slugCandidates) {
    dedicatedFolderCandidates.push(
      `${root}/${candidateSlug}/`
    );
  }
}

/*
 * Some food experiences were historically stored in the
 * cultural-experiences image tree.
 */
for (const candidateSlug of slugCandidates) {
  dedicatedFolderCandidates.push(
    `/assets/images/cultural-experiences/${candidateSlug}/`
  );
}

const resolvedFoodImageFolder =
  dedicatedFolderCandidates.find((folder) =>
    publicAssetExists(`${folder}hero.webp`)
  ) ||
  dedicatedFolderCandidates.find((folder) => {
    const diskFolder = path.join(
      process.cwd(),
      'public',
      folder.replace(/^\/+/, '')
    );

    try {
      return (
        fs.existsSync(diskFolder) &&
        fs.readdirSync(diskFolder).some((file) =>
          /\.(webp|jpg|jpeg|png|avif)$/i.test(file)
        )
      );
    } catch {
      return false;
    }
  }) ||
  '';

const dedicatedHero =
  resolvedFoodImageFolder &&
  publicAssetExists(`${resolvedFoodImageFolder}hero.webp`)
    ? `${resolvedFoodImageFolder}hero.webp`
    : '';

const heroImage =
  dedicatedHero ||
  data.hero_image ||
  data.image ||
  '/assets/images/heroes/food-and-culture/hero.webp';

const categoryLabels: Record<string, string> = {
  dishes: 'Afghan Dish',
  drinks: 'Tea & Drinks',
  produce: 'Regional Produce',
  'dried-fruits': 'Dried Fruits & Nuts',
  desserts: 'Sweets & Desserts',
};

const categoryLabel =
  data.experience_type ||
  data.category ||
  categoryLabels[categorySlug] ||
  'Food & Culture';

const provinces = Array.isArray(data.provinces) ? data.provinces : [];
const pairedFoods = Array.isArray(data.paired_foods) ? data.paired_foods : [];
const nearby = Array.isArray(data.nearby) ? data.nearby : [];

const bestSeason = data.best_season || 'Year round / availability varies';
const duration =
  data.duration ||
  (data.duration_hours ? `${data.duration_hours} hours` : 'Flexible');

const normalizeKey = (value: any) =>
  String(value || '')
    .toLowerCase()
    .normalize('NFKD')
    .replace(/[’']/g, '')
    .replace(/&/g, 'and')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');

const explicitTourSlugs = (Array.isArray(data.related_tours) ? data.related_tours : [])
  .map((tour: any) => {
    if (typeof tour === 'string') return tour;
    return tour?.slug || tour?.tour_slug || '';
  })
  .filter(Boolean);

/*
 * Some legacy food records contain useful frontmatter fields that are
 * not exposed by the active Astro collection schema. Read only the
 * related_tours list as a fallback so those explicit editorial
 * relationships are not lost during schema parsing.
 */
let frontmatterRelatedTourSlugs: string[] = [];

try {
  const sourcePath = path.join(
    process.cwd(),
    'src',
    'content',
    'food',
    `${foodPath}.md`
  );

  if (fs.existsSync(sourcePath)) {
    const source = fs.readFileSync(sourcePath, 'utf8');
    const frontmatterMatch = source.match(/^---\s*\n([\s\S]*?)\n---/);

    if (frontmatterMatch) {
      const fm = frontmatterMatch[1];

      /*
       * Supports the inline form used by records such as:
       * related_tours: ["tour-a", "tour-b"]
       */
      const inline = fm.match(
        /^related_tours:\s*\[([^\]]*)\]\s*$/m
      );

      if (inline) {
        frontmatterRelatedTourSlugs = [
          ...inline[1].matchAll(/["']([^"']+)["']/g),
        ]
          .map((match) => match[1].trim())
          .filter(Boolean);
      } else {
        /*
         * Also support a simple YAML block list:
         *
         * related_tours:
         *   - tour-a
         *   - tour-b
         */
        const block = fm.match(
          /^related_tours:\s*\n((?:\s+-\s+[^\n]+\n?)*)/m
        );

        if (block) {
          frontmatterRelatedTourSlugs = block[1]
            .split('\n')
            .map((line) =>
              line
                .replace(/^\s*-\s*/, '')
                .trim()
                .replace(/^["']|["']$/g, '')
            )
            .filter(Boolean);
        }
      }
    }
  }
} catch (error) {
  console.warn(
    `Could not read explicit food tour relationships for ${foodPath}`,
    error
  );
}

const mergedExplicitTourSlugs = [
  ...new Set([
    ...explicitTourSlugs,
    ...frontmatterRelatedTourSlugs,
  ]),
];

const tourBySlug = new Map(allTours.map((tour: any) => [tour.slug, tour]));
const explicitTours = mergedExplicitTourSlugs
  .map((slug: string) => tourBySlug.get(slug))
  .filter(Boolean);

const aliasMap: Record<string, string[]> = {
  'kabuli-pulao': ['qabuli-palaw', 'kabuli-palaw'],
  'ghazni-qabili-pulao': ['qabuli-palaw'],
  'chicken-qabili': ['qabuli-palaw'],
  samosa: ['sambosa'],
  'sambosa-pastry': ['sambosa'],
  aushak: ['ashak'],
  'chapli-kabob': ['kabob'],
  'kabul-kabob': ['kabob'],
  'herat-kabob': ['kabob'],
};

const foodKeys = new Set<string>();

[
  baseSlug,
  data.dish_code,
  data.experience_code,
  data.card_title,
]
  .filter(Boolean)
  .forEach((value) => foodKeys.add(normalizeKey(value)));

(aliasMap[baseSlug] || []).forEach((alias) => foodKeys.add(normalizeKey(alias)));

const itineraryTours = allTours.filter((tour: any) => {
  if (!Array.isArray(tour.itinerary)) return false;

  return tour.itinerary.some((day: any) => {
    const value = normalizeKey(day.food_culture || day.food || '');
    return value && foodKeys.has(value);
  });
});

const relatedTours = [...explicitTours, ...itineraryTours]
  .filter(Boolean)
  .filter(
    (tour: any, index, array) =>
      array.findIndex((candidate: any) => candidate.slug === tour.slug) === index
  )
  .slice(0, 6);

const galleryCandidates: string[] = [];

const addGalleryImage = (value: any) => {
  if (!value) return;
  const src = String(value).trim();
  if (src && !galleryCandidates.includes(src)) galleryCandidates.push(src);
};

if (Array.isArray(data.gallery_images)) data.gallery_images.forEach(addGalleryImage);

addGalleryImage(heroImage);

if (data.image && data.image !== heroImage) addGalleryImage(data.image);

const scanFoodImageFolder = (publicFolder: string) => {
  if (!publicFolder || !publicFolder.startsWith('/')) return;

  const diskFolder = path.join(
    process.cwd(),
    'public',
    publicFolder.replace(/^\/+/, '')
  );

  try {
    if (!fs.existsSync(diskFolder)) return;

    let files = fs.readdirSync(diskFolder)
      .filter((file) =>
        /\.(webp|jpg|jpeg|png|avif)$/i.test(file)
      )
      .filter((file) =>
        !/^(thumb|thumbnail)\./i.test(file)
      );

    /*
     * If curated gallery-N files exist, prefer those over duplicate
     * numeric aliases such as 01.webp.
     */
    const hasNamedGallery = files.some((file) =>
      /^gallery-\d+/i.test(file)
    );

    if (hasNamedGallery) {
      files = files.filter(
        (file) =>
          /^hero\./i.test(file) ||
          /^gallery-\d+/i.test(file)
      );
    }

    files
      .sort((a, b) => {
        const rank = (file: string) => {
          if (/^hero\./i.test(file)) return 0;
          if (/^gallery-/i.test(file)) return 1;
          if (/^\d+/i.test(file)) return 2;
          return 3;
        };

        return rank(a) - rank(b) || a.localeCompare(b);
      })
      .forEach((file) =>
        addGalleryImage(`${publicFolder}${file}`)
      );
  } catch (error) {
    console.warn(
      `Could not inspect food image folder ${publicFolder}`,
      error
    );
  }
};

/*
 * First inspect the canonical route-specific food folder.
 */
if (resolvedFoodImageFolder) {
  scanFoodImageFolder(resolvedFoodImageFolder);
}

/*
 * Also inspect an explicitly configured hero's folder if it is
 * different from the canonical folder.
 */
if (heroImage.startsWith('/')) {
  const configuredHeroFolder =
    heroImage.substring(
      0,
      heroImage.lastIndexOf('/') + 1
    );

  if (
    configuredHeroFolder !==
    resolvedFoodImageFolder
  ) {
    scanFoodImageFolder(configuredHeroFolder);
  }
}

const galleryImages = galleryCandidates.slice(0, 9);

const currentProvinceSet = new Set(provinces.map(normalizeKey));
const pairedKeys = pairedFoods.map(normalizeKey);

const scoredFood = allFood
  .filter((candidate) => candidate.id !== entry.id)
  .map((candidate) => {
    const candidateData = candidate.data as any;
    const candidatePath =
      candidate.slug || candidate.id.replace(/\.md$/, '');
    const candidateParts = candidatePath.split('/');
    const candidateBase = candidateParts[candidateParts.length - 1];
    const candidateCategory =
      candidateParts.length > 1 ? candidateParts[0] : 'food';

    const candidateTitle = normalizeKey(candidateData.title);
    const candidateSlugKey = normalizeKey(candidateBase);

    let score = 0;

    for (const pairing of pairedKeys) {
      if (!pairing) continue;

      if (
        candidateTitle === pairing ||
        candidateSlugKey === pairing ||
        candidateTitle.includes(pairing) ||
        pairing.includes(candidateTitle) ||
        candidateSlugKey.includes(pairing) ||
        pairing.includes(candidateSlugKey)
      ) {
        score += 10;
      }
    }

    const candidateProvinces = Array.isArray(candidateData.provinces)
      ? candidateData.provinces
      : [];

    candidateProvinces.map(normalizeKey).forEach((province) => {
      if (currentProvinceSet.has(province)) score += 4;
    });

    if (candidateCategory === categorySlug) score += 2;

    return { candidate, score };
  })
  .filter((item) => item.score > 0)
  .sort(
    (a, b) =>
      b.score - a.score ||
      a.candidate.data.title.localeCompare(b.candidate.data.title)
  );

const relatedFood = scoredFood.slice(0, 6).map((result) => result.candidate);

const culinaryLinks = [
  ...culinaryLinksForFoodSlug(sourceBaseSlug),
  ...culinaryLinksForFoodSlug(baseSlug),
  ...culinaryLinksForFoodSlug(String(data.food_slug || data.slug || '')),
].filter((item, index, arr) => arr.findIndex((x) => x.slug === item.slug) === index);


const foodHref = (candidate: any) =>
  `/food-culture/${candidate.slug || candidate.id.replace(/\.md$/, '')}/`;

const foodImage = (candidate: any) => {
  const candidateData = candidate.data as any;

  return (
    candidateData.hero_image ||
    candidateData.image ||
    '/assets/images/heroes/food-and-culture/hero.webp'
  );
};

const contactHref = `/contact/?food=${encodeURIComponent(title)}`;
---

<BaseLayout
  title={`${title} | Food & Culture | AfghanTours`}
  description={description}
  image={heroImage}
>
  <section class="food-detail-hero">
    <img class="food-detail-hero-image" src={heroImage} alt={title} fetchpriority="high" />
    <div class="food-detail-hero-overlay" aria-hidden="true"></div>

    <div class="food-detail-hero-inner">
      <nav class="food-breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>›</span>
        <a href="/food-culture/">Food & Culture</a>
        <span>›</span>
        <a href={`/food-culture/#${categorySlug}`}>{categoryLabel}</a>
      </nav>

      <div class="food-detail-hero-copy">
        <p class="food-kicker">{categoryLabel}</p>
        <h1>{title}</h1>
        <p class="food-hero-subtitle">{subtitle}</p>

        <div class="food-hero-actions">
          <a class="food-hero-primary" href="#food-story">Discover the story</a>
          <a class="food-hero-secondary" href={contactHref}>Experience this on a trip</a>
        </div>
      </div>
    </div>
  </section>

  <section class="food-facts-shell">
    <div class="food-facts">
      <div class="food-fact"><span>Category</span><strong>{categoryLabel}</strong></div>
      <div class="food-fact"><span>Region</span><strong>{provinces.length ? provinces.join(', ') : 'Afghanistan'}</strong></div>
      <div class="food-fact"><span>Best season</span><strong>{bestSeason}</strong></div>
      <div class="food-fact"><span>Experience time</span><strong>{duration}</strong></div>
    </div>
  </section>

  <main id="food-story" class="food-story-section">
    <div class="food-story-layout">
      <article class="food-story">
        <p class="section-kicker">Taste & Place</p>
        <h2>The story</h2>
        <p class="food-story-lead">{description}</p>
        <div class="food-prose"><Content /></div>
      </article>

      <aside class="food-planning-column">
        <div class="food-planning-card">
          <p class="section-kicker">Plan Around It</p>
          <h2>Build it into the journey</h2>
          <p>
            Food and market experiences work best when they fit naturally into the route,
            season, meal schedule, market hours, and local availability.
          </p>

          <div class="food-planning-details">
            {provinces.length > 0 && (
              <div><span>Common location</span><strong>{provinces.join(', ')}</strong></div>
            )}

            <div><span>Best timing</span><strong>{bestSeason}</strong></div>

            {pairedFoods.length > 0 && (
              <div><span>Pair with</span><strong>{pairedFoods.join(', ')}</strong></div>
            )}

            {nearby.length > 0 && (
              <div><span>Nearby</span><strong>{nearby.join(', ')}</strong></div>
            )}

            {data.vegan && (
              <div><span>Dietary note</span><strong>Vegan</strong></div>
            )}

            {!data.vegan && data.vegetarian && (
              <div><span>Dietary note</span><strong>Vegetarian</strong></div>
            )}
          </div>

          <a class="food-planning-primary" href={contactHref}>Add this to my trip</a>
          <a class="food-planning-secondary" href="/food-culture/">Explore Food & Culture</a>
        </div>
      </aside>
    </div>
  </main>

  {galleryImages.length > 1 && (
    <section class="food-gallery-section">
      <div class="food-gallery-wrap">
        <div class="food-section-heading">
          <p class="section-kicker">Gallery</p>
          <h2>A closer look</h2>
          <p>These images belong directly to this food or cultural experience.</p>
        </div>

        <div class:list={['food-gallery-grid', galleryImages.length === 2 && 'food-gallery-two']}>
          {galleryImages.map((src, index) => (
            <button
              type="button"
              class:list={[
                'food-gallery-item',
                index === 0 && galleryImages.length >= 3 && 'food-gallery-featured',
              ]}
              data-food-image={src}
              data-food-alt={`${title} — image ${index + 1}`}
              aria-label={`Open image ${index + 1}`}
            >
              <img
                src={src}
                alt={`${title} — image ${index + 1}`}
                loading={index < 2 ? 'eager' : 'lazy'}
              />
            </button>
          ))}
        </div>
      </div>
    </section>
  )}


  {culinaryLinks.length > 0 && (
    <section class="related-food-section culinary-from-food">
      <div class="related-food-wrap">
        <div class="food-section-heading dark-copy">
          <p class="section-kicker">Culinary Experiences</p>
          <h2>Where travelers encounter this on the journey</h2>
          <p>
            Hub-based culinary experiences connected to this Food &amp; Culture page.
            Food pages stay separate; these links only add route context.
          </p>
        </div>
        <div class="related-food-grid">
          {culinaryLinks.map((item) => (
            <a class="related-food-card" href={item.href}>
              <div class="related-food-copy" style="padding:1.25rem">
                <p>Culinary Experience</p>
                <h3>{item.title}</h3>
                <strong>Explore culinary experience →</strong>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {relatedFood.length > 0 && (
    <section class="related-food-section">
      <div class="related-food-wrap">
        <div class="food-section-heading dark-copy">
          <p class="section-kicker">Continue Tasting</p>
          <h2>Related food & hospitality</h2>
          <p>
            Explore foods, produce, drinks, and market traditions that connect
            through region or cultural pairing.
          </p>
        </div>

        <div class="related-food-grid">
          {relatedFood.map((candidate) => {
            const candidateData = candidate.data as any;

            return (
              <a class="related-food-card" href={foodHref(candidate)}>
                <div class="related-food-image">
                  <img src={foodImage(candidate)} alt={candidateData.title} loading="lazy" />
                </div>

                <div class="related-food-copy">
                  <p>
                    {candidateData.category ||
                      categoryLabels[(candidate.slug || candidate.id).split('/')[0]] ||
                      'Food & Culture'}
                  </p>

                  <h3>{candidateData.title}</h3>
                  {candidateData.card_description && <span>{candidateData.card_description}</span>}
                  <strong>Explore →</strong>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {relatedTours.length > 0 ? (
    <TourCardGrid
      tours={relatedTours}
      title={`Journeys connected to ${title}`}
      intro={`These published AfghanTours journeys either reference this food or cultural experience directly or include it through their itinerary planning.`}
    />
  ) : (
    <section class="food-custom-tour-section">
      <div class="food-custom-tour-card">
        <div>
          <p class="section-kicker">Custom Planning</p>
          <h2>Want to experience {title}?</h2>
          <p>
            We can build food, markets, tea stops, orchards, restaurants, and regional
            specialties into a private itinerary when they fit naturally into your route.
          </p>
        </div>

        <a href={contactHref}>Request a custom journey</a>
      </div>
    </section>
  )}

  <section class="food-final-cta">
    <div class="food-final-inner">
      <div>
        <p class="section-kicker">Food Is Part of the Route</p>
        <h2>Travel through Afghanistan's hospitality.</h2>
        <p>
          Tell us what you want to taste, understand, photograph, or experience.
          We can connect food culture with the places and people already on your journey.
        </p>
      </div>

      <a href={contactHref}>Start planning</a>
    </div>
  </section>

  <dialog id="food-gallery-dialog" class="food-dialog">
    <button type="button" class="food-dialog-close" aria-label="Close image">×</button>
    <img id="food-gallery-dialog-image" src={heroImage} alt="" />
  </dialog>
</BaseLayout>

<script is:inline>
  (() => {
    const dialog = document.getElementById('food-gallery-dialog');
    const image = document.getElementById('food-gallery-dialog-image');

    if (!dialog || !image) return;

    document.querySelectorAll('[data-food-image]').forEach((button) => {
      button.addEventListener('click', () => {
        image.src = button.dataset.foodImage;
        image.alt = button.dataset.foodAlt || '';
        dialog.showModal();
      });
    });

    dialog.querySelector('.food-dialog-close')?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  })();
</script>

<style>
  .food-detail-hero {
    position: relative;
    min-height: clamp(540px, 68vh, 760px);
    overflow: hidden;
    background: #101820;
    color: #fff;
  }

  .food-detail-hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .food-detail-hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(7,11,14,.92) 0%, rgba(7,11,14,.70) 43%, rgba(7,11,14,.18) 77%),
      linear-gradient(0deg, rgba(7,11,14,.82) 0%, transparent 62%);
  }

  .food-detail-hero-inner {
    position: relative;
    z-index: 2;
    width: min(1280px, calc(100% - 2rem));
    min-height: clamp(540px, 68vh, 760px);
    margin: auto;
    padding: clamp(2rem, 5vw, 4rem) 0 clamp(4rem, 8vw, 6rem);
    display: flex;
    flex-direction: column;
  }

  .food-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .55rem;
    font-size: .77rem;
    font-weight: 800;
  }

  .food-breadcrumbs a {
    color: rgba(255,255,255,.82);
    text-decoration: none;
  }

