---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const foodEntries = await getCollection('food');
  return foodEntries.map(entry => {
    return {
      params: { slug: entry.slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BaseLayout title={entry.data.title}>
  <main class="max-w-4xl mx-auto px-4 py-12">
    <nav class="text-xs font-semibold tracking-wider text-slate-400 uppercase mb-4">
      <a href="/food-culture" class="hover:text-blue-600">Culinary Heritage</a> 
      <span class="mx-2">/</span> 
      <span class="text-slate-600">{entry.slug.split('/')[0]}</span>
    </nav>

    <article class="bg-white border border-slate-200 rounded-2xl p-6 md:p-10 shadow-sm">
      <header class="border-b border-slate-100 pb-6 mb-8">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-3">
          <h1 class="text-3xl md:text-4xl font-bold text-slate-900 leading-tight">
            {entry.data.title}
          </h1>
          
          <div class="flex gap-2">
            {entry.data.vegan && (
              <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs px-3 py-1 rounded-full font-medium">
                Vegan
              </span>
            )}
            {entry.data.vegetarian && !entry.data.vegan && (
              <span class="bg-green-50 text-green-700 border border-green-200 text-xs px-3 py-1 rounded-full font-medium">
                Vegetarian
              </span>
            )}
          </div>
        </div>

        {/* Regional & Meta Indicators */}
        <div class="flex flex-wrap items-center gap-y-2 gap-x-4 text-sm text-slate-500">
          {entry.data.dish_code && (
            <div>
              <span class="font-medium text-slate-400">Code:</span> 
              <code class="bg-slate-100 px-1.5 py-0.5 rounded text-xs text-slate-700 font-mono ml-1">{entry.data.dish_code}</code>
            </div>
          )}
          
          {entry.data.provinces && entry.data.provinces.length > 0 && (
            <div class="flex items-center gap-1">
              <span class="font-medium text-slate-400">Provinces:</span>
              <div class="flex flex-wrap gap-1 ml-1">
                {entry.data.provinces.map(prov => (
                  <span class="bg-slate-100 text-slate-700 text-xs px-2 py-0.5 rounded font-medium">
                    {prov}
                  </span>
                ))}
              </div>
            </div>
          )}
        </div>
      </header>

      {/* Rendered Markdown Body */}
      <div class="prose prose-slate max-w-none prose-headings:font-bold prose-h2:text-xl prose-h2:mt-6 prose-h2:mb-3 prose-p:leading-relaxed text-slate-700">
        <Content />
      </div>
    </article>
  </main>
</BaseLayout>
