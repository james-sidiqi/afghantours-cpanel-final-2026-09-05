import { normalizeImagePath, hasRealImage } from '../../lib/images';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

const allFoodItems = await getCollection('food');

const normalizeFoodKey = (value = '') =>
  String(value)
    .replace(/^\/+/, '')
    .replace(/\.md$/i, '')
    .replace(/^food\//i, '');

const itemMap = new Map();

for (const item of allFoodItems) {
  itemMap.set(normalizeFoodKey(item.id), item);

  if (item.slug) {
    itemMap.set(normalizeFoodKey(item.slug), item);
  }
}

// Cards whose stored image does not show the item itself (Shor Chai pointed at a
// Faizabad landscape) render as intentional image-free cards.
const NO_CARD_IMAGE = new Set(['drinks/shor-chai-of-badakhshan', 'produce/farah-watermelon', 'dishes/kabul-kabob']);
// Per-card focal point so the subject stays in frame in the fixed card crop.
const CARD_FOCUS = { 'drinks/sheer-chai': '50% 50%', 'desserts/sheer-khorma': '55% 68%', 'dried-fruits/paktia-pine-nuts': '50% 12%' };
// Rosh now has an owner-provided matching photo. Other intentional image-free cards stay blocked.
const APPROVED_CARD_IMAGES = {
  "produce/farah-watermelon": "/assets/images/food/produce/watermelons/hero.webp",
  "drinks/shor-chai-of-badakhshan": "/assets/images/food/drinks/shor-chai-of-badakhshan/hero.webp",
  'dishes/kabul-kabob': "/assets/images/food/dishes/afghan-kabob/roadside-kabob.webp",
};
const isPhotoPending = (id) => itemMap.get(normalizeFoodKey(id))?.data?.image_status === 'pending';
const imageForId = (id) => {
  if (isPhotoPending(id)) return null;
  const approved = APPROVED_CARD_IMAGES[id];
  if (approved && hasRealImage(approved)) return normalizeImagePath(approved, '');
  if (NO_CARD_IMAGE.has(id)) return null;
  const item = itemMap.get(normalizeFoodKey(id));
  return [
    item?.data?.hero_image,
    item?.data?.image,
    `/assets/images/food/${id}/hero.webp`,
    item?.data?.card_image,
  ].filter(Boolean).map((src) => normalizeImagePath(src, '')).find(hasRealImage) || null;
};

