// Owner 2026-11-20 structure: food-related stops are Culinary Experiences; crafts,
// kites and other non-food traditions are Other Cultural Experiences.
const isCulturalHref = (href) => href.startsWith('/cultural-experiences/') && !href.startsWith('/cultural-experiences/culinary/')
  && href !== '/cultural-experiences/chashma-e-dogh/';
const NON_FOOD_DESTINATION_ITEMS = new Set(['Nuristan Wood Carpentry & Carving']);
const isCultural = (item) => isCulturalHref(item.href) || NON_FOOD_DESTINATION_ITEMS.has(item.title);
const culinaryGroups = experienceGroups
  .map((group) => ({ ...group, items: group.items.filter((item) => !isCultural(item)) }))
  .filter((group) => group.items.length);
const culturalGroups = experienceGroups
  .map((group) => ({ ...group, items: group.items.filter(isCultural) }))
  .filter((group) => group.items.length);
const countItems = (groups) => groups.reduce((total, group) => total + group.items.length, 0);
const culinaryCount = countItems(culinaryGroups);
const culturalCount = countItems(culturalGroups);

