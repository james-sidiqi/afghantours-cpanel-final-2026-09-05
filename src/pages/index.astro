---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedTours from '../components/FeaturedTours.astro';
import CustomTours from '../components/CustomTours.astro';
import WhySection from '../components/WhySection.astro';
import { getItineraryTours, getHubs, getAttractions, getHotels, getFoodItems } from '../lib/buildRelations';

const tours = getItineraryTours().filter((tour) => tour.is_active !== false && tour.slug);
const hubs = getHubs();
const attractions = getAttractions();
const hotels = getHotels();
const food = getFoodItems();
import AboutTravelerGallery from '../components/AboutTravelerGallery.astro';
---

<BaseLayout
  title="AfghanTours | Private Afghanistan Tours & Expeditions"
  description="Licensed, American-led Afghanistan tour operator based in Kabul, planning private journeys with local guides, Letter of Invitation support for booked tours, and flexible route planning."
  image="/assets/images/heroes/home/hero.webp"
>
  <section class="home-hero">
    <video
      class="hero-media"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster="/assets/images/heroes/home/hero.webp"
    >
      <source src="/assets/images/heroes/home/hero.mp4" type="video/mp4" />
    </video>

    <img
      class="hero-fallback"
      src="/assets/images/heroes/home/hero.webp"
      alt="Afghanistan mountains and traveler"
    />

    <div class="hero-shade"></div>

    <div class="hero-content">
      <h1>Afghanistan, Reimagined</h1>

      <p class="hero-subhead">
        Not the headlines. The hospitality. The history. The highlands.
      </p>

      <p class="lead">
        AfghanTours is a licensed, American-led tour operator based in Kabul. We plan private
        journeys with local guides, Letter of Invitation support for every booked tour, and routes
        that can change when the road, the weather, or access changes.
      </p>

      <p class="hero-reality">Our itineraries are built around journeys we can realistically plan and support.</p>

      <div class="hero-actions">
        <a href="/tours/">Explore Expeditions</a>
        <a href="/custom-requests/">Plan a Custom Trip</a>
      </div>
    </div>
  </section>

  <section class="trust-line" aria-label="AfghanTours credentials">
    <p>
      <button type="button" class="license-link" data-license-open>
        Licensed Afghan Tour Operator
      </button>
      <span aria-hidden="true">·</span>
      <span>American-led, Kabul-based</span>
      <span aria-hidden="true">·</span>
      <span>15+ years on the ground</span>
      <span aria-hidden="true">·</span>
      <span>Private local guides</span>
      <span aria-hidden="true">·</span>
      <span>Letter of Invitation support on every booked tour</span>
    </p>
  </section>

  <dialog id="license-dialog" class="license-dialog" aria-labelledby="license-dialog-title">
  </dialog>

  <div class="home-section-band home-section-band--featured">
    <FeaturedTours tours={tours} />
  </div>
  <div class="home-section-band home-section-band--custom">
    <CustomTours />
  </div>
  <div class="home-section-band home-section-band--why">
    <WhySection />
  </div>

  <AboutTravelerGallery />
</BaseLayout>


<style>
  .hero-subhead {
    max-width: 760px;
    margin: .5rem 0 1rem;
    color: #f2c768;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    line-height: 1.25;
    font-weight: 700;
  }

  .hero-reality {
    margin: 1rem 0 0;
    color: rgba(255,255,255,.9);
    font-weight: 800;
    letter-spacing: .01em;
  }

  .trust-line {
    border-top: 1px solid rgba(185,130,55,.22);
    border-bottom: 1px solid rgba(185,130,55,.22);
    background: #f7f1e7;
    color: #172127;
  }

  .trust-line p {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 1.05rem 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: .42rem .7rem;
    text-align: center;
    font-size: .82rem;
    line-height: 1.5;
    font-weight: 800;
  }

  .license-link {
    appearance: none;
    border: 0;
    border-bottom: 1px solid currentColor;
    padding: 0;
    background: transparent;
    color: #8b5c16;
    font: inherit;
    font-weight: 900;
    cursor: pointer;
  }

  .license-link:hover,
  .license-link:focus-visible {
    color: #5f3b09;
  }

  .license-dialog {
    width: min(760px, calc(100% - 2rem));
    max-height: 90vh;
    border: 0;
    border-radius: 1.25rem;
    padding: 0;
    background: #fbf7ef;
    color: #101820;
    box-shadow: 0 30px 100px rgba(0,0,0,.45);
  }

  .license-dialog::backdrop {
    background: rgba(4,10,12,.78);
    backdrop-filter: blur(5px);
  }

  .license-dialog__inner {
    position: relative;
    padding: clamp(1.25rem, 3vw, 2rem);
    text-align: center;
  }

  .license-dialog__close {
    position: absolute;
    top: .75rem;
    right: .85rem;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgba(16,24,32,.15);
    border-radius: 999px;
    background: #fff;
    color: #101820;
    cursor: pointer;
    font-size: 1.5rem;
    line-height: 1;
  }

  .license-dialog__eyebrow {
    margin: 0 0 .4rem;
    color: #9a681b;
    text-transform: uppercase;
    letter-spacing: .18em;
    font-size: .7rem;
    font-weight: 900;
  }

  .license-dialog h2 {
    margin: 0 2rem 1.25rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
  }

  .license-dialog img {
    display: block;
    width: 100%;
    max-height: 62vh;
    object-fit: contain;
    margin: 0 auto;
    border-radius: .75rem;
    background: #fff;
  }

  .license-dialog__note {
    margin: 1rem auto .75rem;
    max-width: 600px;
    line-height: 1.6;
    color: #4c4841;
  }

  .license-dialog a {
    color: #805410;
    font-weight: 900;
  }


  .home-hero {
    position: relative;
    min-height: calc(100vh - 76px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: #050505;
    color: #fff;
  }

  .home-hero img,
  .home-hero video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-media {
    z-index: 1;
  }

  .hero-fallback {
    z-index: 0;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(90deg, rgba(0,0,0,.78), rgba(0,0,0,.48), rgba(0,0,0,.25)),
      linear-gradient(0deg, rgba(0,0,0,.38), transparent 42%);
  }

  .hero-content {
    position: relative;
    z-index: 3;
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
    padding-top: 4rem;
  }

  .hero-content > p:first-child,
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: .28em;
    color: #d6a548;
    font-size: .78rem;
    font-weight: 900;
  }

  .home-hero h1 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.2rem, 7vw, 7.2rem);
    line-height: .92;
    letter-spacing: -.07em;
    max-width: 860px;
    margin: 1rem 0;
  }

  .lead {
    font-size: 1.15rem;
    line-height: 1.7;
    max-width: 650px;
    color: #eee;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .hero-actions a {
    padding: 1rem 1.4rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 900;
    color: #111;
    background: #f3b72d;
  }

  .hero-actions a + a {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255,255,255,.4);
  }

  .trust-section {
    position: relative;
    background:
      linear-gradient(90deg, rgba(251,246,237,.96), rgba(251,246,237,.9) 50%, rgba(251,246,237,.78)),
      url('/assets/images/hubs/kabul-city/hero.webp') center/cover no-repeat;
    color: #101820;
    padding: clamp(3.4rem, 5vw, 4.8rem) 0;
    overflow: hidden;
    border-top: 1px solid rgba(185,130,55,.16);
    border-bottom: 1px solid rgba(185,130,55,.18);
  }

  .trust-wrap {
    position: relative;
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .trust-wrap h2 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.7rem, 4.5vw, 4.8rem);
    line-height: .94;
    letter-spacing: -.065em;
    max-width: 980px;
    margin: .65rem 0 1rem;
  }

  .trust-lead {
    max-width: 670px;
    line-height: 1.8;
    color: #34312b;
    font-size: 1.05rem;
  }

  .trust-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.35rem;
    margin-top: 1.55rem;
  }

  .trust-card {
    overflow: hidden;
    background: rgba(255,255,255,.84);
    border: 1px solid rgba(185,130,55,.22);
    border-radius: 1.35rem;
    box-shadow: 0 18px 42px rgba(35,25,14,.12);
    backdrop-filter: blur(8px);
  }

  .trust-card__media {
    height: 190px;
    background: #eee5d7;
    border-bottom: 1px solid rgba(185,130,55,.16);
  }

  .trust-card__media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .trust-card__media--license {
    height: 205px;
    background: #f6efe2;
    padding: 1rem;
  }

  .trust-card__media--license img {
    object-fit: contain;
    background: #fff;
    border-radius: .9rem;
  }

  .trust-card__body { padding: 1.35rem; }
  .trust-card__eyebrow { margin: 0 0 .7rem; color: #b98237; text-transform: uppercase; letter-spacing: .18em; font-size: .72rem; font-weight: 900; }

  .trust-card h3 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.65rem, 2.35vw, 2.15rem);
    line-height: .96;
    margin: 0 0 1rem;
    letter-spacing: -.04em;
  }

  .trust-card p { line-height: 1.72; color: #2f2f2f; margin: 0; }

  .trust-badges {
    border-top: 1px solid #dfd2bf;
    margin-top: 1.3rem;
    padding-top: 1rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: .65rem;
    text-align: center;
  }

  .trust-badges b {
    border-radius: 999px;
    background: rgba(185,130,55,.1);
    padding: .65rem .55rem;
    font-size: .78rem;
    color: #211a12;
  }

  .trust-card ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .75rem 1.1rem;
    padding: 0;
    margin: 1.2rem 0 0;
    list-style: none;
  }

  .trust-card li { color: #262626; line-height: 1.35; }
  .trust-card li:before { content: '✓'; color: #b98237; margin-right: .45rem; font-weight: 900; }

  .trust-proof-strip {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: .85rem;
  }

  .trust-proof-strip div {
    border: 1px solid rgba(185,130,55,.22);
    border-radius: 1rem;
    background: rgba(16,24,32,.9);
    color: #fffaf0;
    padding: .85rem 1rem;
    box-shadow: 0 12px 28px rgba(0,0,0,.12);
  }

  .trust-proof-strip strong { display: block; font-family: Georgia, "Times New Roman", serif; font-size: 1.35rem; line-height: 1; color: #f3b72d; }
  .trust-proof-strip span { display: block; margin-top: .35rem; font-size: .82rem; color: rgba(255,250,240,.8); }

  .home-section-band { border-top: 1px solid rgba(185,130,55,.14); }
  .home-section-band--featured { background: #fffaf0; }
  .home-section-band--custom { background: #f1eadc; }
  .home-section-band--why { background: #fbf6ed; }

  @media(max-width:900px) {
    .trust-cards { grid-template-columns: 1fr; }
    .trust-card ul,
    .trust-badges,
    .trust-proof-strip { grid-template-columns: 1fr; }
  }

  @media(max-width:600px) {
    .home-hero { min-height: 78vh; }
    .trust-section { padding: 4rem 0; }
    .trust-card__media { height: 210px; }
    .trust-card__body { padding: 1.25rem; }
  }
</style>


<script>
  const licenseDialog = document.getElementById('license-dialog');
  const licenseOpen = document.querySelector('[data-license-open]');
  const licenseClose = document.querySelector('[data-license-close]');

  licenseOpen?.addEventListener('click', () => {
    if (licenseDialog instanceof HTMLDialogElement) {
      licenseDialog.showModal();
    }
  });

  licenseClose?.addEventListener('click', () => {
    if (licenseDialog instanceof HTMLDialogElement) {
      licenseDialog.close();
    }
  });

  licenseDialog?.addEventListener('click', (event) => {
    if (
      event.target === licenseDialog &&
      licenseDialog instanceof HTMLDialogElement
    ) {
      licenseDialog.close();
    }
  });
</script>

