---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedTours from '../components/FeaturedTours.astro';
import TourDirectory from '../components/TourDirectory.astro';
import { getItineraryTours, getScheduledTours, getPrivateFixedTours } from '../lib/buildRelations';

const itineraryTours = getItineraryTours().filter((tour) => tour.is_active !== false && tour.slug);
const scheduled = getScheduledTours().filter((tour) => tour.is_active !== false && tour.slug);
const privateFixed = getPrivateFixedTours().filter((tour) => tour.is_active !== false && tour.slug);

const featuredTours = itineraryTours
  .filter((tour) => String(tour.is_featured ?? '').trim() === '1')
  .slice(0, 8);
---

<BaseLayout
  title="Tours | AfghanTours"
  description="Browse Afghanistan scheduled tours and private fixed-itinerary journeys with defined routes, durations, and planned itineraries."
  image="/assets/images/heroes/tours/hero.webp"
>
  <FeaturedTours tours={featuredTours} />

  <section class="tour-list-intro">
    <div>
      <p>Tour Packages</p>
      <h1>Scheduled Tours &amp; Private Fixed Itineraries</h1>
      <span>
        This catalog lists genuine itinerary-based tours only. Specialist logistics, return journeys,
        and Build My Journey planning live on their own pages — they are not mixed into this tour grid.
      </span>
    </div>
  </section>

  <section class="class-band" id="scheduled-tours">
    <div class="class-wrap">
      <p class="class-kicker">A · Scheduled Tours</p>
      <h2>Proposed seasonal departures</h2>
      <p class="class-copy">Itinerary + duration + scheduled or proposed dates. Prices shown as Price on request unless an operator-verified figure is published.</p>
    </div>
    <TourDirectory tours={scheduled} />
  </section>

  <section class="class-band class-band--alt" id="private-tours">
    <div class="class-wrap">
      <p class="class-kicker">B · Private Fixed-Itinerary Tours</p>
      <h2>Private dates on published routes</h2>
      <p class="class-copy">Full itineraries with duration — run on private dates rather than a public group departure calendar.</p>
    </div>
    <TourDirectory tours={privateFixed} />
  </section>

  <section class="outbound">
    <div class="outbound-grid">
      <a href="/custom-requests/" class="outbound-card">
        <p>C · Custom Journey</p>
        <h3>Build My Journey</h3>
        <span>No predetermined duration, itinerary, route, or package price — we scope a quotation with you.</span>
      </a>
      <a href="/specialist-services/" class="outbound-card">
        <p>D · Specialist Services</p>
        <h3>Proposal-led logistics</h3>
        <span>Photography, research, media, business, mountaineering support — not tour packages.</span>
      </a>
      <a href="/return-journeys/" class="outbound-card">
        <p>E · Return Journeys</p>
        <h3>Diaspora &amp; veterans</h3>
        <span>Heritage and return visits planned around personal history — distinct from leisure tours.</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .tour-list-intro {
    background: #ffffff;
    color: #101820;
    padding: clamp(3.5rem, 5vw, 5rem) 0 1rem;
    border-top: 1px solid rgba(16,24,32,.08);
  }
  .tour-list-intro > div {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
    max-width: 900px;
  }
  .tour-list-intro p {
    margin: 0;
    color: #b46b00;
    font-size: .72rem;
    letter-spacing: .22em;
    text-transform: uppercase;
    font-weight: 900;
  }
  .tour-list-intro h1 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.6rem, 4.5vw, 4.2rem);
    line-height: .98;
    letter-spacing: -.05em;
    margin: .5rem 0 1rem;
  }
  .tour-list-intro span {
    color: #4b5563;
    line-height: 1.75;
    font-size: 1.05rem;
  }
  .class-band { padding-top: 1.5rem; }
  .class-band--alt { background: #f7f4ee; padding-bottom: 1rem; }
  .class-wrap {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
    max-width: 900px;
    padding-top: 1.5rem;
  }
  .class-kicker {
    margin: 0;
    color: #b46b00;
    font-size: .72rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    font-weight: 900;
  }
  .class-wrap h2 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    margin: .4rem 0 .6rem;
  }
  .class-copy { color: #4b5563; line-height: 1.65; margin: 0 0 .5rem; }
  .outbound {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto 4.5rem;
  }
  .outbound-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .outbound-card {
    background: #f7f0e6;
    border: 1px solid #dfd0bc;
    border-radius: .75rem;
    padding: 1.35rem 1.25rem;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 10px 28px rgba(50,36,18,.06);
  }
  .outbound-card p {
    margin: 0;
    color: #b46b00;
    font-size: .68rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    font-weight: 900;
  }
  .outbound-card h3 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.45rem;
    margin: .45rem 0 .55rem;
  }
  .outbound-card span { color: #4b5563; line-height: 1.55; display: block; font-size: .95rem; }
  @media (max-width: 900px) {
    .outbound-grid { grid-template-columns: 1fr; }
  }
</style>
