---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedTours from '../components/FeaturedTours.astro';
import TourDirectory from '../components/TourDirectory.astro';
import { getItineraryTours, getScheduledTours, getPrivateFixedTours } from '../lib/buildRelations';

const itineraryTours = getItineraryTours().filter((tour) => tour.is_active !== false && tour.slug);
const scheduled = getScheduledTours().filter((tour) => tour.is_active !== false && tour.slug);
const privateFixed = getPrivateFixedTours().filter((tour) => tour.is_active !== false && tour.slug);

const featuredTours = itineraryTours
  .filter((tour) => String(tour.is_featured ?? '').trim() === '1')
  .slice(0, 8);
---

<BaseLayout
  title="Tours | AfghanTours"
  description="Explore scheduled and private Afghanistan tours, with routes and itineraries planned from Kabul."
  image="/assets/images/heroes/tours/hero.webp"
>
  <FeaturedTours tours={featuredTours} />

  <section class="tour-list-intro">
    <div>
      <p>Tour Packages</p>
      <h1>Scheduled Tours &amp; Private Fixed Itineraries</h1>
      <span>
        Choose a scheduled departure or a private journey on one of our established routes. For something different, build a custom journey around your own dates and interests.
      </span>
    </div>
  </section>

  <section class="class-band" id="scheduled-tours">
    <div class="class-wrap">
      <p class="class-kicker">Scheduled Tours</p>
      <h2>Seasonal departures</h2>
      <p class="class-copy">Travel on a planned route with a published duration and departure window. Where a verified starting price is available, we show it.</p>
    </div>
    <TourDirectory tours={scheduled} />
  </section>

  <section class="class-band class-band--alt" id="private-tours">
    <div class="class-wrap">
      <p class="class-kicker">Private Tours</p>
      <h2>Choose your dates on an established route</h2>
      <p class="class-copy">Travel privately on a defined itinerary, with dates arranged around your schedule.</p>
    </div>
    <TourDirectory tours={privateFixed} />
  </section>

  <section class="outbound">
    <div class="outbound-grid">
      <a href="/custom-requests/" class="outbound-card">
        <p>Custom Journey</p>
        <h3>Build My Journey</h3>
        <span>Start with your dates and interests. We will shape the route, pace, accommodation, and quotation with you.</span>
      </a>
      <a href="/specialist-services/" class="outbound-card">
        <p>Specialist Services</p>
        <h3>Travel support for specialist work</h3>
        <span>Photography, research, media, business, mountaineering, and other purpose-built travel.</span>
      </a>
      <a href="/return-journeys/" class="outbound-card">
        <p>Return Journeys</p>
        <h3>Return with purpose</h3>
        <span>Heritage, diaspora, veteran, and personal return visits planned around the places that matter to you.</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .tour-list-intro {
    background: var(--at-white);
    color: var(--at-ink);
    padding: clamp(3.5rem, 5vw, 5rem) 0 1rem;
    border-top: 1px solid rgba(16,24,32,.08);
  }
  .tour-list-intro > div {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
    max-width: 900px;
  }
  .tour-list-intro p {
    margin: 0;
    color: var(--at-gold-text);
    font-size: .72rem;
    letter-spacing: .22em;
    text-transform: uppercase;
    font-weight: 900;
  }
  .tour-list-intro h1 {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 4.5vw, 4.2rem);
    line-height: .98;
    letter-spacing: -.05em;
    margin: .5rem 0 1rem;
  }
  .tour-list-intro span {
    color: var(--at-text);
    line-height: 1.75;
    font-size: 1.05rem;
  }
  .class-band { padding-top: 1.5rem; }
  .class-band--alt { background: var(--at-paper); padding-bottom: 1rem; }
  .class-wrap {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
    max-width: 900px;
    padding-top: 1.5rem;
  }
  .class-kicker {
    margin: 0;
    color: var(--at-gold-text);
    font-size: .72rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    font-weight: 900;
  }
  .class-wrap h2 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    margin: .4rem 0 .6rem;
  }
  .class-copy { color: var(--at-text); line-height: 1.65; margin: 0 0 .5rem; }
  .outbound {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto 4.5rem;
  }
  .outbound-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .outbound-card {
    background: var(--at-paper);
    border: 1px solid var(--border-soft);
    border-radius: .75rem;
    padding: 1.35rem 1.25rem;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 10px 28px rgba(50,36,18,.06);
  }
  .outbound-card p {
    margin: 0;
    color: var(--at-gold-text);
    font-size: .68rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    font-weight: 900;
  }
  .outbound-card h3 {
    font-family: var(--font-display);
    font-size: 1.45rem;
    margin: .45rem 0 .55rem;
  }
  .outbound-card span { color: var(--at-text); line-height: 1.55; display: block; font-size: .95rem; }
  @media (max-width: 900px) {
    .outbound-grid { grid-template-columns: 1fr; }
  }
</style>
