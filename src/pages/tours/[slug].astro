    .tour-facts strong { display: block; margin-top: .25rem; font-size: .9rem; }
    .tour-hero__actions { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.55rem; }
    .tour-button { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; border-radius: 999px; padding: .75rem 1.15rem; font-size: .82rem; font-weight: 900; text-decoration: none; transition: transform .15s ease, background .15s ease; }
    .tour-button:hover { transform: translateY(-1px); }
