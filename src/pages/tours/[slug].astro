---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getTours, getTourBySlug, getAttractions } from "../../lib/buildRelations";
import { getCollection } from "astro:content";
import { hotels, dishes, locations } from "../../lib/data";
import { parseCSV } from "../../lib/csv";
import transportRaw from "../../../data/ground_transport.csv?raw";
import inclusionsRaw from "../../../data/tour_inclusions.csv?raw";

export function getStaticPaths() {
  return getTours()
    .filter((tour) => tour?.slug)
    .map((tour) => ({ params: { slug: tour.slug } }));
}

const tour = Astro.params.slug ? getTourBySlug(Astro.params.slug) : undefined;
if (!tour) return Astro.redirect("/tours/");

const allTours = getTours();
const transport = parseCSV(transportRaw);
const allInclusions = parseCSV(inclusionsRaw);
const allAttractions = getAttractions();
const foodEntries = await getCollection("food");

const foodPathBySlug = new Map();
for (const entry of foodEntries) {
  const leaf = entry.slug.split("/").pop();
  for (const key of [entry.data.food_slug, entry.data.slug, leaf]) {
    if (key) foodPathBySlug.set(String(key).trim().toLowerCase(), entry.slug);
  }
}

function foodHref(item) {
  const key = String(item?.food_slug || item?.slug || "").trim().toLowerCase();
  const contentSlug = foodPathBySlug.get(key);
  return contentSlug ? `/food-culture/${contentSlug}/` : "/food-culture/";
}

function humanize(value) {
  return String(value || "")
    .replace(/[-_]+/g, " ")
    .replace(/\b\w/g, (letter) => letter.toUpperCase())
    .trim();
}


const tourName = tour.title || tour.name || "Afghanistan Tour";
const isCustomJourney = false;
const heroImage =
  tour.hero_image ||
  tour.hero_image_path ||
  tour.thumbnail_image_path ||
  "/assets/images/placeholders/default-hero.webp";
const overviewImage =
  tour.overview_image ||
  tour.overview_image_path ||
  tour.image_path_overview ||
  heroImage;

function list(value) {
  if (Array.isArray(value)) return value.filter(Boolean);
  return String(value || "")
    .split(/[|;,]/)
    .map((item) => item.trim())
    .filter(Boolean);
}

function unique(items) {
  const seen = new Set();
  return items.filter((item) => {
    const key = String(item || "").trim().toLowerCase();
    if (!key || seen.has(key)) return false;
    seen.add(key);
    return true;
  });
}

function cleanText(value) {
  if (!value) return "";
  if (typeof value === "string") return value.trim();
  if (Array.isArray(value)) return value.map(cleanText).filter(Boolean).join(" → ");
  if (typeof value === "object") {
    return cleanText(value.name || value.title || value.label || value.summary || value.route || value.slug);
  }
  return String(value).trim();
}

function includesAny(value, tokens) {
  const text = String(value || "").toLowerCase();
  return tokens.some((token) => token && text.includes(String(token).toLowerCase()));
}

function isActiveRow(item) {
  const active = String(item.is_active ?? "1").toLowerCase();
  return active === "1" || active === "true" || active === "yes";
}

function formatPrice(value) {
  const raw = String(value ?? "").trim();
  if (!raw || raw.toLowerCase() === "inquire") return "Price on request";
  const number = Number(raw.replace(/[^0-9.]/g, ""));
  if (!Number.isFinite(number) || number <= 0) return raw;
  return `From $${number.toLocaleString("en-US")}`;
}

function statusLabel(status) {
  const value = String(status || "").toLowerCase();
  if (value.includes("request") || value.includes("inquire")) return "On request";
  if (value.includes("available") || value.includes("open")) return "Available";
  if (value.includes("sold") || value.includes("full")) return "Full";
  return status || "Ask us";
}

function dateLabel(row) {
  const start = String(row?.date_start || "").trim();
  const end = String(row?.date_end || "").trim();
  if (!start || start.toLowerCase() === "inquire") return "Dates arranged around you";
  if (!end || end === start || end.toLowerCase() === "inquire") return start;
  return `${start} – ${end}`;
}

function imageFor(item) {
  return (
    item?.hero_image ||
    item?.hero_image_path ||
    item?.card_image ||
    item?.card_image_path ||
    item?.image ||
    item?.image_path ||
    item?.image_path_property_1 ||
    item?.overview_image ||
    "/assets/images/placeholders/default-card.webp"
  );
}

const itinerary = Array.isArray(tour.itinerary) ? tour.itinerary.filter(isActiveRow) : [];
const linkedAttractions = Array.isArray(tour.attractions) ? tour.attractions : [];
const provinceObjects = Array.isArray(tour.provinces) ? tour.provinces : [];
const provinceTokens = unique([
  ...provinceObjects.map((item) => cleanText(item)),
  ...itinerary.flatMap((day) => list(day.provinces_traversed || day.province || day.location)),
].filter(Boolean));

const routeText =
  cleanText(tour.route) ||
  cleanText(tour.route_summary) ||
  cleanText(tour.route_text) ||
  unique(itinerary.map((day) => cleanText(day.location)).filter(Boolean)).join(" → ") ||
  provinceTokens.join(" → ");

const locationTokens = unique([
  tour.primary_location_slug,
  tour.primary_location,
  tour.hub,
  tour.hubs,
  ...itinerary.map((day) => day.overnight_hub || day.hub || day.location),
  ...provinceTokens,
].flatMap(list).filter(Boolean));

function normalizeHotelHub(value) {
  return String(value || "")
    .trim()
    .toLowerCase()
    .replace(/[_-]+/g, " ")
    .replace(/\bcity\b/g, "")
    .replace(/\s+/g, " ")
    .trim();
}

function displayHotelHub(value) {
  const key = normalizeHotelHub(value);

  const labels = {
    "kabul": "Kabul",
    "bamyan": "Bamyan",
    "herat": "Herat",
    "mazar e sharif": "Mazar-e-Sharif",
    "faizabad": "Faizabad",
    "kandahar": "Kandahar",
    "jalalabad": "Jalalabad",
    "ghazni": "Ghazni",
  };

  return labels[key] || humanize(value);
}

/*
 * Accommodation rule:
 * one ACTIVE STANDARD hotel for every unique hub
 * in which this itinerary overnights.
 *
 * We deliberately do not use premium/luxury hotels here.
 */
const overnightHubs = [];
const seenOvernightHubs = new Set();

for (const day of itinerary) {
  const rawHub = day.overnight_hub || day.hub;

  if (!rawHub) continue;

  const key = normalizeHotelHub(rawHub);

  if (!key || seenOvernightHubs.has(key)) continue;

  seenOvernightHubs.add(key);

  overnightHubs.push({
    key,
    raw: rawHub,
    label: displayHotelHub(rawHub),
  });
}

const standardHotels = hotels.filter((hotel) => {
  const tier = String(hotel.tier || "").trim().toLowerCase();

  return isActiveRow(hotel) && tier === "standard";
});

const routeHotels = overnightHubs
  .map((hub) => {
    const hotel = standardHotels.find((candidate) => {
      return (
        normalizeHotelHub(candidate.hub_name || candidate.hub) === hub.key
      );
    });

    if (!hotel) return null;

    return {
      ...hotel,
      route_hub_label: hub.label,
    };
  })
  .filter(Boolean);

const routeFood = dishes
  .filter((dish) =>
    includesAny(
      [
        dish.province_code,
        dish.destination_code,
        dish.region_code,
        dish.hub,
        dish.name,
        dish.slug,
        dish.desc_short,
        dish.description,
      ].join(" "),
      locationTokens.concat(provinceTokens)
    )
  )
  .slice(0, 4);

const routeHubs = locations
  .filter((location) => {
    const locationText = [
      location.name,
      location.location_name,
      location.slug,
      location.location_slug,
      location.province,
      location.province_name,
      location.type,
      location.is_hub,
    ].join(" ");
    return includesAny(locationText, locationTokens) && (
      String(location.type || "").toLowerCase().includes("hub") ||
      String(location.is_hub || "").toLowerCase() === "true" ||
      String(location.is_hub || "") === "1"
    );
  })
  .slice(0, 4);

const attractionByCode = new Map(
  allAttractions
    .map((item) => [String(item.attraction_code || item.code || "").trim(), item])
    .filter(([key]) => key)
);
const linkedAttractionSlugs = new Set(linkedAttractions.map((item) => item.slug).filter(Boolean));
const optionalAttractions = allAttractions
  .filter((item) => !linkedAttractionSlugs.has(item.slug))
  .filter((item) => includesAny([
    item.province, item.province_name, item.region, item.region_name, item.location,
    item.location_name, item.destination_code, item.summary, item.description
  ].join(" "), locationTokens.concat(provinceTokens)))
  .slice(0, 4);

const foodBySlug = new Map(
  routeFood.map((item) => [
    String(item.slug || "").toLowerCase(),
    item
  ])
);

/*
 * Always present the itinerary in true chronological order.
 * Hubs are now visual markers within the day-by-day flow,
 * rather than containers that interrupt the sequence.
 */
const sortedItinerary = [...itinerary].sort((a, b) => {
  const aDay = Number(a.day_number || 9999);
  const bDay = Number(b.day_number || 9999);

  return aDay - bDay;
});

function attractionCodeFor(item) {
  return String(
    item?.attraction_code ||
    item?.code ||
    item?.slug ||
    ""
  ).trim();
}

/*
 * Today's Highlights should be actual attractions.
 * Return the complete attraction object instead of reducing
 * it to plain text so the page can open a detail popup.
 */
function dayHighlights(day) {
  const seen = new Set();

  return list(day.attraction_codes)
    .map((code) => attractionByCode.get(String(code).trim()))
    .filter(Boolean)
    .filter((item) => {
      const key = attractionCodeFor(item);

      if (!key || seen.has(key)) return false;

      seen.add(key);
      return true;
    })
    .slice(0, 6);
}

/*
 * Count consecutive overnight-hub rows so the itinerary can
 * show a compact "Kabul · 2 nights" marker without breaking
 * the Day 1 → Day 2 → Day 3 flow.
 */
function itineraryHubKey(day) {
  return cleanText(
    day.overnight_hub ||
    day.hub ||
    day.location ||
    "On the road"
  );
}

const itineraryFlow = sortedItinerary.map((day, index) => {
  const hubKey = itineraryHubKey(day);
  const previousHub =
    index > 0
      ? itineraryHubKey(sortedItinerary[index - 1])
      : "";

  const showHub = index === 0 || hubKey !== previousHub;

  let hubCount = 0;

  if (showHub) {
    for (let cursor = index; cursor < sortedItinerary.length; cursor += 1) {
      if (itineraryHubKey(sortedItinerary[cursor]) !== hubKey) break;
      hubCount += 1;
    }
  }

  return {
    day,
    dayNumber:
      Number(day.day_number) ||
      index + 1,
    hubKey,
    hubLabel: humanize(hubKey || "On the road"),
    hubCount,
    showHub,
  };
});

/*
 * Only send attraction information actually used by this
 * itinerary to the browser popup.
 */
const itineraryAttractionData = {};

for (const entry of itineraryFlow) {
  for (const attraction of dayHighlights(entry.day)) {
    const code = attractionCodeFor(attraction);

    if (!code) continue;

    const tags = String(attraction.tags || "")
      .split(/[,|#]/)
      .map((t) => String(t || "").trim())
      .filter(Boolean)
      .slice(0, 6);

    const practical = [];
    if (attraction.visit_duration_hours) practical.push({ label: "Duration", value: `${attraction.visit_duration_hours} hours` });
    if (attraction.access_difficulty) practical.push({ label: "Access", value: String(attraction.access_difficulty) });
    const season = [attraction.season_start, attraction.season_end].filter(Boolean).join("–");
    if (season) practical.push({ label: "Season", value: season });
    if (attraction.seasonal_notes) practical.push({ label: "Season note", value: String(attraction.seasonal_notes) });
    if (attraction.recommended_time_of_day) practical.push({ label: "Best time", value: String(attraction.recommended_time_of_day) });
    if (attraction.photography_rating) practical.push({ label: "Photography", value: String(attraction.photography_rating) });
    if (attraction.cultural_sensitivity) practical.push({ label: "Sensitivity", value: String(attraction.cultural_sensitivity) });
    if (attraction.notes) practical.push({ label: "Notes", value: String(attraction.notes) });

    itineraryAttractionData[code] = {
      code,
      name: attraction.name || attraction.title || "Attraction",
      slug: attraction.slug || "",
      image: imageFor(attraction),
      summary:
        attraction.desc_short ||
        attraction.summary ||
        attraction.description ||
        "An attraction included in this part of the journey.",
      description:
        attraction.desc_long ||
        attraction.long_description ||
        attraction.description ||
        attraction.desc_short ||
        attraction.summary ||
        "An attraction included in this part of the journey.",
      location:
        attraction.location_name ||
        attraction.location ||
        attraction.city ||
        "",
      province: attraction.province_name || attraction.province || "",
      region: attraction.region || "",
      category: attraction.category || attraction.primary_category || "",
      tags,
      practical,
    };
  }
}

const needsMountain4wd = [
  tour.transport_note,
  tourName,
  tour.slug,
  tour.summary,
  tour.activity_level,
  tour.season,
  routeText,
].join(" ").toLowerCase().match(/4wd|4x4|ski|bamyan|mountain|challenging|winter/);

const routeTransport = transport
  .filter(isActiveRow)
  .filter((item) => {
    if (!needsMountain4wd) return true;
    const text = `${item.transport_name || ""} ${item.transport_slug || ""} ${item.vehicle_type || ""} ${item.logic_notes || ""}`.toLowerCase();
    return /4x4|suv|land cruiser|land_cruiser/.test(text);
  })
  .slice(0, 3);

const galleryImages = unique([
  heroImage,
  overviewImage,
  ...(Array.isArray(tour.gallery) ? tour.gallery : []),
  ...linkedAttractions.map(imageFor),
  ...routeFood.map(imageFor),
  ...routeHotels.map(imageFor),
].filter(Boolean));

const heroGallery = Array.from({ length: 5 }, (_, index) => galleryImages[index] || galleryImages[0] || heroImage);

const highlights = unique([
  linkedAttractions[0]?.name && `Visit ${linkedAttractions[0].name}`,
  linkedAttractions[1]?.name && `Explore ${linkedAttractions[1].name}`,
  routeText && `Travel the ${routeText} route`,
  routeFood[0]?.name && `Experience ${routeFood[0].name}`,
  tour.travel_style && `${tour.travel_style} journey with local coordination`,
  tour.transport_note,
].filter(Boolean)).slice(0, 6);

const globalInclusions = allInclusions
  .filter(isActiveRow)
  .filter((row) => row.tour_code === "ALL" || row.tour_slug === "all-tours");
const specificInclusions = Array.isArray(tour.inclusions) ? tour.inclusions.filter(isActiveRow) : [];
const inclusions = [...globalInclusions, ...specificInclusions]
  .sort((a, b) => Number(a.sort_order || 999) - Number(b.sort_order || 999))
  .filter((row, index, rows) => rows.findIndex((other) => String(other.title).toLowerCase() === String(row.title).toLowerCase()) === index)
  .slice(0, 10);

const dates = Array.isArray(tour.dates) ? tour.dates : [];
const scheduledDates = dates.filter((row) => {
  const start = String(row?.date_start || "").trim().toLowerCase();
  return start && start !== "inquire";
});
const price = formatPrice(tour.price_from || tour.price_display);
const duration = tour.duration_days && Number(tour.duration_days) > 0 ? `${tour.duration_days} days` : (tour.duration_display || "Flexible duration");
const groupSize = tour.group_size_display || (
  tour.min_group_size && tour.max_group_size
    ? `${tour.min_group_size}–${tour.max_group_size} travelers`
    : "Private / small group"
);

const relatedTours = allTours
  .filter((item) => item.slug !== tour.slug)
  .filter((item) => {
    const pc = String(item.product_class || "").toLowerCase();
    return pc === "scheduled" || pc === "private-fixed";
  })
  .filter((item) => {
    const text = `${item.regions || ""} ${item.travel_style || ""} ${item.summary || ""}`.toLowerCase();
    return provinceTokens.some((province) => text.includes(String(province).toLowerCase()));
  })
  .slice(0, 3);

const pageDescription =
  tour.summary ||
  tour.description ||
  "A guided Afghanistan journey built around realistic logistics, cultural access, and Kabul-based ground coordination.";
const contactHref = `/contact/?tour=${encodeURIComponent(tourName)}`;
---

<BaseLayout title={`${tourName} | AfghanTours`} description={pageDescription} image={heroImage}>
  <article class="tour-detail">
    <div class="tour-shell tour-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span>›</span><a href="/tours/">Tours</a><span>›</span><strong>{tourName}</strong>
    </div>

    <header class="tour-hero tour-shell">
      <div class="tour-hero__copy">
        <p class="tour-kicker">{tour.travel_style || "Guided journey"}</p>
        <h1>{tourName}</h1>
        <p class="tour-hero__summary">{pageDescription}</p>

        <div class="tour-facts" aria-label="Tour facts">
          <div><span>Duration</span><strong>{duration}</strong></div>
          <div><span>Group</span><strong>{groupSize}</strong></div>
          <div><span>Activity</span><strong>{tour.activity_level || "Moderate"}</strong></div>
        </div>

        <div class="tour-hero__actions">
          <a class="tour-button tour-button--primary" href={contactHref}>Plan this tour</a>
          {isCustomJourney ? (
  <a
    class="tour-button tour-button--ghost"
    href={`/contact/?type=custom-tour&tour=${encodeURIComponent(tourName)}`}
  >
    Build my journey
  </a>
) : (
  <a class="tour-button tour-button--ghost" href="#itinerary">View itinerary</a>
)}
        </div>
      </div>

      <div class="tour-hero__gallery" aria-label={`${tourName} photo gallery`}>
        <button
          class="tour-gallery-tile tour-gallery-tile--lead"
          type="button"
          data-tour-gallery-index="0"
          aria-label={`Open ${tourName} photo 1 of ${galleryImages.length}`}
        >
          <img src={heroGallery[0]} alt={`${tourName} in Afghanistan`} fetchpriority="high" />
        </button>

        <div class="tour-hero__thumbs">
          {heroGallery.slice(1, 5).map((image, index) => (
            <button
              class="tour-gallery-tile"
              type="button"
              data-tour-gallery-index={Math.min(index + 1, Math.max(galleryImages.length - 1, 0))}
              aria-label={`Open ${tourName} photo ${Math.min(index + 2, Math.max(galleryImages.length, 1))} of ${galleryImages.length}`}
            >
              <img src={image} alt={`${tourName} route preview ${index + 2}`} loading="lazy" />
            </button>
          ))}
        </div>

        {galleryImages.length > 1 && (
          <button class="tour-gallery-count" type="button" data-tour-gallery-index="0">
            View all {galleryImages.length} photos
          </button>
        )}
      </div>
    </header>

    <div class="tour-lightbox" data-tour-lightbox hidden role="dialog" aria-modal="true" aria-label={`${tourName} photo gallery`}>
      <button class="tour-lightbox__backdrop" type="button" data-tour-lightbox-close aria-label="Close photo gallery"></button>
      <div class="tour-lightbox__panel">
        <div class="tour-lightbox__bar">
          <span class="tour-lightbox__counter" data-tour-lightbox-counter></span>
          <button class="tour-lightbox__close" type="button" data-tour-lightbox-close aria-label="Close photo gallery">×</button>
        </div>
        <div class="tour-lightbox__stage">
          <button class="tour-lightbox__nav tour-lightbox__nav--prev" type="button" data-tour-lightbox-prev aria-label="Previous photo">‹</button>
          <img class="tour-lightbox__image" data-tour-lightbox-image src={heroGallery[0]} alt={`${tourName} gallery photo`} />
          <button class="tour-lightbox__nav tour-lightbox__nav--next" type="button" data-tour-lightbox-next aria-label="Next photo">›</button>
        </div>
      </div>
    </div>

    <script type="application/json" id="tour-gallery-data" set:html={JSON.stringify(galleryImages)}></script>

    <nav class="tour-tabs" aria-label="Tour page sections">
      <div class="tour-shell tour-tabs__inner">
        <a href="#overview">Overview</a>
        <a href="#itinerary">Itinerary</a>
        <a href="#accommodation">Accommodation</a>
        <a href="#experiences">Experiences</a>
        <a href="#practical">Know before you go</a>
      </div>
    </nav>

    <div class="tour-shell tour-content-grid">
      <main class="tour-main">
        <aside class="tour-note">
          <div>
            <strong>Built around your dates.</strong>
            <p>Most AfghanTours journeys are private or small-group and can be adjusted around your interests, pace, and available travel window.</p>
          </div>
          <a href={contactHref}>Speak with our Kabul team</a>
        </aside>

        <section id="overview" class="tour-section">
          <p class="tour-kicker">Overview</p>
          <h2>Experience Afghanistan with local context.</h2>
          <p class="tour-lead">{pageDescription}</p>
          {routeText && <p class="tour-route"><strong>Route:</strong> {routeText}</p>}

          {(highlights.length > 0 || inclusions.length > 0) && (
            <div class="tour-columns">
              {inclusions.length > 0 && (
                <div>
                  <h3>What's included</h3>
                  <ul class="tour-check-list">
                    {inclusions.map((item) => <li>{item.title}{item.description ? <span>{item.description}</span> : null}</li>)}
                  </ul>
                </div>
              )}

              {highlights.length > 0 && (
                <div>
                  <h3>Why you'll love it</h3>
                  <ul class="tour-check-list tour-check-list--plain">
                    {highlights.map((item) => <li>{item}</li>)}
                  </ul>
                </div>
              )}
            </div>
          )}
        </section>

        <section id="itinerary" class="tour-section tour-section--bordered">
          <p class="tour-kicker">Itinerary</p>
          <h2>{itinerary.length ? `${itinerary.length}-day journey` : "A route shaped around your trip"}</h2>
          <p class="tour-section-intro">The itinerary is grouped by the places you stay, so you can see how the journey moves through Afghanistan. Daily plans may shift with road conditions, weather, local access, and the final interests of your group.</p>

          {itinerary.length > 0 ? (
            <>
              <div class="tour-itinerary-timeline tour-itinerary-flow" data-tour-itinerary>
                {itineraryFlow.map((entry) => {
                  const day = entry.day;
                  const highlightsForDay = dayHighlights(day);

                  return (
                    <div class="tour-itinerary-step">

                      {entry.showHub && (
                        <header class="tour-itinerary-hub">
                          <div class="tour-itinerary-hub__dot" aria-hidden="true"></div>

                          <h3>{entry.hubLabel}</h3>

                          {entry.hubCount > 0 && (
                            <span>
                              {entry.hubCount}
                              {" "}
                              {entry.hubCount === 1 ? "night" : "nights"}
                            </span>
                          )}
                        </header>
                      )}

                      <article class="tour-day-block">
                        <div
                          class="tour-day-block__dot"
                          aria-hidden="true"
                        ></div>

                        <h4>
                          Day {entry.dayNumber}:{" "}
                          {day.title || day.location || "Touring day"}
                        </h4>

                        <div class="tour-day-block__body">

                          {day.description && (
                            <p>{day.description}</p>
                          )}

                          {(day.location || day.food_culture) && (
                            <div class="tour-day-block__meta">

                              {day.location && (
                                <span>
                                  <strong>Location</strong>
                                  {day.location}
                                </span>
                              )}

                              {day.food_culture && (
                                <span>
                                  <strong>Food & culture</strong>
                                  {humanize(day.food_culture)}
                                </span>
                              )}

                            </div>
                          )}

                          {highlightsForDay.length > 0 && (
                            <aside class="tour-day-highlights">

                              <strong>
                                Today's highlights
                              </strong>

                              <ul>
                                {highlightsForDay.map((attraction) => {
                                  const code =
                                    attractionCodeFor(attraction);

                                  const attractionName =
                                    attraction.name ||
                                    attraction.title ||
                                    "Attraction";

                                  return (
                                    <li>
                                      <button
                                        class="tour-highlight-link"
                                        type="button"
                                        data-attraction-popup={code}
                                        data-day-number={entry.dayNumber}
                                        data-day-title={day.title || day.location || ""}
                                        aria-label={`Open information about ${attractionName}`}
                                      >
                                        <span>{attractionName}</span>
                                        <span
                                          class="tour-highlight-link__icon"
                                          aria-hidden="true"
                                        >
                                          ↗
                                        </span>
                                      </button>
                                    </li>
                                  );
                                })}
                              </ul>

                            </aside>
                          )}

                        </div>
                      </article>

                    </div>
                  );
                })}
              </div>

              <button
                class="tour-itinerary-toggle"
                type="button"
                data-tour-itinerary-toggle
              >
                Collapse itinerary
              </button>
            </>
          ) : (
            <div class="tour-empty">A detailed itinerary is prepared during planning for this journey.</div>
          )}
        </section>

        <!-- ==================================================
             ITINERARY ATTRACTION QUICK VIEW
             ================================================== -->

        <div
          class="tour-attraction-popup"
          data-attraction-modal
          hidden
          role="dialog"
          aria-modal="true"
          aria-labelledby="tour-attraction-popup-title"
        >
          <button
            class="tour-attraction-popup__backdrop"
            type="button"
            data-attraction-close
            aria-label="Close attraction information"
          ></button>

          <div class="tour-attraction-popup__panel">

            <button
              class="tour-attraction-popup__close"
              type="button"
              data-attraction-close
              aria-label="Close attraction information"
            >
              ×
            </button>

            <div class="tour-attraction-popup__image-wrap">
              <img
                class="tour-attraction-popup__image"
                data-attraction-image
                src=""
                alt=""
              />
            </div>

            <div class="tour-attraction-popup__body">

              <p class="tour-kicker" data-attraction-kicker>
                Today's highlight
              </p>

              <h3
                id="tour-attraction-popup-title"
                data-attraction-title
              ></h3>

              <p
                class="tour-attraction-popup__location"
                data-attraction-location
              ></p>

              <div class="tour-attraction-popup__tags" data-attraction-tags hidden></div>

              <p
                class="tour-attraction-popup__description"
                data-attraction-description
              ></p>

              <div class="tour-attraction-popup__context" data-attraction-context hidden>
                <p class="tour-attraction-popup__section-label">Itinerary context</p>
                <p data-attraction-context-text></p>
              </div>

              <div class="tour-attraction-popup__practical" data-attraction-practical hidden>
                <p class="tour-attraction-popup__section-label">Traveler notes</p>
                <dl data-attraction-practical-list></dl>
              </div>

              <div class="tour-attraction-popup__actions">

                <button
                  class="tour-button tour-button--ghost"
                  type="button"
                  data-attraction-close
                >
                  Back to itinerary
                </button>

                <a
                  class="tour-button tour-button--primary"
                  data-attraction-page
                  href="#"
                >
                  Explore attraction
                </a>

              </div>

            </div>
          </div>
        </div>

        <script
          type="application/json"
          id="tour-attraction-popup-data"
          set:html={JSON.stringify(itineraryAttractionData)}
        ></script>

        <section id="accommodation" class="tour-section tour-section--bordered">
          <p class="tour-kicker">Accommodation</p>
          <h2>Handpicked accommodations</h2>
          <p class="tour-section-intro">These are our standard hotel selections for the overnight hubs on this itinerary. Final hotel assignments may change depending on availability, operational requirements, or route adjustments.</p>

          {routeHotels.length > 0 ? (
            <div class="tour-stay-scroller" aria-label="Hotels on this route">
              {routeHotels.map((hotel) => {
                const hotelName = hotel.display_name || hotel.hotel_name || hotel.name || "Hotel";
                const hotelSlug = hotel.hotel_slug || hotel.slug;
                return (
                  <a class="tour-stay-card" href={hotelSlug ? `/hotels/${hotelSlug}/` : "#"}>
                    <img src={imageFor(hotel)} alt={hotelName} loading="lazy" />
                    <div class="tour-stay-card__body">
                      <div class="tour-stay-card__hub">
                        Standard hotel · {hotel.route_hub_label || hotel.hub_name || "Overnight hub"}
                      </div>
                      <strong>{hotelName}</strong>
                      <p>{hotel.description || hotel.summary || "Our standard hotel selection for this overnight hub."}</p>
                      <span>Read more →</span>
                    </div>
                  </a>
                );
              })}
            </div>
          ) : (
            <div class="tour-empty">Hotels are confirmed once your final route and dates are set.</div>
          )}
        </section>

        <section id="experiences" class="tour-section tour-section--bordered">
          <p class="tour-kicker">Experiences</p>
          <h2>Places, culture, and optional additions</h2>

          {linkedAttractions.length > 0 && (
            <div class="tour-subsection">
              <h3>Places on the route</h3>
              <div class="tour-card-grid">
                {linkedAttractions.slice(0, 6).map((item) => (
                  <a class="tour-image-card" href={item.slug ? `/attractions/${item.slug}/` : "#"}>
                    <img src={imageFor(item)} alt={item.name || item.title} loading="lazy" />
                    <div><span>Attraction</span><strong>{item.name || item.title}</strong><p>{item.summary || item.description || "Part of this route."}</p></div>
                  </a>
                ))}
              </div>
            </div>
          )}

          {routeFood.length > 0 && (
            <div class="tour-subsection">
              <h3>Food and culture</h3>
              <div class="tour-card-grid tour-card-grid--two">
                {routeFood.map((item) => (
                  <a class="tour-image-card" href={foodHref(item)}>
                    <img src={imageFor(item)} alt={item.name || "Afghan food and culture"} loading="lazy" />
                    <div><span>{item.category || "Food & culture"}</span><strong>{item.name}</strong><p>{item.desc_short || item.description || "A cultural experience connected to this journey."}</p></div>
                  </a>
                ))}
              </div>
            </div>
          )}

          {(optionalAttractions.length > 0 || routeFood.length > 0) && (
            <div class="tour-subsection tour-customize">
              <h3>Customize your journey</h3>
              <p>Depending on your dates, interests, route, and local conditions, additional stops can sometimes be incorporated into the trip.</p>
              <div class="tour-excursion-scroller" aria-label="Possible additions to this tour">
                {(optionalAttractions.length > 0 ? optionalAttractions : routeFood).slice(0, 4).map((item) => {
                  const isAttraction = optionalAttractions.length > 0;
                  const href = isAttraction && item.slug ? `/attractions/${item.slug}/` : foodHref(item);
                  return (
                    <article class="tour-excursion-card">
                      <img src={imageFor(item)} alt={item.name || item.title || "Optional experience"} loading="lazy" />
                      <div>
                        <strong>{item.name || item.title}</strong>
                        <span>{isAttraction ? "Possible route addition" : "Food & culture"}</span>
                        <a href={href}>See details</a>
                      </div>
                    </article>
                  );
                })}
              </div>
            </div>
          )}

          {linkedAttractions.length === 0 && routeFood.length === 0 && optionalAttractions.length === 0 && (
            <div class="tour-empty">Cultural stops and featured experiences are tailored to the final route.</div>
          )}
        </section>

        <section id="practical" class="tour-section tour-section--bordered">
          <p class="tour-kicker">Know before you go</p>
          <h2>Practical trip information</h2>
          <p class="tour-section-intro">Open each section for the planning information most relevant to this journey.</p>

          <div class="tour-know-list">
            <details>
              <summary>Passport, visa & entry requirements</summary>
              <p>Entry requirements depend on nationality and current rules. AfghanTours can explain the supporting documentation available for confirmed travelers, but travelers should verify current official requirements before departure.</p>
            </details>
            <details>
              <summary>Arrival & departure information</summary>
              <p>Arrival and departure transfers are coordinated around the confirmed itinerary and flight schedule. Final pickup details are provided before travel.</p>
            </details>
            <details>
              <summary>Physical activity level & mobility</summary>
              <p>This tour is rated <strong>{tour.activity_level || "Moderate"}</strong>. Walking, altitude, road time, stairs, uneven surfaces, and other physical requirements are reviewed during trip planning.</p>
            </details>
            <details>
              <summary>Transportation on tour</summary>
              <p>{tour.transport_note || "Private ground transportation is arranged according to the route, terrain, season, and group size."}</p>
              {routeTransport.length > 0 && <p><strong>Typical transport:</strong> {routeTransport.map((item) => item.transport_name || item.vehicle_type).filter(Boolean).join(", ")}</p>}
            </details>
            <details>
              <summary>Clothing & packing tips</summary>
              <p>Packing guidance is provided before departure. Clothing and equipment needs vary by season, altitude, destination, and the activities included in your itinerary.</p>
            </details>
            <details>
              <summary>Hotels on tour</summary>
              <p>{tour.accommodation_note || "Accommodation is selected around the overnight route, with an emphasis on practical comfort, location, and reliable operations."}</p>
            </details>
            <details>
              <summary>Health</summary>
              <p>Travelers should discuss personal medical needs, vaccinations, medications, altitude concerns, and travel insurance with qualified professionals before departure. Tell AfghanTours about mobility or dietary requirements that affect trip planning.</p>
            </details>
            <details>
              <summary>Meals & Afghan cuisine</summary>
              <p>Meals vary by region and itinerary. Local dishes and food experiences can be incorporated where practical, and dietary requirements should be discussed before travel.</p>
            </details>
            <details>
              <summary>Currency & payments</summary>
              <p>Cash remains the most practical form of payment for many day-to-day expenses in Afghanistan, and card acceptance is limited. Current money guidance is provided before departure.</p>
            </details>
            <details>
              <summary>Wi-Fi, mobile data & connectivity</summary>
              <p>Mobile data and Wi-Fi are available in many cities and hotels, but speed and reliability vary significantly along the route.</p>
            </details>
            <details>
              <summary>Guides & on-tour support</summary>
              <p>Trips are coordinated by AfghanTours from Kabul with local guides, drivers, hotels, and other partners selected according to the itinerary.</p>
            </details>
            <details>
              <summary>Photography</summary>
              <p>Photography rules vary by location. Travelers should ask before photographing people and follow local guidance around government, military, religious, and other sensitive sites.</p>
            </details>
            <details>
              <summary>Time zones</summary>
              <p>Afghanistan uses Afghanistan Time (UTC+4:30) throughout the year.</p>
            </details>
            <details>
              <summary>Responsible travel</summary>
              <p>Guests are expected to respect local customs, dress guidance, religious practices, communities, photography preferences, and site-specific instructions throughout the journey.</p>
            </details>
          </div>
        </section>

        {tour.content_html && (
          <details class="tour-long-notes">
            <summary>Read detailed trip notes</summary>
            <div class="tour-long-notes__body" set:html={tour.content_html}></div>
          </details>
        )}
      </main>

      <aside class="tour-sidebar" aria-label="Tour planning">
        <div class="tour-plan-card">
          <div class="tour-summary-label">Tour summary</div>
          <h2 class="tour-plan-card__title">{tourName}</h2>
          <div class="tour-plan-card__price">{price}</div>
          <p class="tour-plan-card__sub">Final pricing depends on group size, route, hotel level, domestic flights, and travel dates.</p>

          <dl class="tour-plan-facts">
            <div><dt>Duration</dt><dd>{duration}</dd></div>
            <div><dt>Group</dt><dd>{groupSize}</dd></div>
            <div><dt>Activity</dt><dd>{tour.activity_level || "Moderate"}</dd></div>
            <div><dt>Season</dt><dd>{tour.season || "Route dependent"}</dd></div>
          </dl>

          {scheduledDates.length > 0 ? (
            <div class="tour-date-selector">
              <div class="tour-date-selector__heading">
                <h3>Select tour date</h3>
                <span>Published departures</span>
              </div>
              <div class="tour-date-selector__rows">
                {scheduledDates.slice(0, 5).map((date) => (
                  <a class="tour-date-choice" href={`${contactHref}&date=${encodeURIComponent(dateLabel(date))}`}>
                    <span class="tour-date-choice__radio" aria-hidden="true"></span>
                    <span class="tour-date-choice__date">{dateLabel(date)}</span>
                    <span class="tour-date-choice__status">{statusLabel(date.status)}</span>
                  </a>
                ))}
              </div>
              <p class="tour-date-selector__note">Daily plans may be adjusted for weather, road conditions, local requirements, access, or other operational considerations.</p>
            </div>
          ) : (
            <form class="tour-date-planner" action="/contact/" method="get">
              <input type="hidden" name="tour" value={tourName} />
              <h3>Plan your departure</h3>
              <p>This journey can be arranged around your preferred dates and group size.</p>
              <label>
                Preferred travel month
                <input type="month" name="preferred_month" />
              </label>
              <label>
                Group size
                <select name="group_size">
                  <option value="">Select group size</option>
                  <option>1 traveler</option>
                  <option>2 travelers</option>
                  <option>3–4 travelers</option>
                  <option>5–6 travelers</option>
                  <option>7+ travelers</option>
                </select>
              </label>
              <button class="tour-button tour-button--primary tour-button--wide" type="submit">Plan this tour</button>
            </form>
          )}

          {scheduledDates.length > 0 && <a class="tour-button tour-button--primary tour-button--wide" href={contactHref}>Ask about this tour</a>}
          <a class="tour-plan-link" href="/contact/">Request a custom itinerary</a>
        </div>

        <div class="tour-help-card">
          <strong>Traveling together?</strong>
          <p>Private groups, families, friends, researchers, and organizations can request a trip built around their dates, pace, and interests.</p>
          <a href={contactHref}>Speak with a Tour Consultant</a>
        </div>
      </aside>
    </div>

    {relatedTours.length > 0 && (
      <section class="tour-related">
        <div class="tour-shell">
          <p class="tour-kicker">You may also like</p>
          <h2>More journeys through Afghanistan</h2>
          <div class="tour-card-grid tour-card-grid--three">
            {relatedTours.map((item) => (
              <a class="tour-image-card tour-image-card--related" href={`/tours/${item.slug}/`}>
                <img src={imageFor(item)} alt={item.name || item.title} loading="lazy" />
                <div><span>{item.duration_days ? `${item.duration_days} days` : "Custom tour"}</span><strong>{item.name || item.title}</strong><p>{item.summary}</p></div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>

  <script>
    const galleryRoot = document.querySelector('.tour-detail');
    if (galleryRoot) {
      const data = galleryRoot.querySelector('#tour-gallery-data');
      const lightbox = galleryRoot.querySelector('[data-tour-lightbox]');
      const lightboxImage = galleryRoot.querySelector('[data-tour-lightbox-image]');
      const counter = galleryRoot.querySelector('[data-tour-lightbox-counter]');
      const triggers = galleryRoot.querySelectorAll('[data-tour-gallery-index]');
      const closeButtons = galleryRoot.querySelectorAll('[data-tour-lightbox-close]');
      const prevButton = galleryRoot.querySelector('[data-tour-lightbox-prev]');
      const nextButton = galleryRoot.querySelector('[data-tour-lightbox-next]');
      let images = [];
      let activeIndex = 0;
      let previousOverflow = '';

      try {
        images = JSON.parse(data?.textContent || '[]');
      } catch (error) {
        images = [];
      }

      const render = () => {
        if (!images.length || !lightboxImage) return;
        activeIndex = (activeIndex + images.length) % images.length;
        lightboxImage.src = images[activeIndex];
        lightboxImage.alt = `Tour gallery photo ${activeIndex + 1} of ${images.length}`;
        if (counter) counter.textContent = `${activeIndex + 1} / ${images.length}`;
        const hasMultiple = images.length > 1;
        if (prevButton) prevButton.hidden = !hasMultiple;
        if (nextButton) nextButton.hidden = !hasMultiple;
      };

      const open = (index = 0) => {
        if (!lightbox || !images.length) return;
        activeIndex = Number.isFinite(index) ? index : 0;
        render();
        previousOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        lightbox.hidden = false;
        galleryRoot.querySelector('.tour-lightbox__close')?.focus();
      };

      const close = () => {
        if (!lightbox) return;
        lightbox.hidden = true;
        document.body.style.overflow = previousOverflow;
      };

      triggers.forEach((trigger) => {
        trigger.addEventListener('click', () => open(Number(trigger.dataset.tourGalleryIndex || 0)));
      });
      closeButtons.forEach((button) => button.addEventListener('click', close));
      prevButton?.addEventListener('click', () => { activeIndex -= 1; render(); });
      nextButton?.addEventListener('click', () => { activeIndex += 1; render(); });

      document.addEventListener('keydown', (event) => {
        if (!lightbox || lightbox.hidden) return;
        if (event.key === 'Escape') close();
        if (event.key === 'ArrowLeft') { activeIndex -= 1; render(); }
        if (event.key === 'ArrowRight') { activeIndex += 1; render(); }
      });
    }


    /*
     * Itinerary attraction quick-view popup
     */
    const attractionDataElement =
      document.querySelector('#tour-attraction-popup-data');

    const attractionModal =
      document.querySelector('[data-attraction-modal]');

    const attractionTriggers =
      document.querySelectorAll('[data-attraction-popup]');

    const attractionCloseButtons =
      document.querySelectorAll('[data-attraction-close]');

    let itineraryAttractions = {};
    let attractionPreviousOverflow = '';

    try {
      itineraryAttractions = JSON.parse(
        attractionDataElement?.textContent || '{}'
      );
    } catch (error) {
      itineraryAttractions = {};
    }

    const openAttractionPopup = (code, dayMeta = {}) => {
      if (!attractionModal) return;

      const attraction = itineraryAttractions[code];

      if (!attraction) return;

      const title =
        attractionModal.querySelector('[data-attraction-title]');

      const image =
        attractionModal.querySelector('[data-attraction-image]');

      const location =
        attractionModal.querySelector('[data-attraction-location]');

      const description =
        attractionModal.querySelector('[data-attraction-description]');

      const pageLink =
        attractionModal.querySelector('[data-attraction-page]');

      const kicker =
        attractionModal.querySelector('[data-attraction-kicker]');

      const tagsEl =
        attractionModal.querySelector('[data-attraction-tags]');

      const contextWrap =
        attractionModal.querySelector('[data-attraction-context]');

      const contextText =
        attractionModal.querySelector('[data-attraction-context-text]');

      const practicalWrap =
        attractionModal.querySelector('[data-attraction-practical]');

      const practicalList =
        attractionModal.querySelector('[data-attraction-practical-list]');

      const attractionName = attraction.name || 'Attraction';

      if (title) {
        title.textContent = attractionName;
      }

      if (kicker) {
        kicker.textContent = attraction.category
          ? `${attraction.category}`
          : "Today's highlight";
      }

      if (image) {
        image.src = attraction.image || '';
        image.alt = attractionName;
      }

      if (location) {
        const place = [
          attraction.location,
          attraction.province,
          attraction.region
        ].filter(Boolean).join(' · ');

        location.textContent = place;
        location.hidden = !place;
      }

      if (description) {
        description.textContent =
          attraction.description ||
          attraction.summary ||
          'Part of this journey.';
      }

      if (tagsEl) {
        const tags = Array.isArray(attraction.tags) ? attraction.tags : [];
        if (tags.length) {
          tagsEl.innerHTML = tags
            .map((tag) => `<span>${String(tag).replace(/[<>&]/g, '')}</span>`)
            .join('');
          tagsEl.hidden = false;
        } else {
          tagsEl.innerHTML = '';
          tagsEl.hidden = true;
        }
      }

      if (contextWrap && contextText) {
        const dayBits = [];
        if (dayMeta.dayNumber) dayBits.push(`Day ${dayMeta.dayNumber}`);
        if (dayMeta.dayTitle) dayBits.push(dayMeta.dayTitle);
        if (dayBits.length) {
          contextText.textContent = `Included on ${dayBits.join(' — ')}.`;
          contextWrap.hidden = false;
        } else {
          contextText.textContent = '';
          contextWrap.hidden = true;
        }
      }

      if (practicalWrap && practicalList) {
        const notes = Array.isArray(attraction.practical) ? attraction.practical : [];
        if (notes.length) {
          practicalList.innerHTML = notes
            .map((note) => `<div><dt>${String(note.label || '').replace(/[<>&]/g, '')}</dt><dd>${String(note.value || '').replace(/[<>&]/g, '')}</dd></div>`)
            .join('');
          practicalWrap.hidden = false;
        } else {
          practicalList.innerHTML = '';
          practicalWrap.hidden = true;
        }
      }

      if (pageLink) {
        if (attraction.slug) {
          pageLink.href = `/attractions/${attraction.slug}/`;
          pageLink.textContent = `Explore ${attractionName}`;
          pageLink.hidden = false;
        } else {
          pageLink.hidden = true;
        }
      }

      attractionPreviousOverflow =
        document.body.style.overflow;

      document.body.style.overflow = 'hidden';

      attractionModal.hidden = false;

      attractionModal
        .querySelector('.tour-attraction-popup__close')
        ?.focus();
    };

    const closeAttractionPopup = () => {
      if (!attractionModal) return;

      attractionModal.hidden = true;

      document.body.style.overflow =
        attractionPreviousOverflow;
    };

    attractionTriggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        openAttractionPopup(
          trigger.dataset.attractionPopup || '',
          {
            dayNumber: trigger.dataset.dayNumber || '',
            dayTitle: trigger.dataset.dayTitle || '',
          }
        );
      });
    });

    attractionCloseButtons.forEach((button) => {
      button.addEventListener(
        'click',
        closeAttractionPopup
      );
    });

    document.addEventListener('keydown', (event) => {
      if (
        event.key === 'Escape' &&
        attractionModal &&
        !attractionModal.hidden
      ) {
        closeAttractionPopup();
      }
    });

    const itineraryRoot = document.querySelector('[data-tour-itinerary]');
    const itineraryToggle = document.querySelector('[data-tour-itinerary-toggle]');
    if (itineraryRoot && itineraryToggle) {
      itineraryToggle.addEventListener('click', () => {
        const collapsed = itineraryRoot.classList.toggle('is-collapsed');
        itineraryToggle.textContent = collapsed ? 'Expand itinerary' : 'Collapse itinerary';
      });
    }
  </script>

  <style>
    .tour-detail {
      --tour-ink: #1c1d1b;
      --tour-muted: #66675f;
      --tour-line: #d9d7cf;
      --tour-soft: #f6f2ea;
      --tour-paper: #fffdfa;
      --tour-accent: #b9852f;
      --tour-dark: #111917;
      background: var(--tour-paper);
      color: var(--tour-ink);
      font-family: Arial, Helvetica, sans-serif;
    }

    .tour-shell { width: min(1180px, calc(100% - 2.5rem)); margin-inline: auto; }

    .tour-breadcrumbs {
      display: flex; align-items: center; gap: .5rem; padding: 1rem 0 .8rem;
      font-size: .75rem; color: #5e605b; white-space: nowrap; overflow-x: auto;
    }
    .tour-breadcrumbs a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
    .tour-breadcrumbs strong { color: var(--tour-ink); font-weight: 700; }

    .tour-hero {
      border: 1px solid var(--tour-line); background: #fff; overflow: hidden;
    }
    .tour-hero__copy { padding: clamp(1.7rem, 3.2vw, 3rem); }
    .tour-kicker { margin: 0 0 .55rem; color: #8a6526; font-size: .72rem; line-height: 1.2; font-weight: 900; letter-spacing: .16em; text-transform: uppercase; }
    .tour-hero h1 { margin: 0; max-width: 900px; font: 700 clamp(2.15rem, 4.3vw, 4.3rem)/1.02 Georgia, "Times New Roman", serif; letter-spacing: -.045em; }
    .tour-hero__summary { max-width: 880px; margin: 1rem 0 0; color: var(--tour-muted); font-size: 1rem; line-height: 1.65; }
    .tour-facts { display: flex; flex-wrap: wrap; gap: 1.4rem 2rem; margin-top: 1.55rem; }
    .tour-facts div { min-width: 115px; }
