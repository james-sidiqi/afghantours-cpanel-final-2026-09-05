    }

    .tour-lightbox__close {
      width: 42px;
      height: 42px;
      border: 0;
      border-radius: 999px;
      background: rgba(255,255,255,.12);
      color: #fff;
      font-size: 2rem;
      line-height: 1;
      cursor: pointer;
    }

    .tour-lightbox__stage {
      position: relative;
      min-width: 0;
      min-height: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 3.75rem 1rem;
      overflow: hidden;
    }

    /*
     * Expanded image:
