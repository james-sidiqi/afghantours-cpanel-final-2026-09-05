    .tour-hero__gallery {
      position: relative;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: stretch;
      gap: 4px;
      padding: 4px;
      height: auto;
      min-height: 0;
      background: #fff;
      border-top: 1px solid var(--tour-line);
    }

    /*
     * Desktop gallery geometry:
     * the lead image occupies one 16:9 panel.
     * The right half contains four 16:9 thumbnails.
     *
     * Because both sides have equal width, two thumbnail rows
     * naturally equal the height of the large image.
     */
    .tour-gallery-tile--lead {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      min-height: 0;
    }

    .tour-hero__thumbs {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(2, minmax(0, 1fr));
      gap: 4px;
      min-width: 0;
      min-height: 0;
    }

    .tour-gallery-tile {
      display: block;
      width: 100%;
      min-width: 0;
      min-height: 0;
      padding: 0;
      border: 0;
      overflow: hidden;
      background: #eee9df;
      cursor: zoom-in;
    }

    .tour-gallery-tile img {
      width: 100%;
      height: 100%;
      min-width: 0;
      display: block;
      object-fit: cover;
      object-position: center;
      transition: transform .25s ease, filter .25s ease;
    }

    .tour-gallery-tile:hover img {
      transform: scale(1.018);
      filter: brightness(.94);
    }
    .tour-gallery-count { position: absolute; right: 1rem; bottom: 1rem; border: 1px solid rgba(20,22,20,.2); border-radius: 999px; padding: .52rem .78rem; background: rgba(255,255,255,.94); color: #161715; font-size: .7rem; font-weight: 900; box-shadow: 0 3px 16px rgba(0,0,0,.15); cursor: pointer; }

    .tour-lightbox[hidden] { display: none; }
    .tour-lightbox { position: fixed; inset: 0; z-index: 9999; display: grid; place-items: center; padding: clamp(.75rem, 2vw, 1.5rem); }
    .tour-lightbox__backdrop { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: rgba(8,10,9,.93); cursor: zoom-out; }
    .tour-lightbox__panel {
      position: relative;
      z-index: 1;
      width: min(1600px, 100%);
      height: min(1000px, calc(100vh - 2rem));
      display: grid;
      grid-template-rows: auto 1fr;
    }

    .tour-lightbox__bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 48px;
      color: #fff;
    }

    .tour-lightbox__counter {
      font-size: .76rem;
      font-weight: 800;
