      max-height: 100%;
      object-fit: contain;
      object-position: center;
    }
    .tour-lightbox__nav { position: absolute; top: 50%; z-index: 2; width: 46px; height: 46px; border: 0; border-radius: 999px; background: rgba(255,255,255,.92); color: #111; font-size: 2rem; line-height: 1; transform: translateY(-50%); cursor: pointer; box-shadow: 0 4px 18px rgba(0,0,0,.25); }
    .tour-lightbox__nav--prev { left: .75rem; }
    .tour-lightbox__nav--next { right: .75rem; }

    .tour-tabs { position: sticky; top: 76px; z-index: 40; margin-top: 1rem; border-top: 1px solid var(--tour-line); border-bottom: 1px solid var(--tour-line); background: rgba(255,253,250,.96); backdrop-filter: blur(12px); }
