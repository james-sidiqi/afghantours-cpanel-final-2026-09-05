---
import fs from 'node:fs';
import path from 'node:path';

import BaseLayout from '../../layouts/BaseLayout.astro';
import TourCardGrid from '../../components/cards/TourCardGrid.astro';

import {
  getCollection,
  render,
} from 'astro:content';

import {
  getTours,
  getHubBySlug,
} from '../../lib/buildRelations';
import {
  getHubsForCultural,
  accessTypeLabel,
} from '../../lib/experiences';


export async function getStaticPaths() {
  const items = await getCollection(
    'cultural-experiences'
  );

  return items.map((item) => ({
    params: {
      slug: item.id.replace(/\.md$/, ''),
    },
    props: {
      item,
    },
  }));
}


const { item } = Astro.props;

const { Content } = await render(item);

const allExperiences = await getCollection(
  'cultural-experiences'
);

const allTours = getTours();


const slug =
  item.id.replace(/\.md$/, '');


const data = item.data;


const title =
  data.title;


const subtitle =
  data.subtitle ||
  data.card_description ||
  'A living cultural experience in Afghanistan.';


const description =
  data.card_description ||
  data.subtitle ||
  `Explore ${title}, one of Afghanistan's living cultural traditions.`;


const heroImage =
  data.hero_image ||
  data.image ||
  '/assets/images/placeholders/default-attraction.webp';


const provinces =
  Array.isArray(data.provinces)
    ? data.provinces
    : data.province
      ? [data.province]
      : [];


const relatedTourSlugs =
  Array.isArray(data.related_tours)
    ? data.related_tours
    : [];


/* =========================================================
   IMAGE DISCOVERY
   ========================================================= */

const imageCandidates = [];


const addImage = (value) => {
  if (!value) return;

  const normalized =
    String(value).trim();

  if (
    normalized &&
    !imageCandidates.includes(normalized)
  ) {
    imageCandidates.push(normalized);
  }
};


(data.gallery_images || []).forEach(addImage);

addImage(heroImage);
addImage(data.image);


/*
 * Discover images inside:
 *
 * 1. dedicated cultural experience folder
 * 2. same folder as the configured hero image
 *
 * This means experiences using an existing rich image
 * folder automatically gain a gallery.
 */

const foldersToCheck = [
  `/assets/images/experiences/cultural/${slug}/`,
  `/assets/images/experiences/cultural/${slug}/gallery/`,
  `/assets/images/cultural-experiences/${slug}/`,
  `/assets/images/cultural-experiences/${slug}/gallery/`,
];


if (
  heroImage &&
  heroImage.startsWith('/')
) {
  const heroFolder =
    heroImage.substring(
      0,
      heroImage.lastIndexOf('/') + 1
    );

  [heroFolder, `${heroFolder}gallery/`].forEach((folder) => {
    if (folder && !foldersToCheck.includes(folder)) {
      foldersToCheck.push(folder);
    }
  });
}


for (const folder of foldersToCheck) {

  const diskFolder = path.join(
    process.cwd(),
    'public',
    folder.replace(/^\/+/, '')
  );


  try {

    if (!fs.existsSync(diskFolder)) {
      continue;
    }


    const images = fs
      .readdirSync(diskFolder)
      .filter((name) =>
        /\.(webp|jpg|jpeg|png|avif)$/i.test(name)
      )
      .sort((a, b) => {

        const rank = (name) => {
          const lower =
            name.toLowerCase();

          if (
            lower.startsWith('hero.')
          ) return 0;

          if (
            lower.includes('overview')
          ) return 1;

          if (
            lower.includes('gallery')
          ) return 2;

          return 3;
        };


        return (
          rank(a) -
          rank(b) ||
          a.localeCompare(b)
        );

      });


    images.forEach((name) =>
      addImage(
        `${folder.replace(/\/?$/, '/')}${name}`
      )
    );

  } catch (error) {

    console.warn(
      `Gallery discovery failed for ${slug}`,
      error
    );

  }

}


const galleryImages =
  imageCandidates.slice(0, 9);


/* =========================================================
   RELATED TOURS
   ========================================================= */

const tourBySlug =
  new Map(
    allTours.map((tour) => [
      tour.slug,
      tour,
    ])
  );


const explicitTours =
  relatedTourSlugs
    .map((tourSlug) =>
      tourBySlug.get(tourSlug)
    )
    .filter(Boolean);


const normalize =
  (value) =>
    String(value || '')
      .toLowerCase()
      .trim();


const provinceSet =
  new Set(
    provinces.map(normalize)
  );


const tourProvinceNames = (tour) => {

  const values = [];


  if (Array.isArray(tour.provinces)) {

    tour.provinces.forEach((province) => {

      if (
        typeof province === 'string'
      ) {
        values.push(province);

      } else if (province) {

        values.push(
          province.title ||
          province.name ||
          province.slug ||
          province.province ||
          ''
        );

      }

    });

  }


  [
    tour.province,
    tour.primary_province,
  ]
    .filter(Boolean)
    .forEach((value) =>
      values.push(value)
    );


  return values
    .map(normalize)
    .filter(Boolean);
};


const explicitSlugSet =
  new Set(
    explicitTours.map(
      (tour) => tour.slug
    )
  );


const geographicFallback =
  allTours
    .filter(
      (tour) =>
        !explicitSlugSet.has(tour.slug)
    )
    .filter((tour) => {

      if (!provinceSet.size) {
        return false;
      }

      return tourProvinceNames(tour)
        .some((province) =>
          provinceSet.has(province)
        );

    });


const relatedTours = [
  ...explicitTours,
  ...geographicFallback,
]
  .filter(
    (tour, index, array) =>
      array.findIndex(
        (candidate) =>
          candidate.slug === tour.slug
      ) === index
  )
  .slice(0, 6);


/* =========================================================
   RELATED CULTURAL EXPERIENCES
   ========================================================= */

const type =
  normalize(
    data.experience_type
  );


const scoredExperiences =
  allExperiences
    .filter(
      (candidate) =>
        candidate.id !== item.id
    )
    .map((candidate) => {

      let score = 0;

      const candidateType =
        normalize(
          candidate.data.experience_type
        );


      if (
        type &&
        candidateType === type
      ) {
        score += 5;
      }


      const candidateProvinces =
        new Set(
          (
            candidate.data.provinces ||
            []
          ).map(normalize)
        );


      provinceSet.forEach(
        (province) => {

          if (
            candidateProvinces.has(
              province
            )
          ) {
            score += 3;
          }

        }
      );


      return {
        candidate,
        score,
      };

    })
    .sort(
      (a, b) =>
        b.score - a.score ||
        a.candidate.data.title.localeCompare(
          b.candidate.data.title
        )
    );


const relatedExperiences =
  scoredExperiences
    .slice(0, 6)
    .map(
      (entry) =>
        entry.candidate
    );


const pairedFoods =
  data.paired_foods || [];


const nearby =
  data.nearby || [];


const experienceType =
  data.experience_type ||
  'Cultural Experience';


const duration =
  data.duration ||
  (
    data.duration_hours
      ? `${data.duration_hours} hours`
      : 'Flexible'
  );


const season =
  data.best_season ||
  'Year round / timing dependent';


const contactHref =
  `/contact/?type=cultural-experience&experience=${encodeURIComponent(title)}`;

const culturalHubRels = getHubsForCultural(slug);
const culturalHubs = culturalHubRels.map((rel) => {
  const hub = getHubBySlug(rel.hub_slug);
  return {
    ...rel,
    title: hub?.title || hub?.name || String(rel.hub_slug || '').replace(/-city$/, ''),
    href: hub?.slug ? `/hubs/${hub.slug}/` : `/hubs/${rel.hub_slug}/`,
  };
});


const uniqueGalleryImages = (items = []) =>
  [...new Set(
    items
      .filter(Boolean)
      .map((item) => typeof item === 'string' ? item : item?.src || item?.image)
      .filter(Boolean)
  )];

---

<BaseLayout
  title={`${title} | AfghanTours`}
  description={description}
  image={heroImage}
>

  <!-- =====================================================
       HERO
       ===================================================== -->

  <section class="culture-hero">

    <img
      class="culture-hero-image"
      src={heroImage}
      alt={title}
      fetchpriority="high"
    />

    <div
      class="culture-hero-overlay"
      aria-hidden="true"
    ></div>


    <div class="culture-hero-inner">

      <nav
        class="breadcrumbs"
        aria-label="Breadcrumb"
      >

        <a href="/">
          Home
        </a>

        <span>›</span>

        <a href="/cultural-experiences/">
          Cultural Experiences
        </a>

      </nav>


      <div class="culture-hero-copy">

        <p class="kicker">
          {experienceType}
        </p>


        <h1>
          {title}
        </h1>


        <p class="hero-subtitle">
          {subtitle}
        </p>


        <div class="hero-actions">

          <a
            class="hero-primary"
            href="#experience-story"
          >
            Explore the experience
          </a>

          <a
            class="hero-secondary"
            href={contactHref}
          >
            Add it to my trip
          </a>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================================
       QUICK FACTS
       ===================================================== -->

  <section class="culture-facts-shell">

    <div class="culture-facts">

      <div class="culture-fact">
        <span>Experience</span>
        <strong>
          {experienceType}
        </strong>
      </div>


      <div class="culture-fact">
        <span>Where</span>
        <strong>
          {
            provinces.length
              ? provinces.join(', ')
              : 'Afghanistan'
          }
        </strong>
      </div>


      <div class="culture-fact">
        <span>Duration</span>
        <strong>
          {duration}
        </strong>
      </div>


      <div class="culture-fact">
        <span>Best timing</span>
        <strong>
          {season}
        </strong>
      </div>

    </div>

  </section>


  <!-- =====================================================
       STORY
       ===================================================== -->

  <main
    id="experience-story"
    class="culture-main"
  >

    <div class="culture-layout">


      <article class="culture-story">

        <p class="section-kicker">
          Living Afghanistan
        </p>


        <h2>
          The experience
        </h2>


        <p class="story-lead">
          {description}
        </p>


        <div class="culture-prose">
          <Content />
        </div>

      </article>


      <aside class="culture-sidebar">

        <div class="sidebar-card">

          <p class="section-kicker">
            Plan Around It
          </p>


          <h2>
            Make this part of your journey
          </h2>


          <p>
            Cultural experiences work best when they
            fit naturally into the route, season,
            local schedule, and people available
            during your visit.
          </p>


          <div class="sidebar-details">

            <div>
              <span>Duration</span>
              <strong>
                {duration}
              </strong>
            </div>


            <div>
              <span>Best season</span>
              <strong>
                {season}
              </strong>
            </div>


            {provinces.length > 0 && (
              <div>
                <span>Province</span>
                <strong>
                  {provinces.join(', ')}
                </strong>
              </div>
            )}

            {culturalHubs.length > 0 && (
              <div>
                <span>Travel hubs</span>
                <strong>
                  {culturalHubs.map((h, i) => (
                    <>
                      {i > 0 ? ', ' : ''}
                      <a href={h.href}>{h.title}</a>
                      <em style="font-style:normal;opacity:0.7;font-weight:500"> ({accessTypeLabel(h.access_type)})</em>
                    </>
                  ))}
                </strong>
              </div>
            )}


          </div>


          <a
            class="sidebar-primary"
            href={contactHref}
          >
            Build a trip around this
          </a>


          <a
            class="sidebar-secondary"
            href="/cultural-experiences/"
          >
            Browse all experiences
          </a>

        </div>

      </aside>

    </div>

  </main>


  <!-- =====================================================
       GALLERY / LIGHTBOX
       ===================================================== -->

  {galleryImages.length > 1 && (

    <section class="culture-gallery-section">

      <div class="culture-gallery-wrap">

        <div class="section-heading">

          <p class="section-kicker">
            Visual Story
          </p>

          <h2>
            See the experience
          </h2>

          <p>
            Click any image for a larger view.
          </p>

        </div>


        <div
          class:list={[
            'culture-gallery',
            galleryImages.length === 2 &&
              'culture-gallery-two',
          ]}
        >

          {galleryImages.map(
            (src, index) => (

              <button
                type="button"
                class:list={[
                  'culture-gallery-item',
                  index === 0 &&
                    galleryImages.length >= 3 &&
                    'culture-gallery-featured',
                ]}
                data-cultural-gallery-image={src}
                data-cultural-gallery-alt={`${title} — view ${index + 1}`}
                aria-label={`Open image ${index + 1} of ${title}`}
              >

                <img
                  src={src}
                  alt={`${title} — view ${index + 1}`}
                  loading={
                    index < 2
                      ? 'eager'
                      : 'lazy'
                  }
                />

              </button>

            )
          )}

        </div>

      </div>

    </section>

  )}


  <!-- =====================================================
       CULTURAL PAIRINGS
       ===================================================== -->

  {
    (
      pairedFoods.length > 0 ||
      nearby.length > 0
    ) && (

      <section class="pairings-section">

        <div class="pairings-wrap">

          <div class="section-heading dark-heading">

            <p class="section-kicker">
              Build Context
            </p>

            <h2>
              Pair the experience
            </h2>

            <p>
              The strongest cultural moments rarely
              happen in isolation. Combine them with
              food, neighborhoods, landscapes, and
              nearby stops.
            </p>

          </div>


          <div class="pairing-columns">

            {pairedFoods.length > 0 && (

              <div class="pairing-card">

                <span class="pairing-number">
                  01
                </span>

                <h3>
                  Food & hospitality
                </h3>

                <div class="pairing-pills">

                  {pairedFoods.map(
                    (food) => (
                      <span>
                        {food}
                      </span>
                    )
                  )}

                </div>

              </div>

            )}


            {nearby.length > 0 && (

              <div class="pairing-card">

                <span class="pairing-number">
                  02
                </span>

                <h3>
                  Nearby & complementary
                </h3>

                <div class="pairing-pills">

                  {nearby.map(
                    (place) => (
                      <span>
                        {place}
                      </span>
                    )
                  )}

                </div>

              </div>

            )}

          </div>

        </div>

      </section>

    )
  }


  <!-- =====================================================
       RELATED TOURS
       ===================================================== -->

  {
    relatedTours.length > 0 && (

      <TourCardGrid
        tours={relatedTours}
        title={`Journeys connected to ${title}`}
        intro={`These tours are directly linked to this experience or travel through areas where it can fit naturally into the journey.`}
      />

    )
  }


  <!-- =====================================================
       OTHER CULTURAL EXPERIENCES
       ===================================================== -->

  {
    relatedExperiences.length > 0 && (

      <section class="more-experiences">

        <div class="more-experiences-wrap">

          <div class="section-heading">

            <p class="section-kicker">
              Continue Exploring
            </p>

            <h2>
              More cultural experiences
            </h2>

            <p>
              Move between craft, sport, hospitality,
              celebration, and everyday Afghan life
              without returning to the main menu.
            </p>

          </div>


          <div class="experience-grid">

            {
              relatedExperiences.map(
                (experience) => {

                  const experienceSlug =
                    experience.id.replace(
                      /\.md$/,
                      ''
                    );


                  const image =
                    experience.data.hero_image ||
                    experience.data.image ||
                    '/assets/images/placeholders/default-attraction.webp';


                  return (

                    <a
                      class="experience-card"
                      href={`/cultural-experiences/${experienceSlug}/`}
                    >

                      <div class="experience-card-image">

                        <img
                          src={image}
                          alt={experience.data.title}
                          loading="lazy"
                        />

                      </div>


                      <div class="experience-card-copy">

                        <p>
                          {
                            experience.data.experience_type ||
                            'Cultural Experience'
                          }
                        </p>

                        <h3>
                          {experience.data.title}
                        </h3>


                        {
                          experience.data.card_description && (

                            <span>
                              {experience.data.card_description}
                            </span>

                          )
                        }


                        <strong>
                          Explore experience →
                        </strong>

                      </div>

                    </a>

                  );

                }
              )
            }

          </div>

        </div>

      </section>

    )
  }


  <!-- =====================================================
       CTA
       ===================================================== -->

  <section class="culture-final-cta">

    <div class="culture-final-inner">

      <div>

        <p class="section-kicker">
          Custom Journey
        </p>

        <h2>
          Travel through culture, not around it.
        </h2>

        <p>
          Tell us which traditions, foods, crafts,
          landscapes, and historical places interest
          you. We will build them into a practical
          route rather than treating them as
          disconnected stops.
        </p>

      </div>


      <a href={contactHref}>
        Start planning
      </a>

    </div>

  </section>


  <!-- =====================================================
       IMAGE LIGHTBOX
       ===================================================== -->

  <dialog
    id="cultural-gallery-dialog"
    class="culture-dialog"
  >

    <button
      class="culture-dialog-close"
      type="button"
      aria-label="Close image"
    >
      ×
    </button>

    <img
      id="cultural-gallery-dialog-image"
      src={heroImage}
      alt=""
    />

  </dialog>


<script is:inline>
  /* CULTURAL-GALLERY-DEDUPE-START */
  (() => {
    const normalizeGallerySrc = (img) => {
      const raw =
        img.currentSrc ||
        img.getAttribute('src') ||
        '';

      if (!raw) return '';

      try {
        const url = new URL(raw, window.location.origin);
        return url.pathname
          .replace(/\/+/g, '/')
          .toLowerCase();
      } catch {
        return raw
          .split('?')[0]
          .split('#')[0]
          .replace(/\/+/g, '/')
          .toLowerCase();
      }
    };

    const removeRepeatedGalleryImages = () => {
      const selectors = [
        '[data-gallery]',
        '.experience-gallery',
        '.gallery-grid',
        '.gallery',
        '.hero-gallery',
        '.media-gallery',
        '[class*="gallery"]'
      ];

      document
        .querySelectorAll(selectors.join(','))
        .forEach((gallery) => {
          if (
            gallery.closest('.related-tour-grid') ||
            gallery.closest('.featured-modal')
          ) {
            return;
          }

          const seen = new Set();

          gallery.querySelectorAll('img').forEach((img) => {
            const src = normalizeGallerySrc(img);

            if (!src) return;

            if (!seen.has(src)) {
              seen.add(src);
              return;
            }

            const item =
              img.closest(
                '[data-gallery-item], figure, li, button, a, .gallery-item, .gallery-tile'
              ) || img;

            item.remove();
          });
        });
    };

    if (document.readyState === 'loading') {
      document.addEventListener(
        'DOMContentLoaded',
        removeRepeatedGalleryImages,
        { once: true }
      );
    } else {
      removeRepeatedGalleryImages();
    }
  })();
  /* CULTURAL-GALLERY-DEDUPE-END */
</script>

</BaseLayout>


<script is:inline>
  (() => {
    const dialog =
      document.getElementById(
        'cultural-gallery-dialog'
      );

    const dialogImage =
      document.getElementById(
        'cultural-gallery-dialog-image'
      );

    if (!dialog || !dialogImage) {
      return;
    }


    document
      .querySelectorAll(
        '[data-cultural-gallery-image]'
      )
      .forEach((button) => {

        button.addEventListener(
          'click',
          () => {

            dialogImage.src =
              button.dataset
                .culturalGalleryImage;

            dialogImage.alt =
              button.dataset
                .culturalGalleryAlt ||
              '';

            dialog.showModal();

          }
        );

      });


    dialog
      .querySelector(
        '.culture-dialog-close'
      )
      ?.addEventListener(
        'click',
        () => dialog.close()
      );


    dialog.addEventListener(
      'click',
      (event) => {

        if (
          event.target === dialog
        ) {
          dialog.close();
        }

      }
    );

  })();
</script>


<style>

  .culture-hero {
    position: relative;

    min-height:
      clamp(560px, 70vh, 780px);

    overflow: hidden;

    background: #101820;
    color: #fff;
  }


  .culture-hero-image {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }


  .culture-hero-overlay {
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        90deg,
        rgba(6,11,16,.91) 0%,
        rgba(6,11,16,.70) 43%,
        rgba(6,11,16,.18) 76%
      ),
      linear-gradient(
        0deg,
        rgba(6,11,16,.82) 0%,
        transparent 62%
      );
  }


  .culture-hero-inner {
    position: relative;
    z-index: 2;

    width:
      min(1280px, calc(100% - 2rem));

    min-height:
      clamp(560px, 70vh, 780px);

    margin: auto;

    padding:
      clamp(2rem, 5vw, 4rem)
      0
      clamp(4rem, 8vw, 6rem);

    display: flex;
    flex-direction: column;
  }


  .breadcrumbs {
    display: flex;
    align-items: center;
    flex-wrap: wrap;

    gap: .55rem;

    font-size: .78rem;
    font-weight: 800;
  }


  .breadcrumbs a {
    color: rgba(255,255,255,.82);
    text-decoration: none;
  }


  .breadcrumbs span {
    color: rgba(255,255,255,.4);
  }


  .culture-hero-copy {
    margin-top: auto;
    max-width: 930px;
  }


  .kicker,
  .section-kicker {
    margin: 0;

    color: #d6a33e;

    font-size: .72rem;
    line-height: 1.3;

    font-weight: 900;

    letter-spacing: .2em;
    text-transform: uppercase;
  }


  .culture-hero .kicker {
    color: #f1c56b;
  }


  .culture-hero h1 {
    margin:
      .65rem 0
      1rem;

    max-width: 980px;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size:
      clamp(3rem, 7vw, 6.8rem);

    line-height: .91;

    letter-spacing: -.06em;

    text-wrap: balance;

    text-shadow:
      0 8px 35px
      rgba(0,0,0,.36);
  }


  .hero-subtitle {
    max-width: 720px;

    margin: 0;

    color:
      rgba(255,255,255,.88);

    font-size:
      clamp(1.05rem, 1.7vw, 1.3rem);

    line-height: 1.6;
  }


  .hero-actions {
    display: flex;
    flex-wrap: wrap;

    gap: .8rem;

    margin-top: 1.8rem;
  }


  .hero-actions a {
