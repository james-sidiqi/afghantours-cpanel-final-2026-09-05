---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getReturnJourneys } from '../../lib/buildRelations';

const journeys = getReturnJourneys();
---
<BaseLayout
  title="Return Journeys | AfghanTours"
  description="Diaspora heritage returns and veterans, contractors, and diplomats return visits — inquiry-led, distinct from leisure tours and specialist services."
  image="/assets/images/custom-tours/veteran-return/hero.webp"
>
  <section class="rj-hero">
    <div class="rj-wrap">
      <p class="kicker">Return Journeys</p>
      <h1>Coming back with context — not a brochure template.</h1>
      <p class="lead">
        Return journeys are distinct from packaged leisure tours and from specialist research or media work.
        We plan around personal history, privacy, family pace, and current access — without fixed Day&nbsp;1–N
        itineraries, catalog durations, or published “from” prices.
      </p>
      <div class="row">
        <a class="btn-primary" href="/contact/?type=return">Request a Return Journey</a>
        <a class="btn-ghost" href="/specialist-services/">Specialist Services</a>
        <a class="btn-ghost" href="/tours/">Tour Packages</a>
      </div>
    </div>
  </section>

  <section class="rj-grid-section">
    <div class="rj-wrap wide">
      <div class="rj-grid">
        {journeys.map((j) => (
          <a class="rj-card" href={`/return-journeys/${j.slug}/`}>
            <div class="rj-card__img"><img src={j.hero_image_path || j.image_path} alt="" loading="lazy" /></div>
            <div class="rj-card__body">
              <p class="rj-card__label">Return journey · inquiry-led</p>
              <h2>{j.name}</h2>
              <p>{j.summary}</p>
              <span>{j.cta_label || 'Request a Return Journey'} →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .rj-wrap { width: min(860px, calc(100% - 2rem)); margin: 0 auto; }
  .rj-wrap.wide { width: min(1180px, calc(100% - 2rem)); }
  .rj-hero { background: #1a2330; color: #fff; padding: clamp(3.5rem, 6vw, 5.5rem) 0; }
  .kicker { margin: 0; color: #d6a548; font-size: .72rem; letter-spacing: .22em; text-transform: uppercase; font-weight: 900; }
  .rj-hero h1 { font-family: Georgia, "Times New Roman", serif; font-size: clamp(2.3rem, 5vw, 3.6rem); line-height: 1.05; margin: .6rem 0 1rem; max-width: 16ch; }
  .lead { color: rgba(255,255,255,.84); line-height: 1.7; max-width: 60ch; }
  .row { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.5rem; }
  .btn-primary, .btn-ghost { text-decoration: none; padding: .9rem 1.2rem; border-radius: .35rem; font-size: .78rem; font-weight: 900; text-transform: uppercase; }
  .btn-primary { background: #b98237; color: #fff; }
  .btn-ghost { border: 1px solid rgba(255,255,255,.45); color: #fff; }
  .rj-grid-section { padding: 3.5rem 0 5rem; background: #f7f4ee; }
  .rj-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.25rem; }
  .rj-card { background: #fff; border: 1px solid #e5dccf; border-radius: .75rem; overflow: hidden; text-decoration: none; color: inherit; display: flex; flex-direction: column; box-shadow: 0 10px 28px rgba(40,28,12,.06); }
  .rj-card__img img { width: 100%; height: 210px; object-fit: cover; display: block; }
  .rj-card__body { padding: 1.2rem; display: grid; gap: .55rem; }
  .rj-card__label { margin: 0; color: #b46b00; font-size: .68rem; letter-spacing: .16em; text-transform: uppercase; font-weight: 900; }
  .rj-card h2 { margin: 0; font-family: Georgia, "Times New Roman", serif; font-size: 1.5rem; }
  .rj-card p { margin: 0; color: #4b5563; line-height: 1.6; }
  .rj-card span { color: #b98237; font-weight: 800; }
</style>
